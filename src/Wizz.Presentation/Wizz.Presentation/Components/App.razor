<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.rtl.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["css/site.css"]" />
    <link rel="stylesheet" href="@Assets["Wizz.Presentation.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <script>
        // تطبيق التفضيلات المحفوظة (المظهر، حجم الخط، الكثافة، التباين، الحركة،
        // أهداف اللمس) قبل تحميل واجهة Blazor لمنع وميض الشاشة عند فتح الصفحة.
        (function () {
            try {
                var root = document.documentElement;
                var theme = localStorage.getItem('wizz.theme');
                if (!theme) {
                    theme = (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches)
                        ? 'system'
                        : 'light';
                }
                root.setAttribute('data-theme', theme);

                var font = localStorage.getItem('wizz.fontsize');
                if (font) root.setAttribute('data-fontsize', font);

                var density = localStorage.getItem('wizz.density');
                if (density) root.setAttribute('data-density', density);

                var contrast = localStorage.getItem('wizz.contrast');
                if (contrast) root.setAttribute('data-contrast', contrast);

                var motion = localStorage.getItem('wizz.motion');
                if (motion) root.setAttribute('data-motion', motion);

                var targets = localStorage.getItem('wizz.targets');
                if (targets) root.setAttribute('data-targets', targets);
            } catch (e) {
                // تجاهل الأخطاء
            }
        })();
    </script>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["js/artifact-export.js"]"></script>
    <script src="@Assets["js/ai-history.js"]"></script>
    <script src="@Assets["js/ai-memory.js"]"></script>
    <script src="@Assets["js/ai-route-priority.js"]"></script>
<script src="@Assets["js/quick-actions.js"]"></script>
<script src="@Assets["js/quick-settings.js"]"></script>
<script src="@Assets["js/anchors.js"]"></script>
<script src="@Assets["js/keyboard.js"]"></script>
</body>

</html>
