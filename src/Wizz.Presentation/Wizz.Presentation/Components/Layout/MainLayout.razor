@using System.Security.Claims
@inherits LayoutComponentBase

<div class="page">
    <input type="checkbox" id="wizz-nav-toggle" class="wizz-nav-toggle" title="القائمة" aria-label="فتح القائمة" />
    <label for="wizz-nav-toggle" class="wizz-nav-toggle-button" title="القائمة" aria-label="القائمة">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <line x1="4" y1="7" x2="20" y2="7" />
            <line x1="4" y1="12" x2="20" y2="12" />
            <line x1="4" y1="17" x2="20" y2="17" />
        </svg>
    </label>
    <label for="wizz-nav-toggle" class="wizz-nav-backdrop" aria-hidden="true"></label>

    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <span class="app-status" title="وضع محلي">
                <span class="status-dot"></span>
                <span class="app-status-text">وضع محلي</span>
            </span>
            <AuthorizeView>
                <Authorized Context="auth">
                    <div class="d-flex align-items-center gap-3">
                        <button type="button"
                                id="wizz-qs-trigger"
                                class="wizz-qs-trigger"
                                title="الإعدادات السريعة (F1)"
                                aria-label="الإعدادات السريعة — SETTINGS (F1)"
                                aria-haspopup="dialog"
                                aria-controls="wizz-quick-settings"
                                aria-expanded="false"
                                data-wizz-qs-open>
                            <WizzIcon Icon="help" Size="18" />
                            <span class="wizz-qs-trigger-badge" aria-hidden="true">
                                <WizzIcon Icon="settings" Size="10" />
                            </span>
                        </button>
                        <span class="app-user" title="@(auth.User.FindFirst(ClaimTypes.GivenName)?.Value ?? auth.User.Identity?.Name) — @(RoleText(auth.User.FindFirst(ClaimTypes.Role)?.Value))">
                            <WizzIcon Icon="user" Size="16" />
                            <span class="app-user-name">@(auth.User.FindFirst(ClaimTypes.GivenName)?.Value ?? auth.User.Identity?.Name)</span>
                            <small class="text-muted app-user-role">(@RoleText(auth.User.FindFirst(ClaimTypes.Role)?.Value))</small>
                        </span>
                        <form method="post" action="/auth/logout" class="m-0">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">خروج</button>
                        </form>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <span class="app-user">زائر</span>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<QuickSettingsPanel />

<div id="blazor-error-ui" data-nosnippet>
    حدث خطأ غير متوقع.
    <a href="." class="reload">إعادة التحميل</a>
    <span class="dismiss">×</span>
</div>

@code {
    private static string RoleText(string? role) => role switch
    {
        nameof(UserRole.Admin) => "مدير نظام",
        nameof(UserRole.Manager) => "مدير",
        nameof(UserRole.Cashier) => "كاشير",
        _ => "مستخدم",
    };
}
