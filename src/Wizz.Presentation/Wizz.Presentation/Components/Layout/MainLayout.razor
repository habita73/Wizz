@using System.Security.Claims
@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <span class="app-status">
                <span class="status-dot"></span>
                وضع محلي
            </span>
            <AuthorizeView>
                <Authorized Context="auth">
                    <div class="d-flex align-items-center gap-3">
                        <button type="button"
                                id="wizz-qs-trigger"
                                class="wizz-qs-trigger"
                                title="الإعدادات السريعة (F1)"
                                aria-label="الإعدادات السريعة — SETTINGS (F1)"
                                aria-haspopup="dialog"
                                aria-controls="wizz-quick-settings"
                                aria-expanded="false"
                                data-wizz-qs-open>
                            <WizzIcon Icon="help" Size="18" />
                            <span class="wizz-qs-trigger-badge" aria-hidden="true">
                                <WizzIcon Icon="settings" Size="10" />
                            </span>
                        </button>
                        <span class="app-user">
                            <WizzIcon Icon="user" Size="16" />
                            <span>@(auth.User.FindFirst(ClaimTypes.GivenName)?.Value ?? auth.User.Identity?.Name)</span>
                            <small class="text-muted">(@RoleText(auth.User.FindFirst(ClaimTypes.Role)?.Value))</small>
                        </span>
                        <form method="post" action="/auth/logout" class="m-0">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">خروج</button>
                        </form>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <span class="app-user">زائر</span>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<QuickSettingsPanel />

<div id="blazor-error-ui" data-nosnippet>
    حدث خطأ غير متوقع.
    <a href="." class="reload">إعادة التحميل</a>
    <span class="dismiss">×</span>
</div>

@code {
    private static string RoleText(string? role) => role switch
    {
        nameof(UserRole.Admin) => "مدير نظام",
        nameof(UserRole.Manager) => "مدير",
        nameof(UserRole.Cashier) => "كاشير",
        _ => "مستخدم",
    };
}
