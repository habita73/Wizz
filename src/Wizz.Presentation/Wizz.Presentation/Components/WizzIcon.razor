@* أيقونة SVG داخلية موحّدة — بلا أي مكتبة أيقونات خارجية.
   الاستخدام: <WizzIcon Icon="plus" /> *@
<svg class="wizz-icon @Class"
     width="@Size"
     height="@Size"
     viewBox="0 0 24 24"
     fill="none"
     stroke="currentColor"
     stroke-width="@StrokeWidth"
     stroke-linecap="round"
     stroke-linejoin="round"
     role="@(string.IsNullOrWhiteSpace(Title) ? "presentation" : "img")"
     aria-hidden="@(string.IsNullOrWhiteSpace(Title) ? "true" : "false")">
    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <title>@Title</title>
    }
    @((MarkupString)Path)
</svg>

@code {
    /// <summary>اسم الأيقونة من القاموس أدناه.</summary>
    [Parameter]
    public string Icon { get; set; } = "dot";

    /// <summary>الحجم بالبكسل (يُطبَّق عرضاً وارتفاعاً).</summary>
    [Parameter]
    public int Size { get; set; } = 16;

    /// <summary>سماكة الخط.</summary>
    [Parameter]
    public double StrokeWidth { get; set; } = 2;

    /// <summary>وصف يُقرأ لقارئ الشاشة. تركه فارغاً يجعل الأيقونة زخرفية.</summary>
    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? Class { get; set; }

