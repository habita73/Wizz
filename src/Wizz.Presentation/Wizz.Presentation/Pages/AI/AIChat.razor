    /// <summary>يحكّم النص المُدخل محلياً ويعرض المرشّحات؛ لا يرسل ولا يكتب ولا يغيّر التوجيه.</summary>
    private async Task RunCaptureAsync()
    {
        if (capturing || string.IsNullOrWhiteSpace(captureInput)) return;
        capturing = true;
        captureError = null;
        lastExtractedText = null;
        assistSuggestion = null;
        assistError = null;
        modelExtractError = null;
        modelExtractNote = null;
        lastReaderName = null;
        StateHasChanged();

        try
        {
            captureResult = await CaptureService.CaptureAsync(
                new DocumentCaptureRequest(captureInput.Trim()));
            lastExtractedText = captureInput.Trim();
            decisionReport = DecisionReportBuilder.Build(captureInput.Trim(), captureResult.Adjudication);
            MeasureAccuracy();
        }
        catch (Exception ex)
        {
            captureResult = null;
            decisionReport = null;
            captureError = $"تعذّر تحكيم النص: {ex.Message}";
        }
        finally
        {
            capturing = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// يطلب تصحيح النص من النموذج المحلي بعد ضغط المستخدم فقط. النتيجة اقتراح للعرض،
    /// ولا تُكتب ولا تُطبَّق ولا تمرّ عبر موجه النماذج.
    /// </summary>
    private async Task RunAssistAsync()
    {
        if (assisting || capturing || string.IsNullOrWhiteSpace(captureInput)) return;
        assisting = true;
        assistSuggestion = null;
        assistError = null;
        StateHasChanged();

        try
        {
            var result = await OcrAssist.SuggestAsync(captureInput.Trim());
            if (result.Available)
                assistSuggestion = result.Suggestion;
            else
                assistError = result.Reason;
        }
        catch (Exception)
        {
            // لا يُسجَّل أي جزء من نص الوصل في أي سجل.
            assistError = "تعذّت مساعدة النموذج المحلي؛ راجع النص يدويًا.";
        }
        finally
        {
            assisting = false;
            StateHasChanged();
        }
    }

    /// <summary>ينقل الاقتراح إلى مربع النص بعد ضغط المستخدم؛ لا يعيد التحكيم تلقائيًا.</summary>
    private void AcceptAssistSuggestion()
    {
        if (string.IsNullOrWhiteSpace(assistSuggestion)) return;
        captureInput = assistSuggestion;
        assistSuggestion = null;
        StateHasChanged();
    }

    /// <summary>يثبّت طريقة القراءة لهذه الجلسة فقط عند تغيير المستخدم لها.</summary>
    private void OnReadingRouteChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var value) &&
            Enum.IsDefined(typeof(ReadingRoute), value))
        {
            readingRoute = (ReadingRoute)value;
            StateHasChanged();
        }
    }

    /// <summary>ينفّذ طريقة القراءة التي اختارها المستخدم صراحةً؛ لا شيء يعمل تلقائيًا.</summary>
    private async Task RunReadingAsync()
    {
        if (readingRoute == ReadingRoute.WindowsOcr || readingRoute == ReadingRoute.EmbeddedOcr)
        {
            // القارئ المضمّن اختيار مقارنة صريح لهذه الجلسة فقط، ولا يغيّر الافتراضي المعتمد.
            selectedReader = readingRoute == ReadingRoute.EmbeddedOcr
                ? OcrReaderChoice.RapidOcr
                : OcrReaderChoice.Default;
            await RunImageCaptureAsync();
            return;
        }

        modelRoute = readingRoute == ReadingRoute.CloudModel
            ? DocumentModelRoute.Cloud
            : DocumentModelRoute.Local;
        await RunModelExtractionAsync();
    }

    /// <summary>
    /// يستخرج النص من الصورة عبر نموذج بعد ضغط المستخدم في كل مرة. لا يعمل تلقائيًا، ولا يمرّ عبر موجه
    /// النماذج، ولا يكتب في قاعدة البيانات. الناتج نص للمراجعة فقط؛ لا يُحكَّم ولا يُطبَّق تلقائيًا.
    /// </summary>
    private async Task RunModelExtractionAsync()
    {
        var bytes = CurrentImageBytes;
        if (extractingWithModel || capturing || bytes is null) return;

        if (modelRoute == DocumentModelRoute.Cloud)
        {
            var confirmed = await JS.InvokeAsync<bool>("confirm",
                "سيُرسل نموذج سحابي صورة الورقة كاملة لمحاولة استخراج النص. قد تحتوي الصورة على بيانات عملاء، وقد يستغرق الاستدعاء وقتًا. هل تتابع؟");
            if (!confirmed) return;
        }

        extractingWithModel = true;
        modelExtractError = null;
        modelExtractNote = null;
        StateHasChanged();

        try
        {
            var result = await ModelExtractor.ExtractAsync(bytes, modelRoute);
            captureInput = result.Text;
            lastExtractedText = result.Text;
            captureResult = null;
            decisionReport = null;
            captureError = null;
            lastReaderName = $"نموذج {result.Model}";
            modelExtractNote = (modelRoute == DocumentModelRoute.Cloud
                    ? "استُخدم مسار سحابي مجاني؛ "
                    : "استُخدم نموذج محلي بلا إرسال؛ ")
                + "النص للمراجعة فقط، ولم يُحكَّم ولم يُطبَّق تلقائيًا."
                + (result.Notes.Count > 0 ? " " + string.Join(" ", result.Notes) : "");
            MeasureAccuracy();
        }
        catch (Exception ex)
        {
            modelExtractError = $"تعذّر استخراج النص بالنموذج: {ex.Message}";
        }
        finally
        {
            extractingWithModel = false;
            StateHasChanged();
        }
    }

    /// <summary>وسم مختصر يوضح هل قرأ القارئ عبر المسار التلقائي أم باختيار مباشر.</summary>
    private static string SelectedReaderLabel(OcrReaderChoice choice) => choice switch
    {
        OcrReaderChoice.Windows => "اختيار مباشر",
        OcrReaderChoice.RapidOcr => "اختيار مباشر",
        _ => "المسار التلقائي"
    };

    /// <summary>يستقبل صورة مختارة محليًا، يحضّر معاينتها، ثم يبدأ التحليل حسب التخصيص.</summary>
    private async Task OnCaptureImageSelectedAsync(InputFileChangeEventArgs e)
    {
        captureImage = e.File;
        if (captureImage is null) return;

        captureError = null;
        captureResult = null;
        decisionReport = null;
        lastReaderName = null;
        assistSuggestion = null;
        assistError = null;
        modelExtractError = null;
        modelExtractNote = null;
        originalImageBytes = null;
        enhancedImageBytes = null;
        originalPreviewUrl = null;
        enhancedPreviewUrl = null;
        imagePreviewNote = null;

        try
        {
            await using var buffer = new MemoryStream();
            await using (var input = captureImage.OpenReadStream(OcrDocumentCaptureService.MaxImageBytes))
            {
                await input.CopyToAsync(buffer);
            }
            originalImageBytes = buffer.ToArray();

            var thumbnail = ImageEnhancer.CreateThumbnail(originalImageBytes, PreviewMaxDimension);
            originalPreviewUrl = thumbnail is null
                ? null
                : $"data:image/jpeg;base64,{Convert.ToBase64String(thumbnail)}";
            PrepareEnhancedImage();
        }
        catch (Exception ex)
        {
            originalImageBytes = null;
            captureError = $"تعذّت قراءة الصورة: {ex.Message}";
            return;
        }

        // لا قراءة تلقائية عند الرفع؛ المستخدم يختار الطريقة ويضغط «اقرأ الورقة» صراحةً.
    }

    /// <summary>يحضّر النسخة المحسّنة ومعاينتها عند تفعيل التحسين، دون قراءة أو كتابة.</summary>
    private void PrepareEnhancedImage()
    {
        enhancedImageBytes = null;
        enhancedPreviewUrl = null;
        imagePreviewNote = null;
        if (!enhanceEnabled || originalImageBytes is null) return;

        enhancedImageBytes = ImageEnhancer.Enhance(originalImageBytes, enhanceLevel);
        if (enhancedImageBytes is null)
        {
            imagePreviewNote = "تعذّ تحسين الصورة؛ ستُقرأ الأصلية.";
            return;
        }

        var thumbnail = ImageEnhancer.CreateThumbnail(enhancedImageBytes, PreviewMaxDimension);
        enhancedPreviewUrl = thumbnail is null
            ? null
            : $"data:image/jpeg;base64,{Convert.ToBase64String(thumbnail)}";
    }

    private void OnEnhanceChanged(ChangeEventArgs e)
    {
