    /// <summary>يسلّم النص والأصناف المقبولة إلى الشاشة الهدف؛ المطابقة والتطبيق بقرار المستخدم هناك.</summary>
    private void SendDraftToScreen(string target, string route)
    {
        if (string.IsNullOrWhiteSpace(lastExtractedText)) return;
        var acceptedLines = captureResult?.Adjudication.Candidates
            .Where(c => c.Accepted && !string.IsNullOrWhiteSpace(c.Candidate.ProductName))
            .Select(c => new OcrDraftLine(
                c.Candidate.ProductName!,
                c.Candidate.Price,
                OcrQuantityParser.Parse(c.Candidate.RawLine, c.Candidate.ProductName, c.Candidate.Price)))
            .ToArray();
        DraftHandoff.Set(lastExtractedText, target,
            acceptedLines is null ? null : OcrDraftLineMerger.Merge(acceptedLines));
        Nav.NavigateTo(route);
    }

    private void SendSaleDraft() => SendDraftToScreen(OcrDraftHandoff.SaleTarget, "/sales/new");

    private void SendPurchaseDraft() => SendDraftToScreen(OcrDraftHandoff.PurchaseTarget, "/purchases");

