@page "/ai"
@layout MainLayout
@attribute [Authorize(Policy = PermissionPolicy.AccessAI)]
@rendermode InteractiveServer
@using Wizz.Application.AI
@using Wizz.Application.AI.Artifacts
@using Wizz.Application.AI.History
@using Wizz.Application.AI.Perception
@using Wizz.Application.AI.Routing
@inject Wizz.Application.AI.QueryAiUseCase QueryAiUseCase
@inject DocumentCaptureService CaptureService
@inject IOcrTextReader OcrReader
@inject IOcrReaderSelection OcrReaderSelection
@inject OcrDocumentCaptureService OcrCaptureService
@inject OcrTextAssistService OcrAssist
@inject IModelDocumentExtractor ModelExtractor
@inject IImageEnhancer ImageEnhancer
@inject Wizz.Application.Abstractions.IImageCaptureSettingsStore ImageCaptureSettings
@inject Wizz.Application.Abstractions.IModuleGate ModuleGate
@inject Wizz.Application.UseCases.Store.GetStoreSettingsUseCase StoreSettings
@inject Wizz.Application.Abstractions.IModelRouter ModelRouter
@inject AiHistoryStore HistoryStore
@inject AiMemoryStore MemoryStore
@inject AiRoutePriorityStore PriorityStore
@inject RouteDecisionLog DecisionLog
@inject IJSRuntime JS
@inject Microsoft.AspNetCore.Components.NavigationManager Nav
@inject OcrDraftHandoff DraftHandoff
@inject IOcrAliasStore OcrAliases
@inject IOcrEvaluationService OcrEvaluator

<h2 class="d-flex align-items-center gap-2 mb-3"><WizzIcon Icon="brain" Size="24" /><span>مساعد Wizz الذكي</span></h2>

<div class="row">
    <div class="col-lg-8">
        @* بلا h-100: بطاقة المحادثة تحتفظ بارتفاع محتواها، فلا تظهر مساحة فارغة أسفل التلميح
           حين تكبر بطاقة «تحكيم نص مستند» بعد قراءة صورة (تمدد صف Bootstrap). *@
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h5 class="mb-0 d-inline-flex align-items-center gap-2"><WizzIcon Icon="message" Size="18" /><span>المحادثة</span></h5>
                <div class="d-flex gap-2 align-items-center">
                    <span class="badge bg-success" title="يعمل دون نموذج أو إنترنت"><WizzIcon Icon="zap" Size="12" /> المدمج جاهز</span>
                    <span class="badge @(routeStatus.RouteCount > 1 ? "bg-primary" : "bg-secondary")">
                        <WizzIcon Icon="route" Size="12" />
                        @(routeStatus.RouteCount > 1 ? $"{routeStatus.RouteCount} مسار" : "مسار واحد")
                    </span>
                </div>
            </div>
            <div class="card-body d-flex flex-column" style="min-height: 500px;">
                <div class="flex-grow-1 overflow-auto mb-3" id="chatMessages" style="max-height: 60vh;">
                    @if (messages.Count == 0)
                    {
                        <div class="text-center text-muted py-5">
                            <svg class="svg-icon" style="width: 4rem; height: 4rem; margin-bottom: 1rem;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 2L2 7l10 5 10-5-10-5Z"/>
                                <path d="M2 17l10 5 10-5"/>
                                <path d="M2 12l10 5 10-5"/>
                            </svg>
                            <p class="mt-3 mb-0">مرحباً! اسألني عن مبيعاتك أو ديونك أو منتجاتك.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var msg in messages.OrderBy(m => m.Sequence))
                        {
                            <ChatMessage @key="msg.Id" Message="msg"
                                         StoreName="@storeName"
                                         RouteHint="@BuildRouteHint()"
                                         OnEdit="EditMessage"
                                         OnCopy="CopyMessage"
                                         OnArtifactDelete="DeleteArtifact"
                                         OnArtifactExport="OpenExportModal">
                                <EditFooter>
                                    <ModelSelectorPopover RouteMode="@routeMode"
                                                          RouteModeChanged="OnRouteModeChanged"
                                                          AvailableModels="availableModels"
                                                          SelectedLocalModel="@selectedModel"
                                                          SelectedLocalModelChanged="OnSelectedLocalModelChanged"
                                                          LocalAvailable="routeStatus.LocalAvailable"
                                                          CloudAvailable="routeStatus.CloudAvailable"
                                                          LoadingModels="loadingModels"
                                                          OnRefreshModels="RefreshModels" />
                                </EditFooter>
                            </ChatMessage>
                        }
                    }

                    @if (sending)
                    {
                        <div class="mb-3" aria-live="polite">
                            <div class="d-inline-flex align-items-start gap-2 bg-light border rounded-3 px-3 py-2">
                                <span class="spinner-border spinner-border-sm text-primary mt-1" role="status"></span>
                                <span class="small">
                                    <strong>@PendingLabel</strong>
                                    <br />
                                    <span class="text-muted">@PendingHint</span>
                                </span>
                            </div>
                        </div>
                    }
                </div>

                <QuickQuestionsBar Questions="quickQuestions"
                                   Disabled="@sending"
                                   OnAsk="SendQuickQuestion" />

                <div class="ai-composer input-group">
                    <textarea class="form-control" rows="1" @bind="userInput" @bind:event="oninput"
                              placeholder="اكتب سؤالك هنا… (Enter إرسال · Shift+Enter سطر جديد · Esc مسح)"
                              @onkeydown="OnInputKeyDown" disabled="@sending"></textarea>

                    <!-- مجموعة أزرار موحدة: محدد الجهة + زر الإرسال -->
                    <div class="input-group-append btn-group" role="group" aria-label="إجراءات الإرسال">
                        <!-- محدد الجهة/النموذج -->
                        <ModelSelectorPopover RouteMode="@routeMode"
                                              RouteModeChanged="OnRouteModeChanged"
                                              AvailableModels="availableModels"
                                              SelectedLocalModel="@selectedModel"
                                              SelectedLocalModelChanged="OnSelectedLocalModelChanged"
                                              LocalAvailable="routeStatus.LocalAvailable"
                                              CloudAvailable="routeStatus.CloudAvailable"
                                              LoadingModels="loadingModels"
                                              OnRefreshModels="RefreshModels" />

                        <!-- زر الإرسال -->
                        <button type="button" class="btn btn-primary btn-send" @onclick="SendMessage" disabled="@(sending || string.IsNullOrWhiteSpace(userInput))">
                            إرسال
                        </button>
                    </div>
                </div>
                <div class="form-text small d-flex flex-wrap align-items-center gap-2 mt-1">
                    <span class="badge bg-light text-dark border" title="الجهة التي سترد على الأسئلة القادمة">الرد من: @CurrentRouteLabel</span>
                    @if (routeMode == "auto")
                    {
                        <span class="text-muted" title="ترتيب الأولوية المحفوظ">الأولوية: @PriorityOrderText</span>
                    }
                    <span class="text-muted" title="المبيعات والديون والأسعار للمدمج دائماً"><WizzIcon Icon="shield" Size="13" /></span>
                    <span class="text-muted" title="@ChatKeymap.Hint"><WizzIcon Icon="keyboard" Size="14" /></span>
                    @if (routeStatus.BuiltInAvailable && routeStatus.RouteCount == 1)
                    {
                        <span class="text-danger"><WizzIcon Icon="info" Size="13" /> المدمج فقط</span>
                    }
                </div>

                @if (lastDecision is not null)
                {
                    <div class="small text-muted mt-1"
                         title="@DecisionTooltip(lastDecision.Chosen, lastDecision.Reason, lastDecision.Candidates)">
                        التوجيه: <strong>@RouteText.Display(lastDecision.Chosen)</strong>
                        <span>— @lastDecision.Reason</span>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(lastTransparency))
                {
                    <div class="small text-muted mt-1" title="أنماط العمل وتحكيم المدمج للأرقام">
                        @if (!string.IsNullOrWhiteSpace(lastWorkMode))
                        {
                            <span class="badge bg-light text-dark border ms-1">نمط العمل: @lastWorkMode</span>
                        }
                        <span>@lastTransparency</span>
                    </div>
                }
            </div>
        </div>

        @if (documentReaderEnabled)
        {
        <div class="card mt-3">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h6 class="mb-0 d-inline-flex align-items-center gap-2"><WizzIcon Icon="image" Size="16" /><span>ماسح المستندات</span></h6>
                <span class="badge bg-warning text-dark" title="للمراجعة البشرية فقط">مراجعة فقط</span>
            </div>
            <div class="card-body">
                <div class="alert alert-light border small py-2 mb-3">
                    <WizzIcon Icon="eye" Size="13" /> للمراجعة فقط — عربي مطبوع — لا كتابة ولا إرسال.
                </div>
                <label class="small fw-bold mb-1" for="captureInput">ألصق النص أو ارفع صورة أدناه</label>
                <textarea id="captureInput" class="form-control" rows="3" @bind="captureInput"
                          placeholder="مثال: حليب 12.5&#10;خبز 5" disabled="@capturing"></textarea>
                <button type="button" class="btn btn-outline-primary btn-sm mt-2" @onclick="RunCaptureAsync"
                        disabled="@(capturing || string.IsNullOrWhiteSpace(captureInput))">
                    @if (capturing)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    }
                    تحكيم النص
                </button>

                <div class="mt-3 border-top pt-3">
                    <div class="small fw-bold mb-2 d-flex align-items-center gap-2">
                        <WizzIcon Icon="file" Size="14" /> قراءة الورقة
                    </div>
                    <InputFile OnChange="OnCaptureImageSelectedAsync" accept="image/png,image/jpeg,image/webp"
                               class="form-control form-control-sm" disabled="@capturing" />
                    <div class="d-flex flex-wrap align-items-center gap-2 mt-2 mb-2">
                        <label class="small mb-0" for="readingRoute">الطريقة:</label>
                        <select id="readingRoute" class="form-select form-select-sm w-auto"
                                value="@((int)readingRoute)" @onchange="OnReadingRouteChanged"
                                disabled="@(capturing || extractingWithModel)">
                            <option value="@((int)ReadingRoute.WindowsOcr)">قارئ Windows (المحلي الافتراضي)</option>
                            <option value="@((int)ReadingRoute.EmbeddedOcr)">القارئ المضمّن (PP-OCR عربي) — للمقارنة</option>
                            <option value="@((int)ReadingRoute.LocalModel)">نموذج محلي (Ollama — بلا إرسال)</option>
                            <option value="@((int)ReadingRoute.CloudModel)">سحابي مجاني (بعد تأكيدك)</option>
                        </select>
                        <button type="button" class="btn btn-outline-primary btn-sm"
                                @onclick="RunReadingAsync"
                                disabled="@(capturing || extractingWithModel || CurrentImageBytes is null)">
                            @if (capturing || extractingWithModel)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            }
                            اقرأ الورقة
                        </button>
                    </div>
                    <div class="small text-muted mb-2">
                        القارئ المضمّن للمقارنة اليدوية فقط، بلا إرسال. المسار المحلي لا يُخرج الصورة من الجهاز
                        (يحتاج نموذج رؤية مثبّتًا عبر <code>ollama pull llava</code>)؛ والمسار السحابي يرسل الصورة
                        بعد تأكيدك، ويسمح بالنماذج المجانية فقط. لا يعمل أي مسار تلقائيًا.
                    </div>

                    @if (originalPreviewUrl is not null)
                    {
                        <div class="mt-2">
                            <div class="small fw-bold mb-1">معاينة الصورة</div>
                            <div class="d-flex flex-wrap gap-2">
                                <figure class="mb-0 text-center">
                                    <img src="@originalPreviewUrl" alt="الصورة الأصلية" class="img-thumbnail" style="max-height: 200px;" />
                                    <figcaption class="small text-muted">الأصلية</figcaption>
                                </figure>
                                @if (enhanceEnabled && showEnhancedPreview && enhancedPreviewUrl is not null)
                                {
                                    <figure class="mb-0 text-center">
                                        <img src="@enhancedPreviewUrl" alt="الصورة المحسّنة" class="img-thumbnail" style="max-height: 200px;" />
                                        <figcaption class="small text-muted">المحسّنة</figcaption>
                                    </figure>
                                }
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(imagePreviewNote))
                    {
                        <div class="small text-warning mt-1">@imagePreviewNote</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(modelExtractError))
                    {
                        <div class="alert alert-warning py-2 mt-2 mb-0 small">@modelExtractError</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(modelExtractNote))
                    {
                        <div class="small text-muted mt-1">@modelExtractNote</div>
                    }
                </div>

                <details class="mt-3 border-top pt-3">
                    <summary class="small text-muted" style="cursor: pointer;">خيارات متقدمة (اختياري)</summary>
                <div class="mt-3 border-top pt-3">
                    <div class="small fw-bold mb-1">إعدادات الصورة ومعاينتها</div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" id="enhanceImage"
                                   checked="@enhanceEnabled" @onchange="OnEnhanceChanged" disabled="@capturing" />
                            <label class="form-check-label small" for="enhanceImage">تحسين الصورة محليًا قبل القراءة (اختياري)</label>
                        </div>
                        <button type="button" class="btn btn-link btn-sm p-0"
                                @onclick="() => showEnhanceSettingsModal = true" disabled="@capturing">
                            إعدادات التحسين (@ImageEnhanceLevels.Label(enhanceLevel))
                        </button>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="previewBeforeAnalysis"
                               checked="@previewBeforeAnalysis" @onchange="OnPreviewChanged" disabled="@capturing" />
                        <label class="form-check-label small" for="previewBeforeAnalysis">معاينة الصورة قبل التحليل</label>
                    </div>
                    @if (enhanceEnabled)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="showEnhancedPreview"
                                   checked="@showEnhancedPreview" @onchange="OnEnhancedPreviewChanged" disabled="@capturing" />
                            <label class="form-check-label small" for="showEnhancedPreview">عرض الصورة المحسّنة للمقارنة</label>
                        </div>
                    }
                    <div class="small text-muted mt-1">
                        التحسين يعمل داخل الجهاز بـOpenCV بلا نماذج ولا اتصال، وله ثلاث شِدّات تضبطها من «إعدادات التحسين».
                        لا يغيّر القارئ الافتراضي، ولا تقرأ الصورة تلقائيًا عند الرفع؛ اضغط «اقرأ الورقة» عند اختيارك.
                        تُحفظ هذه الخيارات تلقائيًا في ملف محلي.
                    </div>

                    @if (showEnhanceSettingsModal)
                    {
                        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">إعدادات تحسين الصورة</h5>
                                        <button type="button" class="btn-close" @onclick="() => showEnhanceSettingsModal = false"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="small text-muted mb-2">
                                            كل المستويات تستخدم المعالجة نفسها داخل الجهاز، بلا نماذج ولا اتصال.
                                            اختر الشدة التي تناسب صورك؛ لا يوجد تبديل تلقائي للقارئ.
                                        </div>
                                        @foreach (var level in EnhanceLevels)
                                        {
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" name="enhanceLevel"
                                                       id="@("enhance-level-" + (int)level)"
                                                       checked="@(enhanceLevel == level)"
                                                       @onchange="() => OnEnhanceLevelChanged(level)" />
                                                <label class="form-check-label small" for="@("enhance-level-" + (int)level)">
                                                    @ImageEnhanceLevels.Label(level)
                                                </label>
                                            </div>
                                        }
                                        <div class="small text-muted mt-2">
                                            «قوي» هو الإعداد الذي كان مستخدمًا قبل إضافة المستويات. يُحفظ اختيارك تلقائيًا،
                                            وتُحدَّث المعاينة فورًا إن كانت الصورة محمّلة.
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-primary btn-sm"
                                                @onclick="() => showEnhanceSettingsModal = false">تم</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="mt-3 border-top pt-3">
                    <div class="small fw-bold mb-1">تصحيح النص المستخرج محليًا (اختياري)</div>
                    <div class="small text-muted mb-2">
                        يختلف عن قراءة الصورة: يعمل على النص الموجود في المربع أعلاه فقط، ويستخدم نموذج Ollama
                        المحلي لتصحيح الحروف والأرقام، دون قراءة الصورة. لا تُنزَّل نماذج، ولا يُرسل شيء للخارج،
                        ولا يُغيَّر النص الأصلي؛ يظهر اقتراح تقرّر أنت وحدك اعتماده.
                    </div>
                    <button type="button" class="btn btn-outline-secondary btn-sm"
                            @onclick="RunAssistAsync"
                            disabled="@(assisting || capturing || string.IsNullOrWhiteSpace(captureInput))">
                        @if (assisting)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        }
                        اطلب تصحيح النص محليًا
                    </button>
                    @if (!string.IsNullOrWhiteSpace(assistError))
                    {
                        <div class="alert alert-warning py-2 mt-2 mb-0 small">@assistError</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(assistSuggestion))
                    {
                        <div class="mt-2">
                            <label class="small fw-bold mb-1">الاقتراح (للمراجعة فقط)</label>
                            <textarea class="form-control" rows="3" readonly dir="rtl">@assistSuggestion</textarea>
                            <button type="button" class="btn btn-outline-success btn-sm mt-2"
                                    @onclick="AcceptAssistSuggestion">
                                نسخ الاقتراح إلى مربع النص
                            </button>
                        </div>
                    }
                    </div>


                    <div class="small text-muted mt-3 d-flex align-items-center gap-2">
                        <span>الأسماء المتعلَّمة محليًا: @learnedAliases.Count</span>
                        @if (learnedAliases.Count > 0)
                        {
                            <button type="button" class="btn btn-link btn-sm p-0" @onclick="ClearAliases">مسح</button>
                        }
                    </div>
                </details>

                @if (!string.IsNullOrWhiteSpace(captureError))
                {
                    <div class="alert alert-danger py-2 mt-2 mb-0 small">@captureError</div>
                }

                @if (!string.IsNullOrWhiteSpace(lastExtractedText))
                {
                    <div class="mt-3 border-top pt-3">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-1">
                            <div class="small fw-bold">النص المستخرج كما قُرئ (راجعه بالصورة)</div>
                            <button type="button" class="btn btn-outline-primary btn-sm"
                                    @onclick="CopyExtractedTextAsync">نسخ النص المستخرج</button>
                        </div>
                        <textarea class="form-control" rows="4" readonly dir="rtl">@lastExtractedText</textarea>
                        <div class="small text-muted mt-1">هذا ما أخرجه القارئ حرفيًا؛ لم تُصحَّح الكلمات أو الأرقام، ولا يُكتب شيء تلقائيًا.</div>
                        @if (evalResult is not null)
                        {
                            <div class="small text-muted mt-1" title="قياس محلي على عينات اصطناعية، يُحدَّث تلقائيًا بعد كل عملية قراءة">
                                <WizzIcon Icon="chart" Size="13" /> دقة الاستخراج: الاسم @evalResult.NameHits/@evalResult.Total · السعر @evalResult.PriceHits
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(evalError))
                        {
                            <div class="small text-warning mt-1"><WizzIcon Icon="info" Size="13" /> @evalError</div>
                        }
                        <div class="small fw-bold mt-3">ماذا تريد أن تفعل بهذا النص؟</div>
                        <div class="d-flex flex-wrap gap-2 mt-1">
                            <button type="button" class="btn btn-outline-success btn-sm"
                                    @onclick="SendSaleDraft">فتح شاشة البيع بمسودة</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm"
                                    @onclick="SendPurchaseDraft">فتح شاشة الشراء بمسودة</button>
                        </div>
                        <div class="small text-muted mt-1">المطابقة والتطبيق في الشاشة الهدف بقرارك؛ لا يُحفظ شيء قبل تأكيدك.</div>
                    </div>
                }

                @if (captureResult is not null)
                {
                    <div class="mt-3">
                        @if (!string.IsNullOrWhiteSpace(lastReaderName))
                        {
                            <div class="small mb-1">
                                القارئ الذي اشتغل: <strong>@lastReaderName</strong>
                                <span class="badge bg-light text-dark border ms-1">@SelectedReaderLabel(selectedReader)</span>
                            </div>
                        }
                        <div class="small fw-bold mb-1">@captureResult.Adjudication.Summary</div>
                        @if (captureResult.Adjudication.Candidates.Count == 0)
                        {
                            <div class="small text-muted">لم يُستخرج أي مرشّح من النص.</div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-striped mb-2">
                                    <thead>
                                        <tr><th>المنتج</th><th>السعر</th><th>حكم المدمج</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in captureResult.Adjudication.Candidates)
                                        {
                                            <tr>
                                                <td>@(item.Candidate.ProductName ?? "—")</td>
                                                <td>@(item.Candidate.Price?.ToString("0.##") ?? "—")</td>
                                                <td>
                                                    <span class="badge @(item.Accepted ? "bg-success" : "bg-secondary")">@(item.Accepted ? "مقبول" : "مرفوض")</span>
                                                    <span class="small text-muted ms-1">@item.Reason</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        @if (captureResult.Adjudication.PossibleReadings.Count > 0)
                        {
                            <details class="small mt-2">
                                <summary class="text-muted">
                                    قراءات محتملة للمراجعة (@captureResult.Adjudication.PossibleReadings.Count)
                                    — لم يحكم عليها المدمج
                                </summary>
                                <ul class="small mb-1 ps-3 mt-1">
                                    @foreach (var alt in captureResult.Adjudication.PossibleReadings)
                                    {
                                        <li>
                                            @(alt.ProductName ?? "—") — @(alt.Price?.ToString("0.##") ?? "—")
                                            <span class="text-muted">(من السطر: @alt.RawLine)</span>
                                        </li>
                                    }
                                </ul>
                                <div class="text-muted mb-1">
                                    صيغ بديلة للسطر نفسه، لم تُحكَّم ولا تُعدّ أصنافًا؛ راجعها يدويًا قبل أي اعتماد.
                                </div>
                            </details>
                        }
                        <div class="small text-danger">@captureResult.Warning</div>
                    </div>
                }

                @if (decisionReport is not null)
                {
                    <details class="mt-3 border-top pt-3">
                        <summary class="small text-muted" style="cursor: pointer;">تفاصيل التقرير (اختياري)</summary>
                        <div class="mt-3">
                        <div class="small fw-bold mb-2">
                            تقرير القرار
                            <span class="badge bg-light text-dark border" title="ما جاء فيه منقول من حكم المدمج، ولا يزيد عليه دقة">@DecisionReportBuilder.EstimatedLabel</span>
                        </div>

                        @{
                            var partsInOrder = new[]
                            {
                                EstimatedDocumentPart.Header,
                                EstimatedDocumentPart.Content,
                                EstimatedDocumentPart.Footer,
                                EstimatedDocumentPart.Unclassified
                            };
                            var partCounts = decisionReport.PartLines
                                .GroupBy(line => line.Part)
                                .ToDictionary(group => group.Key, group => group.Count());
                            var knownCount = decisionReport.Goods.Count(item => item.StoreKnowledge == StoreNameKnowledge.Known);
                            var unknownCount = decisionReport.Goods.Count(item => item.StoreKnowledge == StoreNameKnowledge.Unknown);
                            var undeterminedCount = decisionReport.Goods.Count(item => item.StoreKnowledge == StoreNameKnowledge.NotDetermined);
                        }
                        <div class="small mb-1">
                            نوع الوثيقة (@DecisionReportBuilder.EstimatedLabel):
                            <strong>@DecisionReportBuilder.TypeLabel(decisionReport.DocumentType)</strong>
                        </div>
                        <div class="small mb-1">
                            المحكّم: <strong>@decisionReport.AcceptedCount مقبول / @decisionReport.RejectedCount مرفوض</strong>
                            — بدون كتابة — لا إرسال — المحكّم المدمج هو الحاكم
                        </div>
                        <div class="small mb-2">
                            أجزاء الوثيقة (تقسيم @DecisionReportBuilder.EstimatedLabel):
                            @foreach (var part in partsInOrder)
                            {
                                <span class="ms-2">@DecisionReportBuilder.PartLabel(part): @partCounts.GetValueOrDefault(part)</span>
                            }
                        </div>

                        <div class="small fw-bold mt-2">الوثيقة مُعاد تركيبها (@DecisionReportBuilder.EstimatedLabel)</div>
                        @foreach (var part in partsInOrder)
                        {
                            var linesOfPart = decisionReport.PartLines.Where(line => line.Part == part).ToList();
                            if (linesOfPart.Count == 0) continue;
                            <div class="small mt-1"><span class="badge bg-light text-dark border">@DecisionReportBuilder.PartLabel(part)</span></div>
                            <ul class="small mb-0 ps-3">
                                @foreach (var line in linesOfPart)
                                {
                                    <li>@line.Text</li>
                                }
                            </ul>
                        }

                        @{
                            var faithfulBlocks = FaithfulDocumentView.Build(decisionReport.PartLines);
                        }
                        <div class="small fw-bold mt-3">الوثيقة كما قُرئت (عرض أمين — بلا تصحيح أو حذف)</div>
                        <div class="small text-muted mb-2">
                            كل ما أخرجه القارئ منقول حرفيًا وبترتيبه، ومقسَّم إلى أجزائه. الصفوف ذات المظهر
                            الجدولي تُعرض كجدول نصي خلاياه كلمات السطر كما قُرئت؛ لا تُضاف ولا تُصحَّح ولا تُحذف
                            أي كلمة. أي تشويه في الحروف أو الأرقام يظهر هنا كما هو ليُقارَن بالصورة يدويًا.
                        </div>
                        @foreach (var part in partsInOrder)
                        {
                            var blocksOfPart = faithfulBlocks.Where(block => block.Part == part).ToList();
                            if (blocksOfPart.Count == 0) continue;
                            <div class="small mt-2"><span class="badge bg-light text-dark border">@DecisionReportBuilder.PartLabel(part)</span></div>
                            @foreach (var block in blocksOfPart)
                            {
                                if (block.Kind == FaithfulBlockKind.Table)
                                {
                                    var columnCount = block.Rows.Count == 0 ? 0 : block.Rows.Max(row => row.Count);
                                    <div class="table-responsive">
                                        <table class="table table-sm table-bordered mb-1 w-auto">
                                            <tbody>
                                                @foreach (var row in block.Rows)
                                                {
                                                    <tr>
                                                        @for (var c = 0; c < columnCount; c++)
                                                        {
                                                            <td>@(c < row.Count ? row[c] : string.Empty)</td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <div class="small">@block.Lines[0]</div>
                                }
                            }
                        }

                        <div class="small fw-bold mt-3">أصناف صفوف المحتوى</div>
                        <div class="small text-muted mb-1">
                            حكّم المدمج على @decisionReport.CandidateTotal مرشّحًا؛ يُعرض هنا
                            @(decisionReport.CandidateTotal - decisionReport.MetadataCandidateCount) مرشّحًا من صفوف المحتوى،
                            و @(decisionReport.MetadataCandidateCount) مرشّحًا من بيانات الرأس والذيل باقية في العدد الكلي ولم تُعرض كأصناف.
                        </div>
                        <div class="small mb-2">
                            معرفة الاسم بسجل المتجر (مشتقّة من سبب المدمج، لا من تخمين):
                            <span class="ms-2">معروف: @knownCount</span>
                            <span class="ms-2">غير معروف: @unknownCount</span>
                            <span class="ms-2">لم يُحدد: @undeterminedCount</span>
                        </div>
                        <div class="small mb-2">
                            التصنيف:
                            <span class="ms-2">مسجّلة معروفة: @decisionReport.RegisteredCount</span>
                            <span class="ms-2">مجهولة: @decisionReport.UnknownCount</span>
                            <span class="ms-2">مخالفة: @decisionReport.ConflictingCount</span>
                        </div>

                        @foreach (var lineGroup in decisionReport.Goods.GroupBy(item => item.SourceLine))
                        {
                            <div class="small fw-semibold mt-2">@lineGroup.Key</div>
                            <ul class="small mb-0 ps-3">
                                @foreach (var good in lineGroup)
                                {
                                    <li>
                                        <span class="fw-semibold">@good.Name</span>
                                        <span class="text-muted">— @good.Price</span>
                                        <span class="ms-1">@good.Verdict</span>
                                        <span class="ms-1 text-muted">(@DecisionReportBuilder.KnowledgeLabel(good.StoreKnowledge))</span>
                                        @if (good.CandidateCount > 1)
                                        {
                                            <span class="ms-1 text-muted">— يجمع @good.CandidateCount مرشّحات متطابقة</span>
                                        }
                                        @if (good.NearKnownNames.Count > 0)
                                        {
                                            <div class="small text-muted ms-3">
                                                قريب من: @string.Join("، ", good.NearKnownNames)
                                                — تلميح للمراجعة، ولم يعتمده المدمج
                                            </div>
                                        }
                                    </li>
                                }
                            </ul>
                        }

                        @if (decisionReport.NumericHints.Count > 0)
                        {
                            <div class="small fw-bold mt-3">احتمالات تصحيح الأرقام (للمراجعة فقط)</div>
                            <div class="small text-muted mb-1">@OcrNumericCleanup.Note</div>
                            <div class="table-responsive">
                                <table class="table table-sm table-striped mb-1">
                                    <thead>
                                        <tr><th>السطر</th><th>كما قرئ</th><th>الاحتمال</th><th>السطر الأصلي</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var hint in decisionReport.NumericHints)
                                        {
                                            <tr>
                                                <td>@hint.LineNumber</td>
                                                <td>@hint.Original</td>
                                                <td>@hint.Suggested</td>
                                                <td class="text-muted">@hint.Line</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        @if (decisionReport.ReviewHints.Count > 0)
                        {
                            <div class="small fw-bold mt-3">ملاحظات للمراجعة (تقديرية)</div>
                            <div class="small text-muted mb-1">@OcrReviewHints.Note</div>
                            <div class="table-responsive">
                                <table class="table table-sm table-striped mb-1">
                                    <thead>
                                        <tr><th>السطر</th><th>ما ظهر</th><th>الملاحظة</th><th>التوضيح</th><th>السطر الأصلي</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var hint in decisionReport.ReviewHints)
                                        {
                                            <tr>
                                                <td>@hint.LineNumber</td>
                                                <td>@hint.Token</td>
                                                <td>@OcrReviewHints.Label(hint.Kind)</td>
                                                <td>@hint.Message</td>
                                                <td class="text-muted">@hint.Line</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        <div class="small text-muted mt-2">@DecisionReportBuilder.StockNote</div>
                        <div class="small text-muted mt-1">@DecisionReportBuilder.NameMatchingNote</div>
                        <div class="small text-muted mt-1">@DecisionReportBuilder.NearNameNote</div>
                        @if (decisionReport.UnknownCount > 0 || decisionReport.ConflictingCount > 0)
                        {
                            <div class="small text-danger mt-2">تنبيه: راجع يدويًا قبل أي اعتماد.</div>
                        }
                        <div class="small text-muted mt-1">التقرير للعرض المؤقت فقط، ولا يُحتفظ به بعد إغلاق البطاقة.</div>
                        </div>
                    </details>
                }
            </div>
        </div>
        }
    </div>

    <div class="col-lg-4">
        <AiStatusPanel Status="routeStatus"
                       Loading="loadingStatus"
                       OnRefresh="RefreshStatus" />

        <div class="card route-decision-card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-bold small d-inline-flex align-items-center gap-1"><WizzIcon Icon="route" Size="15" /><span>قرارات التوجيه</span></span>
                <span class="badge bg-secondary" title="عدد القرارات في هذه الجلسة">@DecisionLog.Count</span>
            </div>
            <div class="card-body py-2">
                @if (recentDecisions.Count == 0)
                {
                    <div class="text-muted small">ستظهر هنا أسباب اختيار كل مسار بعد أول سؤال.</div>
                }
                else
                {
                    <div class="route-decision-log d-grid gap-1">
                        @foreach (var d in recentDecisions)
                        {
                            <div class="small" title="@DecisionTooltip(d.Route, d.Reason, d.Candidates)">
                                <span class="text-muted">@d.AtUtc.ToLocalTime().ToString("HH:mm")</span>
                                <strong>@RouteText.Display(d.Route)</strong>
                                <span class="text-muted">— @d.Reason</span>
                                <div class="text-truncate text-secondary">@d.Question</div>
                            </div>
                        }
                    </div>
                    <button class="btn btn-outline-secondary btn-sm w-100 mt-2" @onclick="ClearDecisionLog"><WizzIcon Icon="x-circle" Size="14" /> مسح السجل</button>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header py-2">
                <div class="d-flex align-items-center justify-content-between gap-2">
                    <span class="fw-bold small d-inline-flex align-items-center gap-1"><WizzIcon Icon="chart" Size="15" /><span>الجلسة</span></span>
                    <span class="ai-status-line" title="آخر مورّد استُخدم: @providerName">
                        <span class="badge @GetRouteBadgeClass(lastRouteType)">@lastRouteTypeLabel</span>
                        <span class="badge bg-secondary">@messages.Count رسالة</span>
                    </span>
                </div>
            </div>
            <div class="card-body py-2 d-grid gap-2">
                <button class="btn btn-outline-danger btn-sm" @onclick="ClearChat"><WizzIcon Icon="trash" Size="14" /> مسح المحادثة</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="ClearHistory"><WizzIcon Icon="x-circle" Size="14" /> مسح سجل الأسئلة</button>
                <button class="btn btn-outline-secondary btn-sm"
                        title="يمسح ما يحفظه المساعد من محادثة سابقة ومن آخر منتج تذكّره — لا يمسح تفضيلاتك (من الإعدادات)"
                        @onclick="ClearMemory"><WizzIcon Icon="brain" Size="14" /> مسح الذاكرة</button>
                @if (!string.IsNullOrWhiteSpace(rememberedSubject))
                {
                    <div class="small text-muted d-inline-flex align-items-center gap-1"><WizzIcon Icon="brain" Size="14" /><span>يتذكّر الآن:</span> <strong>@rememberedSubject</strong></div>
                }
            </div>
        </div>
    </div>
</div>

<ChatExportModal IsOpen="exportModalOpen" IsOpenChanged="OnExportModalChanged" Artifact="exportArtifact" StoreName="@storeName" />

@code {
    private List<ChatItem> messages = new();
    private string userInput = "";
    private bool sending = false;
    private bool loadingModels = false;
    private bool loadingStatus = false;
    private List<string> availableModels = new();
    private string selectedModel = "";
    private string routeMode = "auto";
    private string providerName = "المساعد المدمج (بدون نموذج)";
    private RouterStatusDto routeStatus = new(true, false, null, false, null, 1, "المساعد المدمج فقط متاح.");
    private RouteType lastRouteType = RouteType.BuiltIn;
    private string lastRouteTypeLabel = "المساعد المدمج";
    private int nextSequence = 0;

    private bool exportModalOpen = false;
    private ChatArtifact? exportArtifact;
    private string storeName = "Wizz";

    private IReadOnlyList<string> quickQuestions = Array.Empty<string>();
    private AiHistoryService? history;
    private string? rememberedSubject;
    private RouteDecision? lastDecision;
    private string? lastWorkMode;
    private string? lastTransparency;
    private IReadOnlyList<RouteDecisionEntry> recentDecisions = Array.Empty<RouteDecisionEntry>();

    // إدخال التعرّف المحلي — حالة منفصلة عن المحادثة، لا تمرّ عبر ModelRouter
    private string captureInput = "";
    private DocumentCaptureResult? captureResult;
    private DecisionReport? decisionReport;
    private bool capturing;
    private string? captureError;
    private string? lastExtractedText;
    private IBrowserFile? captureImage;
    // تحسين ومعاينة اختياريان للصورة — داخل الجهاز، بلا نماذج ولا إرسال
    private const int PreviewMaxDimension = 800;
    private bool enhanceEnabled;
    private bool previewBeforeAnalysis = true;
    private bool showEnhancedPreview = true;
    private ImageEnhanceLevel enhanceLevel = ImageEnhanceLevel.Strong;
    private bool showEnhanceSettingsModal;
    private static readonly ImageEnhanceLevel[] EnhanceLevels = Enum.GetValues<ImageEnhanceLevel>();
    private byte[]? originalImageBytes;
    private byte[]? enhancedImageBytes;
    private string? originalPreviewUrl;
    private string? enhancedPreviewUrl;
    private string? imagePreviewNote;
    // اختيار القارئ للمقارنة اليدوية؛ الافتراضي هو القرار المعتمد ولا يُحفظ
    private OcrReaderChoice selectedReader = OcrReaderChoice.Default;
    private string? lastReaderName;
    // مساعدة النموذج المحلي — عند الطلب فقط؛ الاقتراح لا يُطبَّق إلا بضغط المستخدم
    private bool assisting;
    private string? assistSuggestion;
    private string? assistError;
    // استخراج النص من الصورة عبر نموذج — إجراء رفاهي اختياري بطلب المستخدم في كل مرة، لا مسارًا روتينيًا.
    // الصورة والنتيجة تبقى في الجلسة فقط؛ لا كتابة في قاعدة البيانات ولا تطبيق تلقائي.
    private bool extractingWithModel;
    private DocumentModelRoute modelRoute = DocumentModelRoute.Local;

    // سؤال واحد يجمع طرق قراءة الصورة؛ الافتراضي هو القارئ المحلي المعتمد، ولا يوجد تبديل تلقائي.
    private enum ReadingRoute
    {
        WindowsOcr = 0,
        EmbeddedOcr = 1,
        LocalModel = 2,
        CloudModel = 3
    }

    private ReadingRoute readingRoute = ReadingRoute.WindowsOcr;

    /// <summary>الصورة الجاهزة للقراءة: المحسّنة إن كان التحسين مفعّلًا وإلا الأصلية.</summary>
    private byte[]? CurrentImageBytes => enhanceEnabled
        ? enhancedImageBytes ?? originalImageBytes
        : originalImageBytes;
    private string? modelExtractError;
    private string? modelExtractNote;
    private bool documentReaderEnabled;
    // تعلّم أسماء الأصناف من تأكيدات المستخدم فقط، وقياس دقة محلي بلا تدريب نموذج.
    private IReadOnlyList<OcrAlias> learnedAliases = Array.Empty<OcrAlias>();
    private OcrEvaluationResult? evalResult;
    private string? evalError;

    protected override async Task OnInitializedAsync()
    {
        LoadAliases();
        OcrReaderSelection.Set(OcrReaderChoice.Default);
        var imageSettings = ImageCaptureSettings.Get();
        enhanceEnabled = imageSettings.EnhanceEnabled;
        previewBeforeAnalysis = imageSettings.PreviewBeforeAnalysis;
        showEnhancedPreview = imageSettings.ShowEnhancedPreview;
        enhanceLevel = imageSettings.EnhanceLevel;
        documentReaderEnabled = ModuleGate.IsEnabled(Wizz.Application.Modules.DocumentReaderModule.Id);

        await LoadStoreNameAsync();
        await LoadRoutePriorityAsync();
        await RefreshStatus();
        await RefreshModels();
        await LoadHistoryAsync();
        await LoadMemoryAsync();
        RefreshRecentDecisions();
    }

    private void LoadAliases() => learnedAliases = OcrAliases.GetAll();

    private void ClearAliases()
    {
        OcrAliases.Clear();
        LoadAliases();
    }

    /// <summary>يقيس دقة الاستخراج على العينات المحلية بعد كل عملية قراءة، بلا زر أو تدخل من المستخدم.</summary>
    private void MeasureAccuracy()
    {
        evalError = null;
        try
        {
            evalResult = OcrEvaluator.Run();
        }
        catch (Exception ex)
        {
            evalResult = null;
            evalError = "تعذّر قياس الدقة: " + ex.Message;
        }
    }

    /// <summary>يحمّل اسم المتجر لعرضه في ترويسة طباعة المخرجات (الافتراضي: Wizz).</summary>
    private async Task LoadStoreNameAsync()
    {
        try
        {
            var result = await StoreSettings.ExecuteAsync();
            if (result.IsSuccess && !string.IsNullOrWhiteSpace(result.Value.Name))
            {
                storeName = result.Value.Name.Trim();
            }
        }
        catch
        {
            // غياب إعدادات المتجر لا يمنع الطباعة بالاسم الافتراضي.
        }
    }

    /// <summary>يحمّل أولوية المسارات المحفوظة محلياً — يستخدمها الموجّه في هذه الجلسة.</summary>
    private async Task LoadRoutePriorityAsync()
    {
        try
        {
            await PriorityStore.LoadAsync();
        }
        catch
        {
            // غياب التخزين المحلي لا يمنع عمل المحادثة.
        }
    }

    /// <summary>اسم الاختيار الحالي للجهة المُجيبة (يظهر تحت صندوق الإرسال).</summary>
    private string CurrentRouteLabel => routeMode switch
    {
        "built-in" => "المدمج (مُثبَّت)",
        "local" => "المحلي (مُثبَّت)",
        "cloud" => "السحابي (مُثبَّت)",
        _ => "تلقائي"
    };

    /// <summary>ترتيب الأولوية المحفوظ كنص عربي: «المدمج ← المحلي ← السحابي».</summary>
    private string PriorityOrderText
        => string.Join(" ← ", PriorityStore.Priority.Order.Select(RouteText.Display));

    /// <summary>عنوان فقاعة الانتظار أثناء تجهيز الرد — يوضّح الجهة المتوقعة.</summary>
    private string PendingLabel => routeMode switch
    {
        "built-in" => "المساعد المدمج يجهّز الرد…",
        "local" => "النموذج المحلي يكتب…",
        "cloud" => "النموذج السحابي يكتب…",
        _ => "جارٍ اختيار الجهة المناسبة…"
    };

    /// <summary>سطر توضيحي تحت عنوان الانتظار (يُذكّر بمصدر الإجابة).</summary>
    private string PendingHint => routeMode == "auto"
        ? "أسئلة المبيعات والأسعار يجيب عنها المدمج فوراً؛ الأسئلة الحرة قد تستغرق لحظات."
        : "الرد من الجهة المثبّتة يدوياً — يمكنك الانتظار أو تغيير الجهة بعد الرد.";

    /// <summary>توضيح الجهة التي ستجيب عند إعادة إرسال سؤال معدَّل.</summary>
    private string BuildRouteHint() => routeMode switch
    {
        "built-in" => "مُثبَّت يدوياً على المدمج — تُعاد الإجابة من بيانات متجرك مباشرة.",
        "local" => "مُثبَّت يدوياً على المحلي" +
                   (string.IsNullOrWhiteSpace(selectedModel) ? string.Empty : $" ({selectedModel})") +
                   " — تُعاد الإجابة من نموذج جهازك.",
        "cloud" => "مُثبَّت يدوياً على السحابي — تُعاد الإجابة عبر الإنترنت.",
        _ => $"تلقائي — الأولوية الحالية: {PriorityOrderText}. أسئلة الأرقام يجيب عنها المدمج دائماً لضمان الدقة."
    };

    /// <summary>يحدّث لائحة آخر قرارات التوجيه المعروضة في اللوحة الجانبية.</summary>
    private void RefreshRecentDecisions() => recentDecisions = DecisionLog.Recent(5);

    /// <summary>يمسح سجل قرارات التوجيه المعروض (لا يؤثر على المحادثة).</summary>
    private void ClearDecisionLog()
    {
        DecisionLog.Clear();
        recentDecisions = Array.Empty<RouteDecisionEntry>();
        lastDecision = null;
    }

    /// <summary>يبني تلميحاً يشرح سبب القرار ودرجة كل مرشح.</summary>
    private static string DecisionTooltip(RouteType chosen, string reason, IReadOnlyList<RouteCandidate> candidates)
    {
        var lines = new List<string> { $"القرار: {RouteText.Display(chosen)} — {reason}" };
        foreach (var candidate in candidates)
        {
            lines.Add(candidate switch
            {
                { Checked: false } => $"{RouteText.Display(candidate.Route)}: {candidate.Reason}",
                { Eligible: true } => $"{RouteText.Display(candidate.Route)}: {candidate.Score} نقطة — {candidate.Reason}",
                _ => $"{RouteText.Display(candidate.Route)}: غير متاح — {candidate.Reason}"
            });
        }

        return string.Join(" | ", lines);
    }

