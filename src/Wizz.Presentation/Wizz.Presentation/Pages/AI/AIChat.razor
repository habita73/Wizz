    private ImageCaptureSettings CurrentImageSettings() =>
        new(enhanceEnabled, previewBeforeAnalysis, showEnhancedPreview, enhanceLevel);

    /// <summary>يقرأ الصورة بالقارئ المحلي المفعّل، ثم يعرض حكم المدمج على النص المستخرج فقط.</summary>
    private async Task RunImageCaptureAsync()
    {
        var bytes = CurrentImageBytes;
        if (capturing || bytes is null) return;

        capturing = true;
        captureError = null;
        lastExtractedText = null;
        assistSuggestion = null;
        assistError = null;
        modelExtractError = null;
        modelExtractNote = null;
        lastReaderName = null;
        OcrReaderSelection.Set(selectedReader);
        StateHasChanged();

        try
        {
            var result = await OcrCaptureService.CaptureAsync(bytes);
            if (!result.ReaderAvailable)
            {
                captureResult = null;
                decisionReport = null;
                captureError = result.UnavailableReason ?? "قارئ النص غير متاح على هذا الجهاز؛ استخدم الإدخال اليدوي.";
                return;
            }

            captureInput = result.RecognizedText;
            lastExtractedText = result.RecognizedText;
            captureResult = result.Adjudication;
            lastReaderName = result.ReaderName;
            decisionReport = DecisionReportBuilder.Build(result.RecognizedText, captureResult.Adjudication);
            MeasureAccuracy();
            if (string.IsNullOrWhiteSpace(result.RecognizedText))
            {
                captureError = "لم يستخرج القارئ نصًا من الصورة.";
            }
        }
        catch (Exception ex)
        {
            captureResult = null;
            decisionReport = null;
            captureError = $"تعذّت قراءة الصورة: {ex.Message}";
        }
        finally
        {
            capturing = false;
            StateHasChanged();
        }
    }

    private void ScrollToBottom()
    {
        _ = JS.InvokeVoidAsync("eval",
            "setTimeout(() => { const el = document.getElementById('chatMessages'); if (el) el.scrollTo({ top: el.scrollHeight, behavior: 'smooth' }); }, 80)");
    }
}