@namespace Wizz.Presentation.Pages.AI

@using Wizz.Application.Abstractions
@using Wizz.Application.DTOs
@inject IModelRouter Router

@* لوحة حالة المسارات: سطر واحد للتلخيص + تفاصيل قابلة للطي + أزرار اختبار مصغّرة. *@

<div class="card mb-3 ai-status-card">
    <div class="card-header py-2">
        <div class="d-flex align-items-center justify-content-between gap-2">
            <span class="fw-bold small">🔀 المسارات</span>
            <div class="d-flex align-items-center gap-1">
                <span class="ai-status-line" title="@StatusTooltip">
                    <span class="badge bg-success" title="المساعد المدمج — يعمل دائماً بلا إنترنت">⚡ مدمج</span>
                    @if (Status.LocalAvailable)
                    {
                        <span class="badge bg-success" title="النموذج المحلي (Ollama) — @Status.LocalModel">🟢 @ShortLocalModel</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary" title="النموذج المحلي (Ollama) غير متاح">⚪ محلي</span>
                    }
                    @if (Status.CloudAvailable)
                    {
                        <span class="badge bg-success" title="النموذج السحابي — @Status.CloudProvider">☁️ @ShortCloudProvider</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary" title="النموذج السحابي غير متاح">⚪ سحابي</span>
                    }
                </span>
                <button type="button" class="btn btn-sm btn-outline-secondary ai-mini-btn"
                        title="تحديث حالة المسارات"
                        aria-label="تحديث حالة المسارات"
                        @onclick="OnRefresh"
                        disabled="@Loading">
                    @(Loading ? "…" : "🔄")
                </button>
            </div>
        </div>
    </div>

    <div class="card-body py-2">
        <details class="ai-status-details">
            <summary class="small">التفاصيل والاختبار</summary>

            <div class="mt-2 small">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span>
                        ⚡ المساعد المدمج
                        <span class="text-muted ms-1" title="مساعد برمجي يجيب من قاعدة بيانات متجرك فوراً، بلا إنترنت وبلا نموذج.">❓</span>
                    </span>
                    <span class="badge bg-success">متاح دائماً</span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span>
                        🟢 النموذج المحلي
                        <span class="text-muted ms-1" title="نموذج على جهازك عبر Ollama — يُستخدم للأسئلة الحرة الطويلة عندما لا يكفي المساعد المدمج.">❓</span>
                    </span>
                    <span class="d-flex align-items-center gap-1">
                        <span class="badge @(Status.LocalAvailable ? "bg-success" : "bg-secondary")">
                            @(Status.LocalAvailable ? ShortLocalModel : "غير متاح")
                        </span>
                        <button type="button" class="btn btn-sm btn-outline-secondary ai-mini-btn"
                                title="اختبار النموذج المحلي"
                                aria-label="اختبار النموذج المحلي"
                                @onclick="TestLocalAsync"
                                disabled="@testingLocal">
                            @(testingLocal ? "…" : "🔄")
                        </button>
                    </span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span>
                        ☁️ النموذج السحابي
                        <span class="text-muted ms-1" title="خدمة سحابية اختيارية (OpenRouter) — تُفعَّل من صفحة الإعدادات، وترسل بياناتك خارج المتجر.">❓</span>
                    </span>
                    <span class="d-flex align-items-center gap-1">
                        <span class="badge @(Status.CloudAvailable ? "bg-success" : "bg-secondary")">
                            @(Status.CloudAvailable ? ShortCloudProvider : "غير متاح")
                        </span>
                        <button type="button" class="btn btn-sm btn-outline-secondary ai-mini-btn"
                                title="اختبار الاتصال بالسحابة"
                                aria-label="اختبار الاتصال بالسحابة"
                                @onclick="TestCloudAsync"
                                disabled="@testingCloud">
                            @(testingCloud ? "…" : "🔄")
                        </button>
                    </span>
                </div>

                @if (!string.IsNullOrWhiteSpace(localTestResult))
                {
                    <div class="alert alert-info py-1 px-2 mb-1">@localTestResult</div>
                }
                @if (!string.IsNullOrWhiteSpace(cloudTestResult))
                {
                    <div class="alert alert-info py-1 px-2 mb-1">@cloudTestResult</div>
                }

                <div class="alert alert-info py-1 px-2 mb-2">@Status.SummaryMessage</div>

                <a href="/settings" class="small">⚙️ الإعدادات التفصيلية للمساعد</a>
            </div>
        </details>
    </div>
</div>

@code {
    /// <summary>حالة المسارات كما يوفّرها الموجّه.</summary>
    [Parameter] public RouterStatusDto Status { get; set; } = new(true, false, null, false, null, 1, "المساعد المدمج فقط متاح.");

    /// <summary>هل يجري التحديث الآن؟</summary>
    [Parameter] public bool Loading { get; set; }

    /// <summary>يُستدعى عند طلب تحديث الحالة من الواجهة الأم.</summary>
    [Parameter] public EventCallback OnRefresh { get; set; }

    private bool testingLocal;
    private bool testingCloud;
    private string localTestResult = "";
    private string cloudTestResult = "";

    /// <summary>اسم مبسّط للنموذج المحلي (بدون بادئة المزوّد).</summary>
    private string ShortLocalModel => ShortModelName(Status.LocalModel);

    /// <summary>اسم مبسّط لمزوّد السحابة.</summary>
    private string ShortCloudProvider
    {
        get
    {
            var raw = Status.CloudProvider;
            if (string.IsNullOrWhiteSpace(raw)) return "سحابي";
            var paren = raw.IndexOf('(');
            return paren >= 0 ? raw[..paren].Trim() : raw.Trim();
        }
    }

    /// <summary>يستخرج اسم النموذج من نص بصيغة «المزوّد — النموذج».</summary>
    private static string ShortModelName(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "محلي";
        var dash = raw.LastIndexOf('—');
        return dash >= 0 && dash < raw.Length - 1 ? raw[(dash + 1)..].Trim() : raw.Trim();
    }

    /// <summary>يضيف رمز الحالة فقط إذا لم يكن موجوداً أصلاً في الرسالة.</summary>
    private static string WithIcon(string? message, bool ok)
    {
        var trimmed = (message ?? string.Empty).Trim();
        if (trimmed.Length == 0) return ok ? "✅" : "❌";
        if (trimmed.StartsWith('✅') || trimmed.StartsWith('❌')) return trimmed;
        return ok ? $"✅ {trimmed}" : $"❌ {trimmed}";
    }

    /// <summary>نص التلخيص الكامل (يظهر كtooltip على سطر الحالة).</summary>
    private string StatusTooltip =>
        $"المساعد المدمج: متاح دائماً • النموذج المحلي: {(Status.LocalAvailable ? Status.LocalModel : "غير متاح")} • السحابي: {(Status.CloudAvailable ? Status.CloudProvider : "غير متاح")} • عدد المسارات: {Status.RouteCount}";

    /// <summary>اختبار مصغّر للنموذج المحلي.</summary>
    private async Task TestLocalAsync()
    {
        testingLocal = true;
        localTestResult = "";
        try
        {
            var status = await Router.GetStatusAsync();
            localTestResult = status.LocalAvailable
                ? WithIcon($"النموذج المحلي يعمل — {ShortModelName(status.LocalModel)}", true)
                : WithIcon("النموذج المحلي غير متاح. تأكّد من تشغيل Ollama ثم ثبّت نموذجاً: ollama pull qwen2.5:0.5b-instruct", false);
        }
        catch (Exception ex)
        {
            localTestResult = WithIcon($"تعذّر اختبار النموذج المحلي: {ex.Message}", false);
        }
        finally
        {
            testingLocal = false;
        }

        await OnRefresh.InvokeAsync();
    }

    /// <summary>اختبار مصغّر لاتصال السحابة.</summary>
    private async Task TestCloudAsync()
    {
        testingCloud = true;
        cloudTestResult = "";
        try
        {
            var (ok, message) = await Router.TestCloudConnectionAsync();
            cloudTestResult = WithIcon(message, ok);
        }
        catch (Exception ex)
        {
            cloudTestResult = WithIcon($"تعذّر اختبار السحابة: {ex.Message}", false);
        }
        finally
        {
            testingCloud = false;
        }

        await OnRefresh.InvokeAsync();
    }
}
