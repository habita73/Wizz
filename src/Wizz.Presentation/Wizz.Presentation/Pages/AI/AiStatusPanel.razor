@namespace Wizz.Presentation.Pages.AI

@using Wizz.Application.Abstractions
@using Wizz.Application.DTOs
@inject IModelRouter Router

@* لوحة حالة المسارات: سطر واحد للتلخيص + تفاصيل قابلة للطي + أزرار اختبار مصغّرة. *@

<div class="card mb-3 ai-status-card">
    <div class="card-header py-2">
        <div class="d-flex align-items-center justify-content-between gap-2">
            <span class="fw-bold small d-inline-flex align-items-center gap-1"><WizzIcon Icon="route" Size="15" /><span>المسارات</span></span>
            <div class="d-flex align-items-center gap-1">
                <span class="ai-status-line" title="@StatusTooltip">
                    <span class="badge bg-success" title="المساعد المدمج — يعمل دائماً بلا إنترنت"><WizzIcon Icon="zap" Size="12" /> مدمج</span>
                    @if (Status.LocalAvailable)
                    {
                        <span class="badge bg-success" title="النموذج المحلي (Ollama) — @Status.LocalModel"><WizzIcon Icon="brain" Size="12" /> @ShortLocalModel</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary" title="النموذج المحلي (Ollama) غير متاح">محلي</span>
                    }
                    @if (Status.CloudAvailable)
                    {
                        <span class="badge bg-success" title="النموذج السحابي — @Status.CloudProvider"><WizzIcon Icon="cloud" Size="12" /> @ShortCloudProvider</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary" title="النموذج السحابي غير متاح">سحابي</span>
                    }
                </span>
                <button type="button" class="btn btn-sm btn-outline-secondary ai-mini-btn"
                        title="تحديث حالة المسارات"
                        aria-label="تحديث حالة المسارات"
                        @onclick="OnRefresh"
                        disabled="@Loading">
                    @if (Loading)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <WizzIcon Icon="refresh" Size="14" />
                    }
                </button>
            </div>
        </div>
    </div>

    <div class="card-body py-2">
        <details class="ai-status-details">
            <summary class="small">التفاصيل والاختبار</summary>

            <div class="mt-2 small">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span>
                        <WizzIcon Icon="zap" Size="14" /> المساعد المدمج
                        <span class="text-muted ms-1" title="مساعد برمجي يجيب من قاعدة بيانات متجرك فوراً، بلا إنترنت وبلا نموذج."><WizzIcon Icon="help" Size="14" /></span>
                    </span>
                    <span class="badge bg-success">متاح دائماً</span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span>
                        <WizzIcon Icon="brain" Size="14" /> النموذج المحلي
                        <span class="text-muted ms-1" title="نموذج على جهازك عبر Ollama — يُستخدم للأسئلة الحرة الطويلة عندما لا يكفي المساعد المدمج."><WizzIcon Icon="help" Size="14" /></span>
                    </span>
                    <span class="d-flex align-items-center gap-1">
                        <span class="badge @(Status.LocalAvailable ? "bg-success" : "bg-secondary")">
                            @(Status.LocalAvailable ? ShortLocalModel : "غير متاح")
                        </span>
                        <button type="button" class="btn btn-sm btn-outline-secondary ai-mini-btn"
                                title="اختبار النموذج المحلي"
                                aria-label="اختبار النموذج المحلي"
                                @onclick="TestLocalAsync"
                                disabled="@testingLocal">
                            @if (testingLocal)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                            }
                            else
                            {
                                <WizzIcon Icon="refresh" Size="14" />
                            }
                        </button>
                    </span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span>
                        <WizzIcon Icon="cloud" Size="14" /> النموذج السحابي
                        <span class="text-muted ms-1" title="خدمة سحابية اختيارية (OpenRouter) — تُفعَّل من صفحة الإعدادات، وترسل بياناتك خارج المتجر."><WizzIcon Icon="help" Size="14" /></span>
                    </span>
                    <span class="d-flex align-items-center gap-1">
                        <span class="badge @(Status.CloudAvailable ? "bg-success" : "bg-secondary")">
                            @(Status.CloudAvailable ? ShortCloudProvider : "غير متاح")
                        </span>
                        <button type="button" class="btn btn-sm btn-outline-secondary ai-mini-btn"
                                title="اختبار الاتصال بالسحابة"
                                aria-label="اختبار الاتصال بالسحابة"
                                @onclick="TestCloudAsync"
                                disabled="@testingCloud">
                            @if (testingCloud)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                            }
                            else
                            {
                                <WizzIcon Icon="refresh" Size="14" />
                            }
                        </button>
                    </span>
                </div>

                @if (!string.IsNullOrWhiteSpace(localTestResult))
                {
                    <div class="alert alert-info py-1 px-2 mb-1 d-flex align-items-center gap-2">
                        <WizzIcon Icon="@(localTestOk == false ? "alert" : "check-circle")" Size="14" />
                        <span>@localTestResult</span>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(cloudTestResult))
                {
                    <div class="alert alert-info py-1 px-2 mb-1 d-flex align-items-center gap-2">
                        <WizzIcon Icon="@(cloudTestOk == false ? "alert" : "check-circle")" Size="14" />
                        <span>@cloudTestResult</span>
                    </div>
                }

                <div class="alert alert-info py-1 px-2 mb-2">@Status.SummaryMessage</div>

                <a href="/settings" class="small d-inline-flex align-items-center gap-1"><WizzIcon Icon="settings" Size="14" /><span>الإعدادات التفصيلية للمساعد</span></a>
            </div>
        </details>
    </div>
</div>

@code {
    /// <summary>حالة المسارات كما يوفّرها الموجّه.</summary>
    [Parameter] public RouterStatusDto Status { get; set; } = new(true, false, null, false, null, 1, "المساعد المدمج فقط متاح.");

    /// <summary>هل يجري التحديث الآن؟</summary>
    [Parameter] public bool Loading { get; set; }

    /// <summary>يُستدعى عند طلب تحديث الحالة من الواجهة الأم.</summary>
    [Parameter] public EventCallback OnRefresh { get; set; }

    private bool testingLocal;
    private bool testingCloud;
    private string localTestResult = "";
    private string cloudTestResult = "";
    private bool? localTestOk;
    private bool? cloudTestOk;

    /// <summary>اسم مبسّط للنموذج المحلي (بدون بادئة المزوّد).</summary>
    private string ShortLocalModel => ShortModelName(Status.LocalModel);

    /// <summary>اسم مبسّط لمزوّد السحابة.</summary>
    private string ShortCloudProvider
    {
        get
    {
            var raw = Status.CloudProvider;
            if (string.IsNullOrWhiteSpace(raw)) return "سحابي";
            var paren = raw.IndexOf('(');
            return paren >= 0 ? raw[..paren].Trim() : raw.Trim();
        }
    }

    /// <summary>يستخرج اسم النموذج من نص بصيغة «المزوّد — النموذج».</summary>
    private static string ShortModelName(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "محلي";
        var dash = raw.LastIndexOf('—');
        return dash >= 0 && dash < raw.Length - 1 ? raw[(dash + 1)..].Trim() : raw.Trim();
    }

    /// <summary>يُنظّف نص نتيجة الاختبار ويعطيه نصاً بديلاً عند الفراغ.</summary>
    private static string NormalizeResult(string? message, bool ok)
    {
        var trimmed = (message ?? string.Empty).Trim();
        return trimmed.Length == 0
            ? (ok ? "تم الاختبار بنجاح." : "تعذّر إكمال الاختبار.")
            : trimmed;
    }

    /// <summary>نص التلخيص الكامل (يظهر كtooltip على سطر الحالة).</summary>
    private string StatusTooltip =>
        $"المساعد المدمج: متاح دائماً • النموذج المحلي: {(Status.LocalAvailable ? Status.LocalModel : "غير متاح")} • السحابي: {(Status.CloudAvailable ? Status.CloudProvider : "غير متاح")} • عدد المسارات: {Status.RouteCount}";

    /// <summary>اختبار مصغّر للنموذج المحلي.</summary>
    private async Task TestLocalAsync()
    {
        testingLocal = true;
        localTestResult = "";
        localTestOk = null;
        try
        {
            var status = await Router.GetStatusAsync();
            localTestOk = status.LocalAvailable;
            localTestResult = status.LocalAvailable
                ? NormalizeResult($"النموذج المحلي يعمل — {ShortModelName(status.LocalModel)}", true)
                : NormalizeResult("النموذج المحلي غير متاح. تأكّد من تشغيل Ollama ثم ثبّت نموذجاً: ollama pull qwen2.5:0.5b-instruct", false);
        }
        catch (Exception ex)
        {
            localTestOk = false;
            localTestResult = NormalizeResult($"تعذّر اختبار النموذج المحلي: {ex.Message}", false);
        }
        finally
        {
            testingLocal = false;
        }

        await OnRefresh.InvokeAsync();
    }

    /// <summary>اختبار مصغّر لاتصال السحابة.</summary>
    private async Task TestCloudAsync()
    {
        testingCloud = true;
        cloudTestResult = "";
        cloudTestOk = null;
        try
        {
            var (ok, message) = await Router.TestCloudConnectionAsync();
            cloudTestOk = ok;
            cloudTestResult = NormalizeResult(message, ok);
        }
        catch (Exception ex)
        {
            cloudTestOk = false;
            cloudTestResult = NormalizeResult($"تعذّر اختبار السحابة: {ex.Message}", false);
        }
        finally
        {
            testingCloud = false;
        }

        await OnRefresh.InvokeAsync();
    }
}
