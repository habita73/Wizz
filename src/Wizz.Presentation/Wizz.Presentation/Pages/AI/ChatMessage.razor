@namespace Wizz.Presentation.Pages.AI

@using Wizz.Application.Abstractions
@using Wizz.Application.AI.Artifacts

<div class="d-flex mb-3 @(Message.IsUser ? "justify-content-end" : "justify-content-start")">
    <div class="@WrapperClass" style="max-width: 85%;">
        <div class="d-flex justify-content-between align-items-start mb-1 gap-2 flex-wrap">
            <div class="d-flex align-items-center gap-2">
                <span class="small fw-bold @(Message.IsUser ? "text-white-50" : "text-muted")">
                    @(Message.IsUser ? "أنت" : "Wizz")
                </span>
                <span class="small @(Message.IsUser ? "text-white-50" : "text-muted")">@Message.Timestamp.ToString("HH:mm")</span>
                @if (!Message.IsUser && !string.IsNullOrWhiteSpace(Message.Route))
                {
                    <span class="msg-route-chip @GetRouteChipClass(Message.Route)">
                        @GetRouteLabel(Message.Route)
                    </span>
                }
                @if (!Message.IsUser && Message.IsWebAnswer)
                {
                    <span class="msg-route-chip web" title="معلومة من الإنترنت — ليست من بيانات متجرك">
                        إنترنت
                    </span>
                }
            </div>

            @if (!IsEditing)
            {
                <div class="btn-group btn-group-sm" role="group">
                    @if (Message.IsUser)
                    {
                        <button type="button" class="btn btn-outline-secondary" @onclick="StartEdit"
                                title="تعديل وإعادة البناء من هنا" aria-label="تعديل">
                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                <path d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 0 0 0 0-.708zm.646 6.061L9.793 2.5 3.293 9H3.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.207zm-7.468 7.468A.5.5 0 0 1 6 13.5V13h-.5a.5.5 0 0 1-.5-.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.5-.5V10h-.5a.5.5 0 0 1-.175-.032l-.179.178a.5.5 0 0 0-.11.168l-2 5a.5.5 0 0 0 .65.65l5-2a.5.5 0 0 0 .168-.11z" />
                            </svg>
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-outline-secondary" @onclick="Copy"
                                title="نسخ الرد" aria-label="نسخ">
                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                <path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1z" />
                                <path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0z" />
                            </svg>
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn btn-success" @onclick="SaveEdit" title="حفظ وإعادة البناء" aria-label="حفظ">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425z" />
                        </svg>
                    </button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit" title="إلغاء" aria-label="إلغاء">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708" />
                        </svg>
                    </button>
                </div>
            }
        </div>

        @if (IsEditing)
        {
            <textarea class="form-control form-control-sm mb-2" @bind="editContent" @bind:event="oninput" rows="3"
                      @onkeydown="OnEditKeyDown"></textarea>
            @if (EditFooter is not null)
            {
                <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                    <span class="small text-muted">الجهة:</span>
                    @EditFooter
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(RouteHint))
            {
                <div class="small text-muted mb-1">@RouteHint</div>
            }
            <div class="form-text small">Enter للحفظ، Shift+Enter لسطر جديد. سيُعاد بناء المحادثة من هنا.</div>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(CleanText))
            {
                <div class="msg-content">@CleanText</div>
            }
            @foreach (var artifact in VisibleArtifacts)
            {
                <ArtifactCard Artifact="artifact"
                              StoreName="@StoreName"
                              OnDelete="OnArtifactDelete"
                              OnExport="OnArtifactExport" />
            }
        }
    </div>
</div>

@code {
    [Parameter] public ChatItem Message { get; set; } = new();
    [Parameter] public RenderFragment? EditFooter { get; set; }

    /// <summary>اسم المتجر الذي يظهر في ترويسة الطباعة.</summary>
    [Parameter] public string StoreName { get; set; } = "Wizz";

    /// <summary>توضيح الجهة التي ستجيب عن هذا السؤال عند إعادة إرساله (يظهر في وضع التحرير).</summary>
    [Parameter] public string? RouteHint { get; set; }
    [Parameter] public EventCallback<ChatItem> OnEdit { get; set; }
    [Parameter] public EventCallback<ChatItem> OnCopy { get; set; }
    [Parameter] public EventCallback<ChatArtifact> OnArtifactDelete { get; set; }
    [Parameter] public EventCallback<ChatArtifact> OnArtifactExport { get; set; }

    private bool IsEditing { get; set; }
    private string editContent = "";

    private (string Text, List<ChatArtifact> Artifacts) Parsed =>
        Message.CleanContent is not null
            ? (Message.CleanContent, Message.Artifacts)
            : ArtifactParser.Parse(Message.Content);

    private string CleanText => Parsed.Text;

    private List<ChatArtifact> VisibleArtifacts =>
        Parsed.Artifacts.Where(a => !a.IsRemoved).ToList();

    private string WrapperClass =>
        Message.IsUser
            ? "msg-user rounded-3 px-3 py-2"
            : "msg-assistant rounded-3 px-3 py-2";

    private string GetRouteChipClass(string route) => route switch
    {
        "BuiltIn" => "built-in",
        "Local" => "local",
        "Cloud" => "cloud",
        _ => "built-in"
    };

    private string GetRouteLabel(string route) => route switch
    {
        "BuiltIn" => "المدمج",
        "Local" => "محلي",
        "Cloud" => "سحابي",
        _ => "النظام"
    };

    private void StartEdit()
    {
        editContent = Message.Content;
        IsEditing = true;
    }

    private void CancelEdit()
    {
        IsEditing = false;
        editContent = "";
    }

    private async Task SaveEdit()
    {
        if (string.IsNullOrWhiteSpace(editContent))
        {
            IsEditing = false;
            return;
        }

        var updated = Message with { Content = editContent.Trim() };
        IsEditing = false;
        editContent = "";
        await OnEdit.InvokeAsync(updated);
    }

    private async Task OnEditKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SaveEdit();
        }
    }

    private async Task Copy()
    {
        await OnCopy.InvokeAsync(Message);
    }
}
