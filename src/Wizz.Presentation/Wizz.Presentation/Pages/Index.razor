@page "/"
@layout MainLayout
@inject Wizz.Application.Abstractions.ISaleRepository SaleRepo
@inject Wizz.Application.Abstractions.IProductRepository ProductRepo
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

<h1 class="h3 mb-1">Wizz — نظام نقاط بيع ذكي</h1>
<p class="text-muted">مرحباً بك. هذه نظرة سريعة على حالة المتجر اليوم.</p>

@if (showHint)
{
    <div class="alert alert-info d-flex align-items-start gap-2 mt-3 mb-0" role="note">
        <WizzIcon Icon="keyboard" Size="18" />
        <div class="flex-grow-1 small">
            <strong>اختصارات سريعة:</strong>
            اضغط <kbd>Alt</kbd>+<kbd>1</kbd> لبيع جديد،
            <kbd>Alt</kbd>+<kbd>2</kbd> للديون،
            <kbd>Alt</kbd>+<kbd>3</kbd> للفواتير المتأخرة،
            <kbd>Alt</kbd>+<kbd>4</kbd> لسجل المبيعات.
        </div>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="DismissHintAsync">فهمت</button>
    </div>
}

<div class="quick-actions card mt-3 mb-2">
    <div class="card-body py-3">
        <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
            <span class="fw-bold small d-inline-flex align-items-center gap-2">
                <WizzIcon Icon="zap" Size="16" />
                <span>إجراءات سريعة</span>
            </span>
            <span class="small text-muted">Alt + 1..4</span>
        </div>
        <div class="quick-actions-grid">
            @foreach (var action in QuickActions)
            {
                <a class="quick-action" href="@action.Href" title="@action.Label (Alt+@action.Key)">
                    <WizzIcon Icon="@action.Icon" Size="20" />
                    <span class="quick-action-label">@action.Label</span>
                    <kbd class="quick-action-key">Alt+@action.Key</kbd>
                </a>
            }
        </div>
    </div>
</div>

@if (LowStockCount > 0)
{
    <div class="stock-alert mt-2 mb-2" role="alert">
        <WizzIcon Icon="alert" Size="20" Class="stock-alert-icon" />
        <div class="flex-grow-1">
            <div class="fw-bold small">تنبيه المخزون: @LowStockCount @(LowStockCount == 1 ? "منتج" : "منتجات") بلغت حد إعادة الطلب</div>
            <div class="stock-alert-list">@LowStockNames</div>
        </div>
        <a href="/products?lowStock=true" class="btn btn-sm btn-outline-warning flex-shrink-0">عرض المنتجات</a>
    </div>
}

<div class="row g-3 my-4 equal-cols">
    <div class="col-md-3">
        <div class="dashboard-card stats-card">
            <div class="card-body">
                <svg class="svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/>
                    <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
                    <circle cx="12" cy="7" r="4"/>
                </svg>
                <div class="text-muted small">مبيعات اليوم</div>
                <div class="fs-4 fw-bold">@TodaySales.ToString("N2") د.ج</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="dashboard-card stats-card">
            <div class="card-body">
                <svg class="svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/>
                    <line x1="1" y1="10" x2="23" y2="10"/>
                    <line x1="1" y1="16" x2="23" y2="16"/>
                </svg>
                <div class="text-muted small">عمليات اليوم</div>
                <div class="fs-4 fw-bold">@TodayCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="dashboard-card stats-card">
            <div class="card-body">
                <svg class="svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8Z"/>
                </svg>
                <div class="text-muted small">إجمالي الديون المستحقة</div>
                <div class="fs-4 fw-bold @(TotalRemaining > 0 ? "text-danger" : "")">@TotalRemaining.ToString("N2") د.ج</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="dashboard-card stats-card">
            <div class="card-body">
                <svg class="svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
                <div class="text-muted small">المنتجات المسجلة</div>
                <div class="fs-4 fw-bold">@ProductCount</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 equal-cols">
    <div class="col-md-3">
        <div class="dashboard-card action-card">
            <div class="card-body">
                <svg class="svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
                    <path d="M16 21V5a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h6"/>
                </svg>
                <h5 class="card-title">بيع جديد</h5>
                <p class="card-text small text-muted">إنشاء عملية بيع سريعة</p>
                <div class="card-actions">
                    <a href="/sales/new" class="btn btn-primary w-100">ابدأ البيع</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="dashboard-card action-card">
            <div class="card-body">
                <svg class="svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="7" height="5" rx="1" ry="1"/>
                    <rect x="14" y="3" width="7" height="5" rx="1" ry="1"/>
                    <rect x="3" y="10" width="7" height="5" rx="1" ry="1"/>
                    <rect x="14" y="10" width="7" height="5" rx="1" ry="1"/>
                    <rect x="3" y="17" width="7" height="5" rx="1" ry="1"/>
                    <rect x="14" y="17" width="7" height="5" rx="1" ry="1"/>
                </svg>
                <h5 class="card-title">المنتجات</h5>
                <p class="card-text small text-muted">إدارة المنتجات والأسعار</p>
                <div class="card-actions">
                    <a href="/products" class="btn btn-outline-primary w-100">عرض المنتجات</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="dashboard-card action-card">
            <div class="card-body">
                <svg class="svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="20" x2="18" y2="9"/>
                    <line x1="12" y1="20" x2="12" y2="4"/>
                    <line x1="6" y1="20" x2="6" y2="14"/>
                </svg>
                <h5 class="card-title">التقارير</h5>
                <p class="card-text small text-muted">مبيعات، طرق دفع، أفضل المنتجات</p>
                <div class="card-actions">
                    <a href="/reports" class="btn btn-outline-primary w-100">عرض التقارير</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="dashboard-card action-card">
            <div class="card-body">
                <svg class="svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3"/>
                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2v-1a2 2 0 0 1-2-2v-5a1.65 1.65 0 0 0-1-1.51l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H19a1.65 1.65 0 0 0 1.5-1 1.65 1.65 0 0 0-.33-1Z"/>
                    <line x1="12" y1="15" x2="12.01" y2="15"/>
                </svg>
                <h5 class="card-title">الإعدادات</h5>
                <p class="card-text small text-muted">المتجر، المستخدمون، النسخ الاحتياطي</p>
                <div class="card-actions">
                    <a href="/settings" class="btn btn-outline-primary w-100">الإعدادات</a>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private decimal TodaySales;
    private int TodayCount;
    private decimal TotalRemaining;
    private int ProductCount;
    private int LowStockCount;
    private string LowStockNames = "";

    private bool showHint;
    private DotNetObjectReference<Index>? selfRef;

    /// <summary>الإجراءات السريعة: الوجهة موجودة ومتحقّقة، والاختصار Alt+الرقم.</summary>
    private static readonly (string Key, string Icon, string Label, string Href)[] QuickActions =
    {
        ("1", "bag", "بيع جديد", "sales/new"),
        ("2", "credit", "الديون", "debts"),
        ("3", "alert", "الفواتير المتأخرة", "debts?overdue=true"),
        ("4", "receipt", "المبيعات", "sales/history")
    };

    protected override async Task OnInitializedAsync()
    {
        var today = DateTime.Today.ToUniversalTime();
        var tomorrow = DateTime.Today.AddDays(1).ToUniversalTime();

        var sales = await SaleRepo.GetByDateRangeAsync(today, tomorrow);
        var completed = sales.Where(s => s.Status != SaleStatus.Cancelled).ToList();

        TodaySales = completed.Sum(s => s.Total);
        TodayCount = completed.Count;
        TotalRemaining = await SaleRepo.GetTotalRemainingAsync();
        ProductCount = await ProductRepo.CountAsync();

        var lowStock = await ProductRepo.GetLowStockAsync();
        LowStockCount = lowStock.Count;
        LowStockNames = lowStock.Count == 0
            ? ""
            : string.Join("، ", lowStock.Take(3).Select(p => $"{p.Name} ({p.StockQuantity.ToString("N2")})"))
              + (lowStock.Count > 3 ? $"، و{lowStock.Count - 3} أخرى" : "");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("wizzQuickActions.init", selfRef);
            showHint = await JS.InvokeAsync<bool>("wizzQuickActions.shouldShowHint");
            StateHasChanged();
        }
        catch
        {
            // غياب JS لا يمنع عمل الصفحة — تبقى الروابط قابلة للنقر.
        }
    }

    /// <summary>ينفّذ اختصار Alt+الرقم القادم من المتصفح.</summary>
    [JSInvokable]
    public void NavigateByShortcut(string key)
    {
        foreach (var action in QuickActions)
        {
            if (action.Key != key) continue;
            Nav.NavigateTo(action.Href);
            return;
        }
    }

    private async Task DismissHintAsync()
    {
        showHint = false;
        try { await JS.InvokeVoidAsync("wizzQuickActions.dismissHint"); }
        catch { /* التذكير يبقى مخفياً في هذه الجلسة فقط. */ }
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("wizzQuickActions.dispose"); }
        catch { /* الصفحة تُغادر — لا حاجة لمعالجة الخطأ. */ }
        selfRef?.Dispose();
    }
}
