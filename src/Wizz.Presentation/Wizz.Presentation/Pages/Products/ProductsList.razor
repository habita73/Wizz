@page "/products"
@layout MainLayout
@inject Wizz.Application.Abstractions.IProductRepository ProductRepo
@inject Wizz.Application.Abstractions.IStoreRepository StoreRepo
@inject Wizz.Application.Abstractions.IUserRepository UserRepo
@inject Wizz.Application.Abstractions.IUnitOfWork UnitOfWork
@inject Wizz.Application.UseCases.Products.CreateProductUseCase CreateProductUseCase
@inject Wizz.Application.UseCases.Products.UpdateProductUseCase UpdateProductUseCase
@inject Wizz.Application.UseCases.Products.AdjustStockUseCase AdjustStockUseCase
@inject IJSRuntime JS
<h2 class="d-flex align-items-center gap-2">
    <WizzIcon Icon="package" Size="24" />
    <span>إدارة المنتجات</span>
</h2>

@if (!inventoryEnabled)
{
    <div class="alert alert-info d-flex align-items-start gap-2">
        <WizzIcon Icon="info" Size="18" />
        <div class="flex-grow-1">
            تتبع المخزون معطّل، لذلك لا يُخصم الرصيد تلقائياً عند البيع ولا تظهر تنبيهات النقص.
            يمكنك تفعيله من إعدادات المتجر.
        </div>
        <a href="/settings" class="btn btn-sm btn-outline-primary flex-shrink-0">الإعدادات</a>
    </div>
}

<div class="row mb-3">
    <div class="col-md-5">
        <div class="input-group">
            <input type="text" class="form-control" placeholder="بحث بالاسم أو الباركود..." @bind="searchQuery" @bind:event="oninput" @bind:after="SearchProducts" @onkeydown="OnSearchKeyDown" />
            @if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                <button class="btn btn-outline-secondary" @onclick="ClearSearch" title="مسح البحث">
                    <WizzIcon Icon="x" Size="16" Title="مسح البحث" />
                </button>
            }
            <button class="btn btn-outline-secondary" @onclick="SearchProducts">
                <WizzIcon Icon="search" Size="16" />
                <span>بحث</span>
            </button>
        </div>
    </div>
    <div class="col-md-2">
        <select class="form-select" @bind="filterActiveString" @bind:after="OnFilterActiveChanged">
            <option value="">الكل</option>
            <option value="true">نشط فقط</option>
            <option value="false">غير نشط فقط</option>
        </select>
    </div>
    <div class="col-md-2">
        <button class="btn w-100 @(lowStockOnly ? "btn-warning" : "btn-outline-warning")" @onclick="ToggleLowStockFilter"
                title="عرض المنتجات التي بلغت حد إعادة الطلب">
            <WizzIcon Icon="alert" Size="16" />
            <span>مخزون منخفض</span>
        </button>
    </div>
    <div class="col-md-3 text-end">
        <button class="btn btn-success" @onclick="NewProduct">
            <WizzIcon Icon="plus" Size="16" />
            <span>منتج جديد</span>
        </button>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
    <span class="small text-muted">@filteredCount منتج — صفحة @currentPage من @totalPages</span>
</div>

@if (products.Count == 0)
{
    <div class="alert alert-info">
        @(allProducts.Count == 0
            ? "لا توجد منتجات. أضف منتجاً جديداً للبدء."
            : "لا توجد منتجات مطابقة للبحث أو الفلتر الحالي.")
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>الاسم</th>
                    <th>الباركود</th>
                    <th>النوع</th>
                    <th>المخزون</th>
                    <th>حد التنبيه</th>
                    <th>سعر التجزئة</th>
                    <th>سعر الجملة</th>
                    <th>الوحدة الأساسية</th>
                    <th>الحالة</th>
                    <th>إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in products)
                {
                    <tr class="@(product.IsLowStock ? "table-warning" : "")">
                        <td>@product.Name</td>
                        <td>@(product.Barcode ?? "—")</td>
                        <td>@(product.IsService ? "خدمة" : "منتج")</td>
                        <td>
                            @if (product.IsService)
                            {
                                <span class="text-muted">—</span>
                            }
                            else
                            {
                                <span class="fw-semibold @(product.StockQuantity < 0 ? "text-danger" : "")">@product.StockQuantity.ToString("N2")</span>
                                @if (product.StockQuantity < 0)
                                {
                                    <span class="badge bg-danger ms-1" title="رصيد سالب — بِيع أكثر من المتوفر">
                                        <WizzIcon Icon="alert" Size="12" />
                                        <span>سالب</span>
                                    </span>
                                }
                                else if (product.IsOutOfStock)
                                {
                                    <span class="badge bg-danger ms-1">نفد</span>
                                }
                                else if (product.IsLowStock)
                                {
                                    <span class="badge bg-warning text-dark ms-1" title="بلغ حد إعادة الطلب">
                                        <WizzIcon Icon="alert" Size="12" />
                                        <span>منخفض</span>
                                    </span>
                                }
                            }
                        </td>
                        <td>@(product.IsService ? "—" : product.ReorderLevel.ToString("N2"))</td>
                        <td>@product.RetailPrice.ToString("N2") د.ج</td>
                        <td>@product.WholesalePrice.ToString("N2") د.ج</td>
                        <td>@(product.BaseUnit?.Symbol ?? "—")</td>
                        <td>
                            <span class="badge @(product.IsActive ? "bg-success" : "bg-secondary")">
                                @(product.IsActive ? "نشط" : "غير نشط")
                            </span>
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-primary" @onclick="() => EditProduct(product)" title="تعديل">
                                    <WizzIcon Icon="edit" Size="16" Title="تعديل" />
                                </button>
                                @if (!product.IsService)
                                {
                                    <button class="btn btn-outline-secondary" @onclick="() => OpenAdjust(product)" title="جرد المخزون">
                                        <WizzIcon Icon="list" Size="16" Title="جرد المخزون" />
                                    </button>
                                    <a class="btn btn-outline-secondary" href="/stock-movements?productId=@product.Id" title="سجل حركات المخزون">
                                        <WizzIcon Icon="clock" Size="16" Title="سجل حركات المخزون" />
                                    </a>
                                }
                                <button class="btn btn-outline-danger" @onclick="() => ToggleActive(product)" title="@(product.IsActive ? "تعطيل" : "تفعيل")">
                                    <WizzIcon Icon="@(product.IsActive ? "ban" : "check-circle")" Size="16" Title="@(product.IsActive ? "تعطيل" : "تفعيل")" />
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav aria-label="صفحات">
        <ul class="pagination justify-content-center">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <button type="button" class="page-link" disabled="@(currentPage == 1)" @onclick="() => ChangePage(currentPage - 1)">السابق</button>
            </li>
            <li class="page-item disabled"><span class="page-link">صفحة @currentPage من @totalPages</span></li>
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <button type="button" class="page-link" disabled="@(currentPage == totalPages)" @onclick="() => ChangePage(currentPage + 1)">التالي</button>
            </li>
        </ul>
    </nav>
}

<!-- Create/Edit Modal -->
@if (showCreateModal || editingProduct != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(editingProduct != null ? "تعديل المنتج" : "منتج جديد")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <form id="productForm" @onsubmit="SaveProduct" @onsubmit:preventDefault>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">الاسم <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" @bind="form.Name" @bind:event="oninput" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">الباركود</label>
                                <input type="text" class="form-control" @bind="form.Barcode" @bind:event="oninput" />
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label class="form-label">الوصف</label>
                                <textarea class="form-control" rows="2" @bind="form.Description"></textarea>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label">سعر التجزئة <span class="text-danger">*</span></label>
                                <input type="number" step="0.01" min="0" class="form-control" @bind="form.RetailPrice" @bind:event="oninput" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">سعر الجملة <span class="text-danger">*</span></label>
                                <input type="number" step="0.01" min="0" class="form-control" @bind="form.WholesalePrice" @bind:event="oninput" required />
                            </div>
                            <div class="col-md-4">
                                <div class="form-check mt-4">
                                    <input type="checkbox" class="form-check-input" @bind="form.IsService" id="isService" />
                                    <label class="form-check-label" for="isService">خدمة (لا مخزون)</label>
                                </div>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-4">
                                @if (editingProduct != null)
                                {
                                    <label class="form-label">الرصيد الحالي</label>
                                    <input type="text" class="form-control" value="@editingProduct.StockQuantity.ToString("N2")" readonly />
                                    <div class="form-text">يتغيّر تلقائياً بالبيع والإلغاء. للتعديل استخدم «جرد».</div>
                                }
                                else
                                {
                                    <label class="form-label">الكمية الافتتاحية</label>
                                    <input type="number" step="0.01" min="0" class="form-control" @bind="form.StockQuantity" @bind:event="oninput" disabled="@form.IsService" />
                                    <div class="form-text">تُسجَّل كرصيد افتتاحي في سجل حركات المخزون.</div>
                                }
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">حد التنبيه (إعادة الطلب)</label>
                                <input type="number" step="0.01" min="0" class="form-control" @bind="form.ReorderLevel" @bind:event="oninput" disabled="@form.IsService" />
                                <div class="form-text">ينبّهك النظام عندما يصبح الرصيد أقل من أو يساوي هذا الحد.</div>
                            </div>
                            <div class="col-md-4 d-flex align-items-end">
                                @if (editingProduct != null && !editingProduct.IsService)
                                {
                                    <button type="button" class="btn btn-outline-primary mb-4" @onclick="OpenAdjustFromEdit">
                                        <WizzIcon Icon="list" Size="14" />
                                        <span>جرد المخزون</span>
                                    </button>
                                }
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label class="form-label">الوحدات</label>
                                @foreach (var unit in form.Units)
                                {
                                    <div class="input-group mb-2">
                                        <input type="text" class="form-control" placeholder="اسم الوحدة (مثال: كجم)" @bind="unit.Name" @bind:event="oninput" />
                                        <input type="text" class="form-control" placeholder="الرمز (مثال: كجم)" @bind="unit.Symbol" @bind:event="oninput" style="width: 80px;" />
                                        <input type="number" step="0.001" min="0.001" class="form-control" placeholder="الكمية الأساسية" @bind="unit.BaseQuantity" @bind:event="oninput" style="width: 100px;" />
                                        <button class="btn btn-outline-danger" type="button" @onclick="() => form.Units.Remove(unit)">
                                            <WizzIcon Icon="x" Size="14" Title="حذف الوحدة" />
                                        </button>
                                    </div>
                                }
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="AddUnit">
                                    <WizzIcon Icon="plus" Size="14" />
                                    <span>إضافة وحدة</span>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">إلغاء</button>
                    <button type="submit" form="productForm" class="btn btn-primary" disabled="@saving">
                        @if (saving) { <span class="spinner-border spinner-border-sm me-2"></span> }
                        @(editingProduct != null ? "حفظ التغييرات" : "إنشاء المنتج")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (adjustingProduct != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">جرد المخزون — @adjustingProduct.Name</h5>
                    <button type="button" class="btn-close" @onclick="CloseAdjust"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted mb-3">
                        الرصيد الحالي:
                        <strong>@adjustingProduct.StockQuantity.ToString("N2") @(adjustingProduct.BaseUnit?.Symbol ?? "")</strong>
                    </p>
                    <div class="mb-3">
                        <label class="form-label">الرصيد بعد الجرد <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" min="0" class="form-control" @bind="adjustQuantity" />
                        <div class="form-text">أدخل العدد الفعلي الموجود في المتجر. لا يمكن أن يكون سالباً.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">سبب التعديل <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" placeholder="مثال: جرد دوري، تلف، تصحيح إدخال" @bind="adjustReason" />
                    </div>
                    <div class="alert alert-info small mb-0">
                        يُسجَّل الفرق كحركة مخزون مع السبب والمستخدم والوقت، ويظهر في سجل الحركات.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseAdjust">إلغاء</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveAdjust" disabled="@savingAdjust">
                        @if (savingAdjust) { <span class="spinner-border spinner-border-sm me-2"></span> }
                        حفظ الجرد
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Wizz.Application.DTOs.ProductDto> allProducts = new();
    private List<Wizz.Application.DTOs.ProductDto> products = new();
    private string searchQuery = "";
    private bool? filterActive = null;
    private string filterActiveString = "";
    private bool lowStockOnly = false;
    private int currentPage = 1;
    private int pageSize = 20;
    private int totalPages = 1;
    private int filteredCount;

    /// <summary>فلتر قادم من الرابط، مثل /products?lowStock=true من بطاقة لوحة التحكم.</summary>
    [SupplyParameterFromQuery(Name = "lowStock")]
    public bool? LowStockQuery { get; set; }

    private bool showCreateModal = false;
    private Wizz.Application.DTOs.ProductDto? editingProduct = null;
    private ProductForm form = new();
    private bool saving = false;

    private bool inventoryEnabled = true;
    private Guid? currentUserId;
    private Wizz.Application.DTOs.ProductDto? adjustingProduct;
    private decimal adjustQuantity;
    private string adjustReason = "";
    private bool savingAdjust;

    protected override async Task OnInitializedAsync()
    {
        lowStockOnly = LowStockQuery == true;

        var store = await StoreRepo.GetAsync();
        inventoryEnabled = store?.InventoryEnabled == true;

        var users = await UserRepo.GetAllAsync();
        currentUserId = users.FirstOrDefault(u => u.IsActive && u.Role == UserRole.Admin)?.Id
                        ?? users.FirstOrDefault(u => u.IsActive)?.Id;

        await LoadProducts();
    }

    /// <summary>تحميل كامل الكتالوج مرة واحدة ثم فلترة وترقيم محلياً — لا تختفي القائمة بين الصفحات.</summary>
    private async Task LoadProducts()
    {
        var items = await ProductRepo.GetAllAsync();
        allProducts = items.Select(p => new Wizz.Application.DTOs.ProductDto(
            p.Id, p.Name, p.Barcode, p.Description, p.RetailPrice, p.WholesalePrice,
            p.IsService, p.IsActive,
            p.Units.Select(u => new Wizz.Application.DTOs.UnitOfMeasureDto(u.Id, u.Name, u.Symbol, u.BaseQuantity, u.IsBaseUnit)).ToList(),
            p.GetBaseUnit() is { } bu ? new Wizz.Application.DTOs.UnitOfMeasureDto(bu.Id, bu.Name, bu.Symbol, bu.BaseQuantity, true) : null,
            p.StockQuantity, p.ReorderLevel
        )).OrderBy(p => p.Name).ToList();

        ApplyFilters();
    }

    private void ApplyFilters()
    {
        var query = searchQuery?.Trim() ?? "";
        var filtered = allProducts.AsEnumerable();

        if (query.Length > 0)
        {
            filtered = filtered.Where(p =>
                p.Name.Contains(query, StringComparison.OrdinalIgnoreCase)
                || (p.Barcode?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        if (filterActive.HasValue)
        {
            filtered = filtered.Where(p => p.IsActive == filterActive.Value);
        }

        if (lowStockOnly)
        {
            filtered = filtered.Where(p => p.IsLowStock);
        }

        var list = filtered.ToList();
        totalPages = Math.Max(1, (int)Math.Ceiling((double)list.Count / pageSize));
        if (currentPage > totalPages) currentPage = totalPages;
        if (currentPage < 1) currentPage = 1;

        products = list.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
        filteredCount = list.Count;
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            currentPage = 1;
            ApplyFilters();
            await Task.CompletedTask;
        }
    }

    private void OnFilterActiveChanged()
    {
        filterActive = string.IsNullOrEmpty(filterActiveString) ? null : bool.Parse(filterActiveString);
        currentPage = 1;
        ApplyFilters();
    }

    private Task SearchProducts()
    {
        currentPage = 1;
        ApplyFilters();
        return Task.CompletedTask;
    }

    private void ClearSearch()
    {
        searchQuery = "";
        currentPage = 1;
        ApplyFilters();
    }

    private void ToggleLowStockFilter()
    {
        lowStockOnly = !lowStockOnly;
        currentPage = 1;
        ApplyFilters();
    }

    private async Task ChangePage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            ApplyFilters();
            await Task.CompletedTask;
        }
    }

    private void NewProduct()
    {
        editingProduct = null;
        form = new ProductForm();
        form.Units.Add(new UnitForm { Name = "قطعة", Symbol = "قطعة", BaseQuantity = 1 });
        showCreateModal = true;
    }

    private void EditProduct(Wizz.Application.DTOs.ProductDto product)
    {
        editingProduct = product;
        form = new ProductForm
        {
            Name = product.Name,
            Barcode = product.Barcode,
            Description = product.Description,
            RetailPrice = product.RetailPrice,
            WholesalePrice = product.WholesalePrice,
            IsService = product.IsService,
            StockQuantity = product.StockQuantity,
            ReorderLevel = product.ReorderLevel,
            Units = product.Units.Select(u => new UnitForm { Name = u.Name, Symbol = u.Symbol, BaseQuantity = u.BaseQuantity }).ToList()
        };
        if (form.Units.Count == 0) form.Units.Add(new UnitForm { Name = "قطعة", Symbol = "قطعة", BaseQuantity = 1 });
        showCreateModal = true;
    }

    private async Task SaveProduct()
    {
        saving = true;
        try
        {
            var input = new Wizz.Application.DTOs.ProductInputDto(
                form.Name, form.RetailPrice, form.WholesalePrice,
                form.IsService, form.Barcode, form.Description,
                form.Units.Select(u => new Wizz.Application.DTOs.UnitInputDto(u.Name, u.Symbol, u.BaseQuantity)).ToList(),
                form.StockQuantity, form.ReorderLevel
            );

            if (editingProduct != null)
            {
                var result = await UpdateProductUseCase.ExecuteAsync(editingProduct.Id, input);
                if (result.IsSuccess) await JS.InvokeVoidAsync("alert", "تم تحديث المنتج بنجاح");
                else await JS.InvokeVoidAsync("alert", $"خطأ: {string.Join(", ", result.Errors)}");
            }
            else
            {
                var result = await CreateProductUseCase.ExecuteAsync(input);
                if (result.IsSuccess) await JS.InvokeVoidAsync("alert", "تم إنشاء المنتج بنجاح");
                else await JS.InvokeVoidAsync("alert", $"خطأ: {string.Join(", ", result.Errors)}");
            }

            CloseModal();
            currentPage = 1;
            await LoadProducts();
        }
        finally
        {
            saving = false;
        }
    }

    private async Task ToggleActive(Wizz.Application.DTOs.ProductDto product)
    {
        var action = product.IsActive ? "تعطيل" : "تفعيل";
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"هل تريد {action} المنتج '{product.Name}'؟");
        if (!confirmed)
        {
            return;
        }

        var entity = await ProductRepo.GetByIdAsync(product.Id);
        if (entity == null)
        {
            await JS.InvokeVoidAsync("alert", "تعذر العثور على المنتج");
            return;
        }

        if (entity.IsActive)
        {
            entity.Deactivate();
        }
        else
        {
            entity.Activate();
        }

        ProductRepo.Update(entity);
        await UnitOfWork.SaveChangesAsync();
        await LoadProducts();
    }

    private void CloseModal()
    {
        showCreateModal = false;
        editingProduct = null;
        form = new ProductForm();
    }

    private void AddUnit()
    {
        form.Units.Add(new UnitForm { Name = "", Symbol = "", BaseQuantity = 1 });
    }

    private void OpenAdjust(Wizz.Application.DTOs.ProductDto product)
    {
        adjustingProduct = product;
        adjustQuantity = product.StockQuantity < 0 ? 0m : product.StockQuantity;
        adjustReason = "";
    }

    private void OpenAdjustFromEdit()
    {
        if (editingProduct == null) return;

        var product = editingProduct;
        showCreateModal = false;
        editingProduct = null;
        OpenAdjust(product);
    }

    private async Task SaveAdjust()
    {
        if (adjustingProduct == null) return;

        if (string.IsNullOrWhiteSpace(adjustReason))
        {
            await JS.InvokeVoidAsync("alert", "سبب التعديل مطلوب");
            return;
        }

        savingAdjust = true;
        try
        {
            var result = await AdjustStockUseCase.ExecuteAsync(
                adjustingProduct.Id, adjustQuantity, adjustReason.Trim(), currentUserId);

            if (!result.IsSuccess)
            {
                await JS.InvokeVoidAsync("alert", $"خطأ: {string.Join(", ", result.Errors)}");
                return;
            }

            CloseAdjust();
            await LoadProducts();
            await JS.InvokeVoidAsync("alert", "تم تحديث المخزون وتسجيل الحركة");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"خطأ غير متوقع: {ex.Message}");
        }
        finally
        {
            savingAdjust = false;
        }
    }

    private void CloseAdjust()
    {
        adjustingProduct = null;
        adjustReason = "";
        adjustQuantity = 0m;
    }

    private class ProductForm
    {
        public string Name { get; set; } = "";
        public string? Barcode { get; set; }
        public string? Description { get; set; }
        public decimal RetailPrice { get; set; }
        public decimal WholesalePrice { get; set; }
        public bool IsService { get; set; }
        public decimal StockQuantity { get; set; }
        public decimal ReorderLevel { get; set; }
        public List<UnitForm> Units { get; set; } = new();
    }

    private class UnitForm
    {
        public string Name { get; set; } = "";
        public string Symbol { get; set; } = "";
        public decimal BaseQuantity { get; set; } = 1;
    }
}