@page "/stock-movements"
@layout MainLayout
@inject Wizz.Application.Abstractions.IStockMovementRepository StockRepo
@inject Wizz.Application.Abstractions.IProductRepository ProductRepo
@inject Wizz.Application.Abstractions.IUserRepository UserRepo
@inject Microsoft.AspNetCore.Components.NavigationManager Nav

<h2 class="d-flex align-items-center gap-2">
    <WizzIcon Icon="clock" Size="24" />
    <span>سجل حركات المخزون</span>
</h2>
<p class="text-muted small">
    كل تغيير في رصيد المخزون يُسجَّل هنا: بيع، إلغاء بيع، تصحيح، تعديل يدوي، أو رصيد افتتاحي — مع السبب والمستخدم والوقت.
</p>

<div class="row mb-3">
    <div class="col-md-5">
        <label class="form-label">المنتج</label>
        <select class="form-select" @bind="selectedProductId" @bind:after="OnFilterChanged">
            <option value="">كل المنتجات</option>
            @foreach (var product in products)
            {
                <option value="@product.Id">@product.Name</option>
            }
        </select>
    </div>
    <div class="col-md-3 d-flex align-items-end">
        <button class="btn btn-outline-secondary" @onclick="Reload">
            <WizzIcon Icon="refresh" Size="16" />
            <span>تحديث</span>
        </button>
    </div>
    <div class="col-md-4 d-flex align-items-end justify-content-md-end">
        <a href="/products" class="btn btn-outline-primary">العودة إلى المنتجات</a>
    </div>
</div>

@if (loading)
{
    <div class="text-center text-muted py-4">
        <span class="spinner-border spinner-border-sm me-2"></span>
        جارٍ تحميل الحركات…
    </div>
}
else if (filtered.Count == 0)
{
    <div class="alert alert-info">
        @(selectedProductId is null
            ? "لا توجد حركات مخزون مسجلة بعد."
            : "لا توجد حركات لهذا المنتج بعد.")
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-2">
        <span class="small text-muted">@filtered.Count حركة — صفحة @currentPage من @totalPages</span>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>التاريخ</th>
                    <th>المنتج</th>
                    <th>النوع</th>
                    <th class="text-center">التغيير</th>
                    <th class="text-center">قبل</th>
                    <th class="text-center">بعد</th>
                    <th>السبب</th>
                    <th>المستخدم</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var movement in PageItems)
                {
                    <tr>
                        <td class="small text-nowrap">@movement.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <a href="/stock-movements?productId=@movement.ProductId">@movement.ProductName</a>
                        </td>
                        <td>
                            <span class="badge @TypeBadge(movement.Type)">@movement.TypeText</span>
                        </td>
                        <td class="text-center fw-bold @(movement.QuantityDelta < 0 ? "text-danger" : "text-success")">
                            @(movement.QuantityDelta > 0 ? "+" : "")@movement.QuantityDelta.ToString("N2")
                            <span class="small text-muted">@movement.BaseUnitSymbol</span>
                        </td>
                        <td class="text-center">@movement.QuantityBefore.ToString("N2")</td>
                        <td class="text-center @(movement.QuantityAfter < 0 ? "text-danger fw-semibold" : "")">@movement.QuantityAfter.ToString("N2")</td>
                        <td class="small">@(movement.Reason ?? "—")</td>
                        <td class="small">@GetUserName(movement.CreatedByUserId)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav aria-label="صفحات سجل المخزون">
        <ul class="pagination justify-content-center">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <button type="button" class="page-link" disabled="@(currentPage == 1)" @onclick="() => ChangePage(currentPage - 1)">السابق</button>
            </li>
            <li class="page-item disabled"><span class="page-link">صفحة @currentPage من @totalPages</span></li>
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <button type="button" class="page-link" disabled="@(currentPage == totalPages)" @onclick="() => ChangePage(currentPage + 1)">التالي</button>
            </li>
        </ul>
    </nav>
}

@code {
    private List<Wizz.Application.DTOs.ProductDto> products = new();
    private List<Wizz.Application.DTOs.StockMovementDto> movements = new();
    private List<Wizz.Application.DTOs.StockMovementDto> filtered = new();
    private Dictionary<Guid, string> userNames = new();
    private string? selectedProductId;
    private bool loading = true;
    private int currentPage = 1;
    private int pageSize = 30;
    private int totalPages = 1;

    [SupplyParameterFromQuery(Name = "productId")]
    public Guid? ProductIdQuery { get; set; }

    private IEnumerable<Wizz.Application.DTOs.StockMovementDto> PageItems =>
        filtered.Skip((currentPage - 1) * pageSize).Take(pageSize);

    protected override async Task OnInitializedAsync()
    {
        selectedProductId = ProductIdQuery?.ToString();

        var allProducts = await ProductRepo.GetAllAsync();
        products = allProducts
            .Select(Wizz.Application.DTOs.ProductDto.FromDomain)
            .OrderBy(p => p.Name)
            .ToList();

        var users = await UserRepo.GetAllAsync();
        userNames = users.ToDictionary(u => u.Id, u => u.FullName);

        await LoadMovements();
    }

    private async Task LoadMovements()
    {
        loading = true;
        try
        {
            var items = await StockRepo.GetRecentAsync(500);
            movements = items.Select(Wizz.Application.DTOs.StockMovementDto.FromDomain).ToList();
            ApplyFilter();
        }
        finally
        {
            loading = false;
        }
    }

    private void ApplyFilter()
    {
        filtered = selectedProductId is not null && Guid.TryParse(selectedProductId, out var id)
            ? movements.Where(m => m.ProductId == id).ToList()
            : movements.ToList();

        totalPages = Math.Max(1, (int)Math.Ceiling((double)filtered.Count / pageSize));
        if (currentPage > totalPages) currentPage = totalPages;
        if (currentPage < 1) currentPage = 1;
    }

    private void OnFilterChanged()
    {
        currentPage = 1;
        ApplyFilter();

        var url = selectedProductId is null
            ? "/stock-movements"
            : $"/stock-movements?productId={selectedProductId}";
        Nav.NavigateTo(url, replace: true);
    }

    private async Task Reload()
    {
        currentPage = 1;
        await LoadMovements();
    }

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
        }
    }

    private string GetUserName(Guid? userId) =>
        userId is null ? "—" : (userNames.TryGetValue(userId.Value, out var name) ? name : "—");

    private static string TypeBadge(Wizz.Domain.StockMovementType type) => type switch
    {
        Wizz.Domain.StockMovementType.OpeningBalance => "bg-secondary",
        Wizz.Domain.StockMovementType.Sale => "bg-primary",
        Wizz.Domain.StockMovementType.SaleCancellation => "bg-success",
        Wizz.Domain.StockMovementType.SaleCorrection => "bg-warning text-dark",
        Wizz.Domain.StockMovementType.ManualAdjustment => "bg-info text-dark",
        _ => "bg-secondary"
    };
}
