@page "/reports"
@layout MainLayout
@attribute [Authorize(Policy = PermissionPolicy.ViewReports)]
@rendermode InteractiveServer
@inject Wizz.Application.Abstractions.ISaleRepository SaleRepo
@inject Wizz.Application.Abstractions.IProductRepository ProductRepo
@inject Wizz.Application.UseCases.Sales.GetCashReportUseCase GetCashReport
@inject Wizz.Application.UseCases.StockDocuments.GetPurchaseReportUseCase GetPurchaseReport
@inject Services.CurrentUser CurrentUser
@inject Wizz.Application.Reports.ReportExportService Exporter
@inject GetStoreSettingsUseCase GetStoreSettings
@inject IJSRuntime JS
@using System.Globalization

<h2 class="d-flex align-items-center gap-2">
    <WizzIcon Icon="chart" Size="24" />
    <span>التقارير ولوحة التحكم</span>
</h2>

<div class="row mb-4">
    <div class="col-md-3">
        <input type="date" class="form-control" @bind="fromDate" @bind:after="GenerateReport" />
    </div>
    <div class="col-md-3">
        <input type="date" class="form-control" @bind="toDate" @bind:after="GenerateReport" />
    </div>
    <div class="col-md-3">
        <select class="form-select" @bind="reportType" @bind:after="GenerateReport">
            <option value="summary">ملخص المبيعات</option>
            <option value="daily">المبيعات اليومية</option>
            <option value="products">أفضل المنتجات</option>
            <option value="payment">طرق الدفع</option>
            <option value="cash">الصندوق</option>
            <option value="purchases">المشتريات</option>
        </select>
    </div>
    <div class="col-md-3">
        <button class="btn btn-primary w-100" @onclick="GenerateReport">
            <WizzIcon Icon="refresh" Size="16" />
            <span>تحديث</span>
        </button>
    </div>
</div>

<div class="row mb-4 no-print g-2">
    <div class="col-auto">
        <button class="btn btn-outline-primary" @onclick="ExportCsv" disabled="@(!HasData)">
            <WizzIcon Icon="save" Size="16" />
            <span>تصدير CSV</span>
        </button>
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-secondary" @onclick="PrintReport" disabled="@(!HasData)">
            <WizzIcon Icon="printer" Size="16" />
            <span>طباعة / حفظ PDF</span>
        </button>
    </div>
</div>

<!-- Summary Cards — تخص تقارير المبيعات فقط -->
@if (reportType is not ("cash" or "purchases"))
{
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <h6 class="card-title">إجمالي المبيعات</h6>
                <h3 class="mb-0">@TotalSales.ToString("N0") د.ج</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white">
            <div class="card-body">
                <h6 class="card-title">إجمالي المدفوع</h6>
                <h3 class="mb-0">@TotalPaid.ToString("N0") د.ج</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-dark">
            <div class="card-body">
                <h6 class="card-title">المتبقي (ديون)</h6>
                <h3 class="mb-0">@TotalRemaining.ToString("N0") د.ج</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white">
            <div class="card-body">
                <h6 class="card-title">عدد العمليات</h6>
                <h3 class="mb-0">@SalesCount</h3>
            </div>
        </div>
    </div>
</div>
}

<!-- Report Content -->
<div class="card">
    <div class="card-header">
        <h5 class="mb-0">@ReportTitle</h5>
    </div>
    <div class="card-body">
        @switch (reportType)
        {
            case "summary":
                <div class="row">
                    <div class="col-md-6">
                        <h6>إحصائيات الفترة</h6>
                        <table class="table table-sm">
                            <tr><td>إجمالي المبيعات</td><td class="text-end fw-bold">@TotalSales.ToString("N2") د.ج</td></tr>
                            <tr><td>إجمالي الخصم</td><td class="text-end">@TotalDiscount.ToString("N2") د.ج</td></tr>
                            <tr><td>الإجمالي قبل الخصم</td><td class="text-end">@((TotalSales + TotalDiscount).ToString("N2")) د.ج</td></tr>
                            <tr><td>المدفوع</td><td class="text-end text-success">@TotalPaid.ToString("N2") د.ج</td></tr>
                            <tr><td>المتبقي</td><td class="text-end @(TotalRemaining > 0 ? "text-danger" : "")">@TotalRemaining.ToString("N2") د.ج</td></tr>
                            <tr><td>عدد العمليات</td><td class="text-end">@SalesCount</td></tr>
                            <tr><td>متوسط البيع</td><td class="text-end">@(SalesCount > 0 ? (TotalSales / SalesCount).ToString("N2") : "0") د.ج</td></tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <h6>طرق الدفع</h6>
                        <table class="table table-sm">
                            <thead><tr><th>الطريقة</th><th class="text-end">العدد</th><th class="text-end">المبلغ</th></tr></thead>
                            <tbody>
                                @foreach (var p in paymentBreakdown)
                                {
                                    <tr>
                                        <td>@GetPaymentMethodText(p.Method)</td>
                                        <td class="text-end">@p.Count</td>
                                        <td class="text-end">@p.Amount.ToString("N2") د.ج</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                break;

            case "daily":
                <div class="table-responsive">
                    <table class="table table-sm table-striped">
                        <thead class="table-dark"><tr><th>التاريخ</th><th class="text-end">المبيعات</th><th class="text-end">المدفوع</th><th class="text-end">المتبقي</th><th class="text-end">العمليات</th></tr></thead>
                        <tbody>
                            @foreach (var d in dailySales)
                            {
                                <tr>
                                    <td>@d.Date.ToString("yyyy-MM-dd")</td>
                                    <td class="text-end">@d.Total.ToString("N2") د.ج</td>
                                    <td class="text-end">@d.Paid.ToString("N2") د.ج</td>
                                    <td class="text-end @(d.Remaining > 0 ? "text-danger" : "")">@d.Remaining.ToString("N2") د.ج</td>
                                    <td class="text-end">@d.Count</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                break;

            case "products":
                <div class="table-responsive">
                    <table class="table table-sm table-striped">
                        <thead class="table-dark"><tr><th>المنتج</th><th class="text-end">الكمية المباعة</th><th class="text-end">إجمالي المبيعات</th><th class="text-end">متوسط السعر</th></tr></thead>
                        <tbody>
                            @foreach (var p in topProducts)
                            {
                                <tr>
                                    <td>@p.Name</td>
                                    <td class="text-end">@p.QuantitySold.ToString("N2")</td>
                                    <td class="text-end">@p.TotalSales.ToString("N2") د.ج</td>
                                    <td class="text-end">@(p.QuantitySold > 0 ? (p.TotalSales / p.QuantitySold).ToString("N2") : "0") د.ج</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                break;

            case "payment":
                <div class="table-responsive">
                    <table class="table table-sm table-striped">
                        <thead class="table-dark"><tr><th>طريقة الدفع</th><th class="text-end">العدد</th><th class="text-end">المبلغ</th><th class="text-end">النسبة</th></tr></thead>
                        <tbody>
                            @foreach (var p in paymentBreakdown)
                            {
                                <tr>
                                    <td>@GetPaymentMethodText(p.Method)</td>
                                    <td class="text-end">@p.Count</td>
                                    <td class="text-end">@p.Amount.ToString("N2") د.ج</td>
                                    <td class="text-end">@(TotalSales > 0 ? (p.Amount / TotalSales * 100).ToString("N1") : "0")%</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                break;

            case "cash":
                @if (!string.IsNullOrWhiteSpace(cashError))
                {
                    <div class="alert alert-danger">@cashError</div>
                }
                else
                {
                    <div class="alert alert-light border mb-3">
                        ورديات مفتوحة: <strong>@cashReport.OpenShiftCount</strong> ·
                        مغلقة: <strong>@cashReport.ClosedShiftCount</strong> ·
                        بيانات سابقة بلا عدّ: <strong>@cashReport.LegacyShiftCount</strong>.
                        الورديات المفتوحة موسومة «مباشر» لأن أرقامها حساب حي؛ والمغلقة تعرض اللقطة المجمّدة كما هي.
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-striped">
                            <thead class="table-dark">
                                <tr>
                                    <th>الفتح</th><th>الإغلاق</th><th>الكاشير</th>
                                    <th class="text-end">الفكة</th><th class="text-end">مبيعات نقدية</th>
                                    <th class="text-end">إيداعات</th><th class="text-end">سحوبات</th>
                                    <th class="text-end">المتوقع</th><th class="text-end">المعدود</th>
                                    <th class="text-end">الفرق</th><th>الحالة</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in cashReport.Rows)
                                {
                                    <tr>
                                        <td class="text-nowrap">@row.OpenedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                        <td class="text-nowrap">@(row.ClosedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                        <td>@row.CashierName</td>
                                        <td class="text-end">@row.OpeningFloat.ToString("N2")</td>
                                        <td class="text-end">@row.CashSalesTotal.ToString("N2")</td>
                                        <td class="text-end">@row.DepositsTotal.ToString("N2")</td>
                                        <td class="text-end">@row.WithdrawalsTotal.ToString("N2")</td>
                                        <td class="text-end fw-bold">@row.ExpectedCash.ToString("N2")</td>
                                        <td class="text-end">@(row.CountedCash?.ToString("N2") ?? "—")</td>
                                        <td class="text-end @(row.CashDifference > 0 ? "text-success" : row.CashDifference < 0 ? "text-danger" : "")">
                                            @(row.CashDifference?.ToString("N2") ?? "—")
                                        </td>
                                        <td><span class="badge @(row.IsOpen ? "bg-success" : row.HasCashCount ? "bg-secondary" : "bg-dark")">@row.StatusLabel</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        @if (cashReport.Rows.Count == 0)
                        {
                            <div class="text-muted small">لا توجد ورديات في الفترة المحددة.</div>
                        }
                    </div>
                    @if (cashReport.Rows.Any(r => !string.IsNullOrWhiteSpace(r.CloseNote)))
                    {
                        <h6 class="mt-3">ملاحظات الإغلاق</h6>
                        <ul>
                            @foreach (var row in cashReport.Rows.Where(r => !string.IsNullOrWhiteSpace(r.CloseNote)))
                            {
                                <li>@row.OpenedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm") — @row.CloseNote</li>
                            }
                        </ul>
                    }
                }
                break;

            case "purchases":
                @if (!string.IsNullOrWhiteSpace(purchaseError))
                {
                    <div class="alert alert-danger">@purchaseError</div>
                }
                else
                {
                    <div class="alert alert-light border mb-3">
                        مستندات نشطة: <strong>@purchaseReport.DocumentCount</strong> ·
                        ملغاة: <strong>@purchaseReport.VoidedDocumentCount</strong>.
                        @if (canViewCosts)
                        {
                            <span>إجمالي الشراء: <strong>@purchaseReport.TotalPurchase.ToString("N2") د.ج</strong>.</span>
                        }
                        else
                        {
                            <span>إجمالي الشراء مخفي لعدم صلاحية عرض التكلفة.</span>
                        }
                        الرقم ليس ربحًا ولا تكلفة مبيعات.
                    </div>
                    @if (canViewCosts)
                    {
                        <div class="row">
                            <div class="col-md-6">
                                <h6>حسب المورد</h6>
                                <table class="table table-sm table-striped">
                                    <thead class="table-dark"><tr><th>المورد</th><th class="text-end">المستندات</th><th class="text-end">إجمالي الشراء</th></tr></thead>
                                    <tbody>
                                        @foreach (var row in purchaseReport.BySupplier)
                                        {
                                            <tr><td>@row.SupplierName</td><td class="text-end">@row.DocumentCount</td><td class="text-end">@row.TotalPurchase.ToString("N2") د.ج</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="col-md-6">
                                <h6>حسب المنتج</h6>
                                <table class="table table-sm table-striped">
                                    <thead class="table-dark"><tr><th>المنتج</th><th class="text-end">الكمية</th><th class="text-end">إجمالي الشراء</th></tr></thead>
                                    <tbody>
                                        @foreach (var row in purchaseReport.ByProduct)
                                        {
                                            <tr><td>@row.ProductName</td><td class="text-end">@row.Quantity.ToString("N2")</td><td class="text-end">@row.TotalPurchase.ToString("N2") د.ج</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">لا تملك صلاحية عرض أسعار الشراء؛ تظهر أعداد المستندات فقط.</div>
                    }
                }
                break;
        }
    </div>
</div>

@code {
    private DateTime fromDate = DateTime.Today.AddDays(-30);
    private DateTime toDate = DateTime.Today;
    private string reportType = "summary";

    // Summary data
    private decimal TotalSales = 0;
    private decimal TotalDiscount = 0;
    private decimal TotalPaid = 0;
    private decimal TotalRemaining = 0;
    private int SalesCount = 0;
    private List<Wizz.Application.DTOs.PaymentMethodBreakdownDto> paymentBreakdown = new();
    private List<Wizz.Application.DTOs.DailySalesDto> dailySales = new();
    private List<(string Name, decimal QuantitySold, decimal TotalSales)> topProducts = new();

    // Phase 3 reports
    private Wizz.Application.DTOs.CashReportDto cashReport = new(new DateOnly(), new DateOnly(), Array.Empty<Wizz.Application.DTOs.CashReportRowDto>(), 0, 0, 0);
    private Wizz.Application.DTOs.PurchaseReportDto purchaseReport = new(new DateOnly(), new DateOnly(), 0, 0, 0, Array.Empty<Wizz.Application.DTOs.PurchaseSupplierRowDto>(), Array.Empty<Wizz.Application.DTOs.PurchaseProductRowDto>());
    private string? cashError;
    private string? purchaseError;
    private bool canViewCosts;
    private string storeName = "Wizz";
    private string? storeAddress;
    private string? storePhone;
    private string? storeTaxNumber;
    private string? storeCommercialRegister;
    private string? storeCurrency;
    private string? printedBy;

    private string ReportTitle => reportType switch
    {
        "summary" => "ملخص المبيعات",
        "daily" => "المبيعات اليومية",
        "products" => "أفضل المنتجات",
        "payment" => "تحليل طرق الدفع",
        "cash" => "تقرير الصندوق",
        "purchases" => "تقرير المشتريات",
        _ => "تقرير"
    };

    // التصدير والطباعة متاحان فقط حين توجد بيانات قابلة للعرض.
    private bool HasData => reportType switch
    {
        "cash" => string.IsNullOrWhiteSpace(cashError),
        "purchases" => string.IsNullOrWhiteSpace(purchaseError),
        _ => true
    };

    protected override async Task OnInitializedAsync()
    {
        canViewCosts = await CurrentUser.HasPermissionAsync(Wizz.Domain.Permission.ViewPurchaseCosts);
        var store = await GetStoreSettings.ExecuteAsync();
        if (store.IsSuccess)
        {
            storeName = store.Value.Name;
            storeAddress = store.Value.Address;
            storePhone = store.Value.Phone;
            storeTaxNumber = store.Value.TaxNumber;
            storeCommercialRegister = store.Value.CommercialRegister;
            storeCurrency = store.Value.Currency;
        }
        printedBy = await CurrentUser.FullNameAsync() ?? await CurrentUser.UsernameAsync();
        await GenerateReport();
    }

    private async Task GenerateReport()
    {
        var from = fromDate.Date.ToUniversalTime();
        var to = toDate.Date.AddDays(1).ToUniversalTime();

        // تقارير المرحلة 3 تستخدم التاريخ التجاري للمتجر داخل حالات الاستخدام.
        var businessFrom = DateOnly.FromDateTime(fromDate.Date);
        var businessTo = DateOnly.FromDateTime(toDate.Date);

        if (reportType == "cash")
        {
            var cash = await GetCashReport.ExecuteAsync(businessFrom, businessTo);
            cashError = cash.IsSuccess ? null : cash.Errors.FirstOrDefault();
            if (cash.IsSuccess)
                cashReport = cash.Value;
            return;
        }

        if (reportType == "purchases")
        {
            var purchases = await GetPurchaseReport.ExecuteAsync(businessFrom, businessTo);
            purchaseError = purchases.IsSuccess ? null : purchases.Errors.FirstOrDefault();
            if (purchases.IsSuccess)
                purchaseReport = purchases.Value;
            return;
        }

        // Get all sales in period
        var sales = await SaleRepo.GetByDateRangeAsync(from, to);
        var completedSales = sales.Where(s => s.Status != Wizz.Domain.SaleStatus.Cancelled).ToList();

        SalesCount = completedSales.Count;
        TotalSales = completedSales.Sum(s => s.Total);
        TotalDiscount = completedSales.Sum(s => s.Discount);
        TotalPaid = completedSales.Sum(s => s.Paid);
        TotalRemaining = completedSales.Sum(s => s.Remaining);

        // Payment breakdown
        paymentBreakdown = completedSales
            .GroupBy(s => s.PaymentMethod)
            .Select(g => new Wizz.Application.DTOs.PaymentMethodBreakdownDto((Wizz.Application.DTOs.PaymentMethodDto)g.Key, g.Count(), g.Sum(s => s.Total)))
            .ToList();

        // Daily sales
        dailySales = completedSales
            .GroupBy(s => s.SaleDate.ToLocalTime().Date)
            .Select(g => new Wizz.Application.DTOs.DailySalesDto(g.Key, g.Count(), g.Sum(s => s.Total), g.Sum(s => s.Paid), g.Sum(s => s.Remaining)))
            .OrderBy(d => d.Date)
            .ToList();

        // Top products (simplified - from sale items)
        var productSales = completedSales
            .SelectMany(s => s.Items)
            .GroupBy(i => new { i.ProductId, i.Product?.Name })
            .Select(g => new { Name = g.Key.Name ?? "منتج غير معروف", QuantitySold = g.Sum(i => i.Quantity), TotalSales = g.Sum(i => i.LineTotal) })
            .OrderByDescending(p => p.TotalSales)
            .Take(10)
            .ToList();

        topProducts = productSales.Select(p => (p.Name, p.QuantitySold, p.TotalSales)).ToList();
    }

    private string GetPaymentMethodText(Wizz.Domain.PaymentMethod method) => method switch
    {
        Wizz.Domain.PaymentMethod.Cash => "نقدي",
        Wizz.Domain.PaymentMethod.Card => "بطاقة",
        Wizz.Domain.PaymentMethod.Credit => "آجل",
        Wizz.Domain.PaymentMethod.Mobile => "محمول",
        Wizz.Domain.PaymentMethod.Mixed => "مختلط",
        _ => "—"
    };

    private string GetPaymentMethodText(Wizz.Application.DTOs.PaymentMethodDto method) => method switch
    {
        Wizz.Application.DTOs.PaymentMethodDto.Cash => "نقدي",
        Wizz.Application.DTOs.PaymentMethodDto.Card => "بطاقة",
        Wizz.Application.DTOs.PaymentMethodDto.Credit => "آجل",
        Wizz.Application.DTOs.PaymentMethodDto.Mobile => "محمول",
        Wizz.Application.DTOs.PaymentMethodDto.Mixed => "مختلط",
        _ => "—"
    };

    // يجمل البيانات المحسوبة المعروضة على الشاشة؛ لا يعيد حساب أي رقم.
    private IReadOnlyList<Wizz.Application.Reports.ReportTable> BuildTables()
    {
        switch (reportType)
        {
            case "summary":
                return new[] { Exporter.BuildSummary(TotalSales, TotalDiscount, TotalPaid, TotalRemaining, SalesCount, paymentBreakdown) };
            case "daily":
                return new[] { Exporter.BuildDaily(dailySales) };
            case "products":
                return new[] { Exporter.BuildProducts(topProducts) };
            case "payment":
                return new[] { Exporter.BuildPayment(paymentBreakdown, TotalSales) };
            case "cash":
                return new[] { Exporter.BuildCash(cashReport) };
            case "purchases":
                return Exporter.BuildPurchases(purchaseReport, canViewCosts);
            default:
                return Array.Empty<Wizz.Application.Reports.ReportTable>();
        }
    }

    // مؤشرات شريط التقرير المطبوع — قيمها من البيانات المحسوبة نفسها.
    private IReadOnlyList<Wizz.Application.Reports.ReportMetric> BuildMetrics()
    {
        var currencyText = string.IsNullOrWhiteSpace(storeCurrency) ? "د.ج" : storeCurrency!;
        string Money(decimal value) => value.ToString("N2", CultureInfo.CurrentCulture) + " " + currencyText;
        string Count(int value) => value.ToString(CultureInfo.CurrentCulture);

        return reportType switch
        {
            "summary" => new[]
            {
                new Wizz.Application.Reports.ReportMetric("إجمالي المبيعات", Money(TotalSales)),
                new Wizz.Application.Reports.ReportMetric("المدفوع", Money(TotalPaid)),
                new Wizz.Application.Reports.ReportMetric("المتبقي", Money(TotalRemaining)),
                new Wizz.Application.Reports.ReportMetric("عدد العمليات", Count(SalesCount))
            },
            "daily" => new[]
            {
                new Wizz.Application.Reports.ReportMetric("عدد الأيام", Count(dailySales.Count)),
                new Wizz.Application.Reports.ReportMetric("إجمالي المبيعات", Money(dailySales.Sum(d => d.Total))),
                new Wizz.Application.Reports.ReportMetric("متوسط اليوم", Money(dailySales.Count > 0 ? dailySales.Sum(d => d.Total) / dailySales.Count : 0m))
            },
            "products" => new[]
            {
                new Wizz.Application.Reports.ReportMetric("عدد الأصناف", Count(topProducts.Count)),
                new Wizz.Application.Reports.ReportMetric("إجمالي المبيعات", Money(topProducts.Sum(p => p.TotalSales))),
                new Wizz.Application.Reports.ReportMetric("الأكثر مبيعًا", topProducts.Count > 0 ? topProducts[0].Name : "—")
            },
            "payment" => new[]
            {
                new Wizz.Application.Reports.ReportMetric("طرق الدفع", Count(paymentBreakdown.Count)),
                new Wizz.Application.Reports.ReportMetric("إجمالي المبيعات", Money(TotalSales)),
                new Wizz.Application.Reports.ReportMetric("النقدي", Money(paymentBreakdown.Where(p => p.Method == Wizz.Application.DTOs.PaymentMethodDto.Cash).Sum(p => p.Amount)))
            },
            "cash" => new[]
            {
                new Wizz.Application.Reports.ReportMetric("ورديات مفتوحة", Count(cashReport.OpenShiftCount)),
                new Wizz.Application.Reports.ReportMetric("ورديات مغلقة", Count(cashReport.ClosedShiftCount)),
                new Wizz.Application.Reports.ReportMetric("النقد المتوقع", Money(cashReport.Rows.Sum(r => r.ExpectedCash)))
            },
            "purchases" => new[]
            {
                new Wizz.Application.Reports.ReportMetric("مستندات نشطة", Count(purchaseReport.DocumentCount)),
                new Wizz.Application.Reports.ReportMetric("مستندات ملغاة", Count(purchaseReport.VoidedDocumentCount)),
                new Wizz.Application.Reports.ReportMetric("إجمالي الشراء", canViewCosts ? Money(purchaseReport.TotalPurchase) : "مخفي لعدم الصلاحية")
            },
            _ => Array.Empty<Wizz.Application.Reports.ReportMetric>()
        };
    }

    private async Task ExportCsv()
    {
        var tables = BuildTables();
        if (tables.Count == 0) return;

        var from = DateOnly.FromDateTime(fromDate.Date);
        var to = DateOnly.FromDateTime(toDate.Date);
        var bytes = Exporter.BuildCsv(storeName, ReportTitle, from, to, tables);
        var fileName = Exporter.BuildFileName(reportType, from, to);
        await JS.InvokeVoidAsync("wizzDownloadBase64", Convert.ToBase64String(bytes), fileName, "text/csv");
    }

    private async Task PrintReport()
    {
        var tables = BuildTables();
        if (tables.Count == 0) return;

        var from = DateOnly.FromDateTime(fromDate.Date);
        var to = DateOnly.FromDateTime(toDate.Date);
        var info = new Wizz.Application.Reports.ReportPrintInfo(
            Address: storeAddress,
            Phone: storePhone,
            TaxNumber: storeTaxNumber,
            CommercialRegister: storeCommercialRegister,
            PrintedBy: printedBy,
            Currency: storeCurrency,
            Metrics: BuildMetrics());
        var html = Exporter.BuildPrintHtml(storeName, ReportTitle, from, to, tables, info);
        await JS.InvokeVoidAsync("wizzPrint", html);
    }
}