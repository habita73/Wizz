@page "/sales/new"
@using Wizz.Application.AI.Perception
@layout MainLayout
@attribute [Authorize(Policy = PermissionPolicy.CreateSale)]
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject Wizz.Application.Abstractions.IProductRepository ProductRepo
@inject Wizz.Application.Abstractions.IStoreRepository StoreRepo
@inject Wizz.Application.Abstractions.ISaleRepository SaleRepo
@inject CurrentUser CurrentUser
@inject Wizz.Application.Abstractions.IAuditLogger Audit
@inject Wizz.Application.UseCases.Sales.CreateSaleUseCase CreateSaleUseCase
@inject Wizz.Application.UseCases.Receipt.GenerateReceiptUseCase GenerateReceiptUseCase
@inject Wizz.Application.Receipts.ThermalReceiptService ReceiptPrinter
@inject Wizz.Application.Abstractions.IBarcodeReader BarcodeReader
@inject Microsoft.AspNetCore.Components.NavigationManager Nav
@inject Wizz.Application.AI.Perception.OcrDraftHandoff DraftHandoff
@inject Wizz.Application.AI.Perception.IOcrAliasStore OcrAliases

<h2 class="d-flex align-items-center gap-2">
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .49.598l-1 5a.5.5 0 0 1-.465.401l-9.397.472L4.415 11H13a.5.5 0 0 1 0 1H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5M3.102 4l.84 4.479 9.144-.459L13.89 4zM5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4m7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4m-7 1a1 1 0 1 1 0 2 1 1 0 0 1 0-2m7 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2" />
    </svg>
    بيع جديد
</h2>

@if (draftRestored)
{
    <div class="alert alert-info d-flex align-items-center flex-wrap gap-2 justify-content-between">
        <span class="d-flex align-items-center gap-2">
            <WizzIcon Icon="info" Size="16" />
            <span>تم استرجاع سلة غير مكتملة (@cartItems.Count صنف) كانت محفوظة تلقائياً على هذا الجهاز.</span>
        </span>
        <span class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="DiscardDraft">بدء بيع جديد</button>
            <button type="button" class="btn-close" aria-label="إخفاء التنبيه" @onclick="() => draftRestored = false"></button>
        </span>
    </div>
}

@if (draftSkippedCount > 0)
{
    <div class="alert alert-warning py-2 small mb-3">
        تعذّر استرجاع @draftSkippedCount صنف من المسودة لأن المنتج لم يعد موجوداً. راجع السلة قبل إتمام البيع.
    </div>
}

@if (!string.IsNullOrWhiteSpace(ocrDraftText))
{
    <div class="alert alert-light border small mb-3">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-1">
            <div class="fw-bold">نص من مساعد قراءة المستندات — راجعه قبل التطبيق</div>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearOcrDraft">إزالة النص</button>
        </div>
        <textarea class="form-control" rows="4" readonly dir="rtl">@ocrDraftText</textarea>
        @if (ocrDraftLines is { Count: > 0 })
        {
            <div class="mt-2">
                <div class="fw-bold">أصناف مقبولة من المحكّم (@ocrDraftLines.Count):</div>
                <ul class="mb-1">
                    @foreach (var line in ocrDraftLines)
                    {
                        <li>
                            @line.Name — كمية @line.Quantity.ToString("0.##")
                            @if (line.Price is { } price)
                            {
                                <span class="text-muted">— @price.ToString("0.##") د.ج</span>
                            }
                        </li>
                    }
                </ul>
                @if (ocrNeedsMergeDecision && cartItems.Count > 0)
                {
                    <div class="alert alert-warning py-2 mb-2">
                        <div class="fw-bold">السلة تحتوي بالفعل @cartItems.Count صنفًا. ماذا تريد؟</div>
                        <div class="small text-muted mb-1">
                            @string.Join("، ", cartItems.Select(i => $"{i.ProductName} × {i.Quantity:0.##}"))
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => ApplyOcrDraftAsync(false)">إضافة إلى السلة الحالية</button>
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => ApplyOcrDraftAsync(true)">استبدال السلة بالأصناف المقروءة</button>
                        </div>
                    </div>
                }
                else
                {
                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => ApplyOcrDraftAsync(false)">تطبيق الأصناف المطابقة على السلة</button>
                }
            </div>
        }
        @if (ocrUnmatchedLines is { Count: > 0 })
        {
            <div class="mt-2 small">
                <div class="fw-bold">أسطر لم تُطابق تامًا (@ocrUnmatchedLines.Count) — اختر إن كان أحدها يقصد صنفًا موجودًا:</div>
                @foreach (var line in ocrUnmatchedLines)
                {
                    <div class="mb-1">
                        <span>@line.Name (كمية @line.Quantity.ToString("0.##"))</span>
                        @foreach (var suggestion in ocrNearSuggestions.Where(s => ReferenceEquals(s.Line, line)))
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary ms-1"
                                    @onclick="() => ApplyNearSuggestion(suggestion)">هل تقصد: @suggestion.Product.Name؟</button>
                        }
                    </div>
                }
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(ocrApplyMessage))
        {
            <div class="alert alert-warning py-2 mt-2 mb-0">@ocrApplyMessage</div>
        }
        <div class="text-muted mt-1">التطابق التام يُضاف تلقائيًا بالكمية المقروءة وبسعر المتجر؛ الأسماء القريبة تُعرض كاقتراح لا يُطبَّق إلا بضغطك. لا يُحفظ شيء قبل إتمام البيع.</div>
    </div>
}

<div class="row">
    <!-- Product Search & Cart -->
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h5 class="mb-0">إضافة منتجات</h5>
                <div class="input-group" style="max-width: 360px;">
                    <input type="text" @bind="searchQuery" @bind:event="oninput" @bind:after="ApplyFilter"
                           @ref="searchInput"
                           placeholder="بحث بالاسم أو الباركود… (Enter إضافة · F2 مسح)"
                           class="form-control" @onkeydown="OnSearchKeyDown" />
                    <button class="btn btn-outline-secondary" @onclick="ScanBarcode" title="مسح باركود (F2)" aria-label="مسح باركود">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M1 1.5A.5.5 0 0 1 1.5 1H3a.5.5 0 0 1 0 1H2v1a.5.5 0 0 1-1 0zm14 0a.5.5 0 0 0-.5-.5H13a.5.5 0 0 0 0 1h1v1a.5.5 0 0 0 1 0zM1 13.5a.5.5 0 0 0 .5.5H3a.5.5 0 0 0 0-1H2v-1a.5.5 0 0 0-1 0zm14 0a.5.5 0 0 1-.5.5H13a.5.5 0 0 1 0-1h1v-1a.5.5 0 0 1 1 0zM3 4h10v8H3z" />
                            <path d="M4 8V5h1v3zm2-3v3h1V5zm2 0v3h1V5zm2 0v3h1V5zm2 3V5h1v3z" />
                        </svg>
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small text-muted">
                        @if (isFiltering)
                        {
                            <text>@filteredProducts.Count نتيجة من أصل @allProducts.Count منتج</text>
                        }
                        else
                        {
                            <text>@allProducts.Count منتج متاح</text>
                        }
                    </span>
                    @if (isFiltering)
                    {
                        <button class="btn btn-sm btn-link p-0" @onclick="ClearFilter">عرض كل المنتجات</button>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(justAdded))
                {
                    <div class="alert alert-success py-1 px-2 small mb-2 d-flex align-items-center gap-2">
                        <WizzIcon Icon="check-circle" Size="16" />
                        <span>تمت إضافة «@justAdded» إلى السلة.</span>
                    </div>
                }

                @if (filteredProducts.Count == 0)
                {
                    <div class="alert alert-info mb-0">
                        @(allProducts.Count == 0
                            ? "لا توجد منتجات بعد. أضف منتجاً من صفحة المنتجات."
                            : "لا توجد منتجات مطابقة للبحث.")
                    </div>
                }
                else
                {
                    <div class="row g-2" style="max-height: 340px; overflow-y: auto;">
                        @foreach (var product in filteredProducts)
                        {
                            <div class="col-6 col-md-4 col-xl-3">
                                <button type="button" class="btn btn-light border w-100 h-100 p-2 text-start"
                                        style="white-space: normal;" @onclick="() => AddToCart(product)">
                                    <div class="fw-bold text-truncate" title="@product.Name">@product.Name</div>
                                    <div class="small text-muted text-truncate">@(product.Barcode ?? "بدون باركود")</div>
                                    <div class="small mt-1">
                                        <span class="fw-bold text-success">@product.RetailPrice.ToString("N2") د.ج</span>
                                        <span class="text-muted">/ @(product.BaseUnit?.Symbol ?? "قطعة")</span>
                                    </div>
                                    @if (inventoryEnabled && !product.IsService)
                                    {
                                        <div class="small mt-1 @(product.IsOutOfStock ? "text-danger" : "text-muted")">
                                            المتوفر: @product.StockQuantity.ToString("N2") @(product.BaseUnit?.Symbol ?? "")
                                        </div>
                                    }
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Cart -->
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">السلة (@cartItems.Count)</h5>
                @if (cartItems.Count > 0)
                {
                    <button class="btn btn-sm btn-outline-danger" @onclick="ClearCart">تفريغ السلة</button>
                }
            </div>
            <div class="card-body">
                @if (cartItems.Count == 0)
                {
                    <div class="text-center text-muted py-4">السلة فارغة. ابحث عن منتج وأضفه للسلة.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>المنتج</th>
                                    <th>الوحدة</th>
                                    <th class="text-center">الكمية</th>
                                    <th class="text-center">السعر</th>
                                    <th class="text-end">الإجمالي</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in cartItems)
                                {
                                    <tr class="@(inventoryEnabled && item.ExceedsStock ? "table-warning" : "")">
                                        <td>
                                            <div>@item.ProductName</div>
                                            @if (inventoryEnabled)
                                            {
                                                <div class="small @(item.ExceedsStock ? "text-danger fw-semibold" : "text-muted")">
                                                    المتوفر: @item.AvailableStock.ToString("N2") @item.BaseUnitSymbol
                                                    @if (item.ExceedsStock)
                                                    {
                                                        <span>— الكمية المطلوبة أكبر من المتوفر</span>
                                                    }
                                                </div>
                                            }
                                        </td>
                                        <td>@item.UnitSymbol</td>
                                        <td class="text-center">
                                            <input type="number" step="0.001" min="0.001" class="form-control form-control-sm text-center mx-auto" style="width: 90px;"
                                                   @bind="item.Quantity" @bind:event="oninput" @bind:after="() => UpdateCartItem(item)" />
                                        </td>
                                        <td class="text-center">
                                            <select class="form-select form-select-sm mx-auto" style="width: 150px;"
                                                    @bind="item.IsWholesale" @bind:after="() => UpdateCartItem(item)">
                                                <option value="false">تجزئة (@item.RetailPrice.ToString("N2"))</option>
                                                <option value="true">جملة (@item.WholesalePrice.ToString("N2"))</option>
                                            </select>
                                        </td>
                                        <td class="text-end fw-bold">@item.LineTotal.ToString("N2") د.ج</td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveFromCart(item)" title="حذف من السلة">
                                                <WizzIcon Icon="trash" Size="14" Title="حذف من السلة" />
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Payment & Summary -->
    <div class="col-lg-4">
        <div class="card sticky-top" style="top: 20px;">
            <div class="card-header">
                <h5 class="mb-0">ملخص الدفع</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">طريقة الدفع</label>
                    <select class="form-select" @bind="paymentMethod" @bind:after="OnPaymentMethodChanged">
                        <option value="0">نقدي</option>
                        <option value="1">بطاقة</option>
                        <option value="2">آجل (دين)</option>
                        <option value="3">محمول</option>
                        <option value="4">مختلط</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">الخصم</label>
                    <input type="number" step="0.01" min="0" max="@Subtotal" class="form-control"
                           @bind="discount" @bind:event="oninput" @bind:after="SaveDraftAsync" @onkeydown="OnFormKeyDown" />
                    @if (discount > Subtotal)
                    {
                        <div class="text-danger small mt-1">الخصم لا يمكن أن يتجاوز المجموع الفرعي.</div>
                    }
                </div>

                <hr />

                <div class="d-flex justify-content-between mb-2">
                    <span>المجموع الفرعي</span>
                    <span class="fw-bold">@Subtotal.ToString("N2") د.ج</span>
                </div>
                <div class="d-flex justify-content-between mb-2 text-success">
                    <span>الخصم</span>
                    <span class="fw-bold">-@discount.ToString("N2") د.ج</span>
                </div>
                <div class="d-flex justify-content-between mb-2 fw-bold fs-5">
                    <span>الإجمالي</span>
                    <span>@Total.ToString("N2") د.ج</span>
                </div>

                <hr />

                <div class="mb-3">
                    <label class="form-label">المبلغ المدفوع</label>
                    <input type="number" step="0.01" min="0" class="form-control form-control-lg fw-bold"
                           @bind="paidAmount" @bind:event="oninput" @bind:after="SaveDraftAsync" @onkeydown="OnFormKeyDown" />
                    @if (Remaining > 0)
                    {
                        <div class="text-danger small mt-1">المتبقي: @Remaining.ToString("N2") د.ج</div>
                    }
                    @if (paymentMethod != 2 && paidAmount > Total)
                    {
                        <div class="text-warning small mt-1">المبلغ المدفوع أكبر من الإجمالي.</div>
                    }
                </div>

                @if (paymentMethod == 2)
                {
                    <div class="mb-3">
                        <label class="form-label">تاريخ الاستحقاق</label>
                        <input type="date" class="form-control" @bind="dueDate" @bind:after="SaveDraftAsync" @onkeydown="OnFormKeyDown" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">اسم الزبون <span class="text-muted fw-normal">(اختياري)</span></label>
                        <div class="position-relative">
                            <input type="text" class="form-control" maxlength="200" autocomplete="off"
                                   placeholder="اكتب أو اختر اسمًا سابقًا"
                                   @bind="customerName" @bind:event="oninput"
                                   @bind:after="OnCustomerNameChangedAsync"
                                   @onfocus="OnCustomerNameFocus"
                                   @onblur="OnCustomerNameBlur"
                                   @onkeydown="OnCustomerNameKeyDown" />
                            @if (showCustomerSuggestions && customerSuggestions.Count > 0)
                            {
                                <div class="customer-suggestions list-group position-absolute w-100">
                                    @for (var i = 0; i < customerSuggestions.Count; i++)
                                    {
                                        var suggestion = customerSuggestions[i];
                                        var active = i == customerSuggestionIndex;
                                        <button type="button"
                                                class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(active ? "active" : "")"
                                                @onmousedown="() => ApplyCustomerSuggestion(suggestion)">
                                            <span>@suggestion.Name</span>
                                            <span class="badge @(suggestion.OpenDebtCount > 0 ? "bg-warning text-dark" : "bg-secondary") rounded-pill">
                                                @if (suggestion.OpenDebtCount > 0)
                                                {
                                                    <span>@suggestion.OpenDebtCount دين مفتوح</span>
                                                }
                                                else
                                                {
                                                    <span>سابق</span>
                                                }
                                            </span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                        <div class="form-text">اختر اسمًا موجودًا كي تُجمَّع ديون الشخص نفسه في سجل واحد.</div>
                    </div>
                }

                <div class="small text-muted mb-2">
                    <kbd>Enter</kbd> لإتمام البيع · <kbd>Esc</kbd> لمسح البحث · <kbd>F2</kbd> لمسح الباركود
                </div>

                <div class="d-grid gap-2">
                    <button class="btn btn-success btn-lg" @onclick="CompleteSale" disabled="@(!CanCompleteSale || savingSale)">
                        @if (savingSale)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425z" />
                        </svg>
                        إتمام البيع (@Total.ToString("N2") د.ج)
                    </button>
                    <label class="form-check form-switch small mt-2 d-inline-flex align-items-center gap-2">
                        <input class="form-check-input" type="checkbox" role="switch"
                               id="receiptAutoPrint"
                               checked="@autoPrintReceipt"
                               @onchange="ToggleAutoPrint" />
                        <span class="form-check-label">طباعة الإيصال تلقائيًا بعد كل بيع</span>
                    </label>
                    <div class="small text-muted" aria-live="polite">
                        حالة الطباعة التلقائية: @(autoPrintReceipt ? "مفعّلة" : "معطلة") — تُحفظ على هذا الجهاز.
                    </div>
                    @if (lastSaleId != null)
                    {
                        <button class="btn btn-outline-secondary d-inline-flex align-items-center justify-content-center gap-1" @onclick="PrintReceipt">
                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                <path d="M2.5 8a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1" />
                                <path d="M5 1a2 2 0 0 0-2 2v2H2a2 2 0 0 0-2 2v3a2 2 0 0 0 2 2h1v1a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2v-1h1a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-1V3a2 2 0 0 0-2-2zM4 3a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2H4zm1 5a2 2 0 0 0-2 2v1H2a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v-1a2 2 0 0 0-2-2zm7 2v3a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1" />
                            </svg>
                            طباعة إيصال آخر بيع
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string searchQuery = "";
    private ElementReference searchInput;
    private List<Wizz.Application.DTOs.ProductDto> allProducts = new();
    private List<Wizz.Application.DTOs.ProductDto> filteredProducts = new();
    private string? justAdded;
    private List<CartItem> cartItems = new();
    private decimal discount;
    private decimal paidAmount;
    private int paymentMethod;
    private DateTime dueDate = DateTime.Today.AddDays(30);
    private string? customerName;

    // اقتراحات أسماء الزبائن من الديون والمبيعات السابقة، مع تنقّل بلوحة المفاتيح.
    private IReadOnlyList<Wizz.Application.DTOs.CustomerSuggestionDto> customerSuggestions =
        Array.Empty<Wizz.Application.DTOs.CustomerSuggestionDto>();
    private bool showCustomerSuggestions;
    private int customerSuggestionIndex = -1;

    private Guid? cashierId;
    private Guid? lastSaleId;
    private bool savingSale;
    private bool inventoryEnabled;

    // إعداد طباعة الإيصال: حالة تلقائية مخصصة تُحفظ محليًا، وزر يدوي يعيد طباعة آخر بيع.
    private const string AutoPrintKey = "wizz.receipt.autoprint";
    private const string LastSaleKey = "wizz.receipt.lastsale";
    private bool autoPrintReceipt;

    // مسودة السلة: تُحفظ في متصفح الكاشير بعد كل تعديل وتُسترجع عند العودة.
    private const string DraftKey = "wizz.cart.draft.v1";
    private const string DraftEnabledKey = "wizz.cart.draft.enabled";
    private static readonly TimeSpan DraftMaxAge = TimeSpan.FromHours(24);
    private bool jsReady;
    private bool draftRestored;
    private int draftSkippedCount;
    // نتيجة قراءة المستندات: النص للمراجعة، والأصناف المقبولة للتطبيق بقرار المستخدم.
    private string? ocrDraftText;
    private IReadOnlyList<OcrDraftLine>? ocrDraftLines;
    private IReadOnlyList<OcrDraftLine>? ocrUnmatchedLines;
    private IReadOnlyList<OcrNearSuggestion> ocrNearSuggestions = Array.Empty<OcrNearSuggestion>();
    private bool ocrNeedsMergeDecision;
    private string? ocrApplyMessage;
    private sealed record OcrNearSuggestion(OcrDraftLine Line, Wizz.Application.DTOs.ProductDto Product);

    private bool isFiltering => !string.IsNullOrWhiteSpace(searchQuery);

    private decimal Subtotal => cartItems.Sum(i => i.LineTotal);
    private decimal Total => Math.Max(0, Subtotal - discount);
    private decimal Remaining => Math.Max(0, Total - paidAmount);

    private bool CanCompleteSale =>
        cartItems.Count > 0
        && discount <= Subtotal
        && (paymentMethod == 2
            ? dueDate.Date >= DateTime.Today
            : paidAmount >= Total);

    protected override async Task OnInitializedAsync()
    {
        var ocrDraft = DraftHandoff.Take(OcrDraftHandoff.SaleTarget);
        ocrDraftText = ocrDraft?.Text;
        ocrDraftLines = ocrDraft?.Lines;
        var store = await StoreRepo.GetAsync();
        inventoryEnabled = store?.InventoryEnabled == true;

        await ResolveCashierAsync();
        await LoadInitialProducts();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // JS متاح بعد أول رسم فقط (لا يعمل في التصيير المسبق على الخادم).
        jsReady = true;
        await RestoreDraftAsync();
        await RestorePrintPreferencesAsync();
        await FocusSearchAsync();
    }

    /// <summary>يعيد المؤشر إلى حقل البحث — أساس العمل بالباركود ولوحة المفاتيح.</summary>
    private async Task FocusSearchAsync()
    {
        try
        {
            await searchInput.FocusAsync();
        }
        catch
        {
            // الحقل غير مرسوم بعد — لا نُفشل الصفحة.
        }
    }

    /// <summary>Enter في حقول الدفع: تنفيذ الإجراء الافتراضي (إتمام البيع) عند اكتمال الشروط.</summary>
    private async Task OnFormKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && CanCompleteSale && !savingSale)
        {
            await CompleteSale();
        }
    }

    /// <summary>بحث الاقتراحات بعد كل حرف مع حفظ المسودة.</summary>
    private async Task OnCustomerNameChangedAsync()
    {
        await SaveDraftAsync();
        await LoadCustomerSuggestionsAsync();
    }

    /// <summary>عند التركيز نعرض الأسماء الأكثر تكرارًا حتى لو لم يُكتب شيء بعد.</summary>
    private async Task OnCustomerNameFocus()
    {
        if (!showCustomerSuggestions)
            await LoadCustomerSuggestionsAsync();
    }

    private void OnCustomerNameBlur()
    {
        showCustomerSuggestions = false;
        customerSuggestionIndex = -1;
    }

    private async Task LoadCustomerSuggestionsAsync()
    {
        customerSuggestions = await SaleRepo.GetCustomerSuggestionsAsync(customerName, 8);
        customerSuggestionIndex = customerSuggestions.Count > 0 ? 0 : -1;
        showCustomerSuggestions = true;
    }

    private async Task ApplyCustomerSuggestion(Wizz.Application.DTOs.CustomerSuggestionDto suggestion)
    {
        customerName = suggestion.Name;
        showCustomerSuggestions = false;
        customerSuggestionIndex = -1;
        await SaveDraftAsync();
    }

    /// <summary>
    /// تنقّل بين الاقتراحات بالأسهم، اختيار بالـEnter، وإغلاق بالـEscape.
    /// Enter هنا لا يُتمّ البيع إلا إذا لم يكن هناك اقتراح محدد.
    /// </summary>
    private async Task OnCustomerNameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowDown")
        {
            if (!showCustomerSuggestions)
            {
                await LoadCustomerSuggestionsAsync();
            }
            else if (customerSuggestions.Count > 0)
            {
                customerSuggestionIndex = (customerSuggestionIndex + 1) % customerSuggestions.Count;
            }
            return;
        }

        if (e.Key == "ArrowUp")
        {
            if (customerSuggestions.Count > 0)
            {
                customerSuggestionIndex = customerSuggestionIndex <= 0
                    ? customerSuggestions.Count - 1
                    : customerSuggestionIndex - 1;
            }
            return;
        }

        if (e.Key == "Enter")
        {
            if (showCustomerSuggestions
                && customerSuggestionIndex >= 0
                && customerSuggestionIndex < customerSuggestions.Count)
            {
                await ApplyCustomerSuggestion(customerSuggestions[customerSuggestionIndex]);
                return;
            }

            if (CanCompleteSale && !savingSale)
                await CompleteSale();
            return;
        }

        if (e.Key == "Escape")
        {
            showCustomerSuggestions = false;
            customerSuggestionIndex = -1;
            return;
        }

        if (e.Key == "Tab")
        {
            showCustomerSuggestions = false;
        }
    }

    private async Task ResolveCashierAsync()
    {
        cashierId = await CurrentUser.IdAsync();
    }

    private async Task LoadInitialProducts()
    {
        allProducts = MapProducts((await ProductRepo.GetAllAsync()).Where(p => p.IsActive));
        ApplyFilter();
    }

    private static List<Wizz.Application.DTOs.ProductDto> MapProducts(IEnumerable<Product> products) =>
        products.Select(p => new Wizz.Application.DTOs.ProductDto(
            p.Id, p.Name, p.Barcode, p.Description, p.RetailPrice, p.WholesalePrice,
            p.IsService, p.IsActive,
            p.Units.Select(u => new Wizz.Application.DTOs.UnitOfMeasureDto(u.Id, u.Name, u.Symbol, u.BaseQuantity, u.IsBaseUnit)).ToList(),
            p.GetBaseUnit() is { } bu ? new Wizz.Application.DTOs.UnitOfMeasureDto(bu.Id, bu.Name, bu.Symbol, bu.BaseQuantity, true) : null,
            p.StockQuantity, p.ReorderLevel
        )).ToList();

    /// <summary>فلترة فورية في الذاكرة — لا تتطلب أي استعلام جديد ولا تُفرغ القائمة.</summary>
    private void ApplyFilter()
    {
        var q = searchQuery?.Trim() ?? "";
        if (q.Length == 0)
        {
            filteredProducts = allProducts;
        }
        else
        {
            filteredProducts = allProducts
                .Where(p => p.Name.Contains(q, StringComparison.OrdinalIgnoreCase)
                            || (p.Barcode?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false))
                .ToList();
        }
    }

    private void ClearFilter()
    {
        searchQuery = "";
        justAdded = null;
        ApplyFilter();
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            justAdded = null;

            // مطابقة باركود دقيقة أولاً، ثم مطابقة وحيدة
            var barcodeMatch = filteredProducts.FirstOrDefault(p =>
                string.Equals(p.Barcode, searchQuery?.Trim(), StringComparison.OrdinalIgnoreCase));

            var target = barcodeMatch ?? (filteredProducts.Count == 1 ? filteredProducts[0] : null);
            if (target != null)
            {
                await AddToCart(target);
            }
            ApplyFilter();
        }
        else if (e.Key == "Escape")
        {
            ClearFilter();
            await FocusSearchAsync();
        }
        else if (e.Key == "F2")
        {
            await ScanBarcode();
        }
    }

    private async Task ScanBarcode()
    {
        var code = await BarcodeReader.ReadAsync();
        if (string.IsNullOrWhiteSpace(code))
        {
            return;
        }

        searchQuery = code;
        ApplyFilter();
        var match = filteredProducts.FirstOrDefault();
        if (match != null)
        {
            await AddToCart(match);
        }
        StateHasChanged();
    }

    private async Task AddToCart(Wizz.Application.DTOs.ProductDto product)
    {
        AppendToCart(cartItems, product, 1m);

        // نُبقي شبكة المنتجات ظاهرة بعد الإضافة — لا تُفرَّغ ولا تختفي
        justAdded = product.Name;
        searchQuery = "";
        ApplyFilter();
        StateHasChanged();

        await SaveDraftAsync();

        // المؤشر يعود للبحث تلقائياً — يسمح بتمرير منتجات متتالية بلا فأرة.
        await FocusSearchAsync();
    }

    /// <summary>يضيف صنفًا بالكمية المحددة إلى السلة؛ السعر دائمًا من بيانات المنتج الحالية.</summary>
    private static bool AppendToCart(List<CartItem> cartItems, Wizz.Application.DTOs.ProductDto product, decimal quantity)
    {
        var existing = cartItems.FirstOrDefault(c => c.ProductId == product.Id && !c.IsWholesale);
        if (existing is not null)
        {
            existing.Quantity += quantity;
            existing.LineTotal = Math.Round(existing.Quantity * existing.UnitPrice, 2, MidpointRounding.AwayFromZero);
            return true;
        }

        var item = CreateCartItem(product, quantity, isWholesale: false);
        if (item is null) return false;
        cartItems.Add(item);
        return true;
    }

    /// <summary>يُفرَّغ لوحة القراءة.</summary>
    private void ClearOcrDraft()
    {
        ocrDraftText = null;
        ocrDraftLines = null;
        ocrUnmatchedLines = null;
        ocrNearSuggestions = Array.Empty<OcrNearSuggestion>();
        ocrNeedsMergeDecision = false;
        ocrApplyMessage = null;
    }

    /// <summary>
    /// يطبّق الأصناف المقبولة بعد مطابقة الاسم التام فقط. إن كانت السلة غير فارغة يطلب قرارًا صريحًا
    /// قبل الإضافة أو الاستبدال، حتى لا تتراكم الكميات فوق سلة سابقة دون علم المستخدم.
    /// </summary>
    private async Task ApplyOcrDraftAsync(bool replaceCart)
    {
        if (ocrDraftLines is null || ocrDraftLines.Count == 0) return;

        if (!ocrNeedsMergeDecision && cartItems.Count > 0)
        {
            ocrNeedsMergeDecision = true;
            ocrApplyMessage = "السلة تحتوي أصنافًا بالفعل؛ اختر إضافة أو استبدالًا قبل المتابعة.";
            StateHasChanged();
            return;
        }

        if (replaceCart)
        {
            cartItems.Clear();
        }

        var added = 0;
        var unmatched = new List<OcrDraftLine>();
        foreach (var line in ocrDraftLines)
        {
            // الاسم المتعلَّم من تأكيد سابق يُحلَّب محليًا قبل المطابقة التامّة؛ لا تدريب نموذج ولا إرسال.
            var resolvedName = OcrAliases.Resolve(line.Name) ?? line.Name;
            var product = OcrProductMatcher.Match(resolvedName, allProducts, p => p.Name);
            if (product is null || !AppendToCart(cartItems, product, line.Quantity))
            {
                unmatched.Add(line);
                continue;
            }
            added++;
        }

        ocrDraftLines = null;
        ocrNeedsMergeDecision = false;
        ocrUnmatchedLines = unmatched.Count > 0 ? unmatched : null;
        ocrNearSuggestions = ocrUnmatchedLines is null
            ? Array.Empty<OcrNearSuggestion>()
            : ocrUnmatchedLines
                .SelectMany(line => OcrProductMatcher.Suggest(OcrAliases.Resolve(line.Name) ?? line.Name, allProducts, p => p.Name)
                    .Select(product => new OcrNearSuggestion(line, product)))
                .ToArray();
        ocrApplyMessage = $"أُضيف {added} صنفًا بالكمية المقروءة وسعر المتجر."
            + (unmatched.Count > 0 ? $" لم يُطابق {unmatched.Count} سطرًا منتجًا موجودًا؛ راجع الاقتراحات أو أضفه يدويًا." : string.Empty)
            + " راجع السلة قبل إتمام البيع.";
        StateHasChanged();
        await SaveDraftAsync();
    }

    /// <summary>يضيف اقتراح اسم قريب بعد موافقة المستخدم الصريحة، بالكمية المقروءة.</summary>
    private async Task ApplyNearSuggestion(OcrNearSuggestion suggestion)
    {
        if (AppendToCart(cartItems, suggestion.Product, suggestion.Line.Quantity))
        {
            // ضغط المستخدم على «هل تقصد» هو تأكيد صريح، فيُحفظ الاسم محليًا للمرات القادمة فقط.
            OcrAliases.Remember(suggestion.Line.Name, suggestion.Product.Name);
            ocrUnmatchedLines = ocrUnmatchedLines?.Where(l => !ReferenceEquals(l, suggestion.Line)).ToArray();
            ocrNearSuggestions = ocrNearSuggestions.Where(s => !ReferenceEquals(s, suggestion.Line)).ToArray();
            ocrApplyMessage = $"أُضيف {suggestion.Product.Name} بكمية {suggestion.Line.Quantity:0.##} بعد موافقتك، وتعلّمنا الاسم محليًا للمرة القادمة.";
        }
        StateHasChanged();
        await SaveDraftAsync();
    }

    /// <summary>
    /// يبني سطر سلة من بيانات المنتج الحالية. تُقرأ الأسعار والمخزون من قاعدة
    /// البيانات لا من المسودة، حتى لا تُبنى فاتورة على سعر قديم.
    /// </summary>
    private static CartItem? CreateCartItem(Wizz.Application.DTOs.ProductDto product, decimal quantity, bool isWholesale)
    {
        var baseUnit = product.BaseUnit ?? product.Units.FirstOrDefault();
        if (baseUnit is null)
        {
            return null;
        }

        var safeQuantity = quantity > 0 ? quantity : 1;
        var unitPrice = isWholesale ? product.WholesalePrice : product.RetailPrice;

        return new CartItem
        {
            ProductId = product.Id,
            ProductName = product.Name,
            UnitId = baseUnit.Id,
            UnitSymbol = baseUnit.Symbol,
            UnitBaseQuantity = baseUnit.BaseQuantity,
            BaseUnitSymbol = product.BaseUnit?.Symbol ?? baseUnit.Symbol,
            AvailableStock = product.StockQuantity,
            Quantity = safeQuantity,
            UnitPrice = unitPrice,
            RetailPrice = product.RetailPrice,
            WholesalePrice = product.WholesalePrice,
            IsWholesale = isWholesale,
            LineTotal = Math.Round(safeQuantity * unitPrice, 2, MidpointRounding.AwayFromZero),
        };
    }

    private async Task UpdateCartItem(CartItem item)
    {
        if (item.Quantity <= 0)
        {
            item.Quantity = 0.001m;
        }

        item.UnitPrice = item.IsWholesale ? item.WholesalePrice : item.RetailPrice;
        item.LineTotal = Math.Round(item.Quantity * item.UnitPrice, 2, MidpointRounding.AwayFromZero);
        StateHasChanged();
        await SaveDraftAsync();
    }

    private async Task RemoveFromCart(CartItem item)
    {
        cartItems.Remove(item);
        StateHasChanged();
        await SaveDraftAsync();
    }

    private async Task OnPaymentMethodChanged()
    {
        if (paymentMethod == 2)
        {
            paidAmount = 0;
        }
        else if (paidAmount < Total)
        {
            paidAmount = Total;
        }

        if (paymentMethod != 2)
        {
            showCustomerSuggestions = false;
            customerSuggestionIndex = -1;
        }

        StateHasChanged();
        await SaveDraftAsync();
    }

    private async Task ClearCart()
    {
        cartItems.Clear();
        discount = 0;
        paidAmount = 0;
        paymentMethod = 0;
        dueDate = DateTime.Today.AddDays(30);
        customerName = null;
        showCustomerSuggestions = false;
        customerSuggestionIndex = -1;
        justAdded = null;
        searchQuery = "";
        draftRestored = false;
        draftSkippedCount = 0;
        ApplyFilter();
        StateHasChanged();
        await RemoveDraftAsync();
    }

    /// <summary>يتخلّى عن المسودة المسترجعة ويبدأ سلة جديدة.</summary>
    private async Task DiscardDraft()
    {
        await ClearCart();
    }

    // ------------------------------------------------------------------
    // مسودة السلة: حفظ تلقائي في المتصفح واسترجاع عند العودة إلى الشاشة
    // ------------------------------------------------------------------

    /// <summary>
    /// يقرأ تفضيل حفظ السلة من الإعدادات السريعة. الافتراضي مفعّل،
    /// والقيمة «off» وحدها تعني أن الكاشير أوقف الحفظ على هذا الجهاز.
    /// </summary>
    private async Task<bool> IsDraftEnabledAsync()
    {
        try
        {
            var value = await JS.InvokeAsync<string?>("localStorage.getItem", DraftEnabledKey);
            return !string.Equals(value, "off", StringComparison.OrdinalIgnoreCase);
        }
        catch
        {
            // تعطّل التخزين المحلي لا يمنع البيع؛ نُبقي السلوك الافتراضي.
            return true;
        }
    }

    /// <summary>يحفظ السلة الحالية كمسودة، أو يمسح المسودة إن كانت السلة فارغة.</summary>
    private async Task SaveDraftAsync()
    {
        if (!jsReady)
        {
            return;
        }

        // الإعدادات السريعة: يمكن للكاشير إيقاف حفظ السلة على هذا الجهاز.
        if (!await IsDraftEnabledAsync())
        {
            await RemoveDraftAsync();
            return;
        }

        try
        {
            if (cartItems.Count == 0 || cashierId is null)
            {
                await RemoveDraftAsync();
                return;
            }

            var draft = new SaleDraft
            {
                CashierId = cashierId.Value.ToString(),
                SavedAtUtc = DateTime.UtcNow,
                Discount = discount,
                PaidAmount = paidAmount,
                PaymentMethod = paymentMethod,
                DueDate = dueDate,
                CustomerName = customerName,
                Lines = cartItems.Select(c => new SaleDraftLine
                {
                    ProductId = c.ProductId,
                    Quantity = c.Quantity,
                    IsWholesale = c.IsWholesale,
                }).ToList(),
            };

            var json = System.Text.Json.JsonSerializer.Serialize(draft);
            await JS.InvokeVoidAsync("localStorage.setItem", DraftKey, json);
        }
        catch
        {
            // تعطّل التخزين المحلي لا يوقف البيع؛ المسودة رفاهية لا شرط.
        }
    }

    /// <summary>يمسح المسودة المحفوظة في المتصفح.</summary>
    private async Task RemoveDraftAsync()
    {
        if (!jsReady)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", DraftKey);
        }
        catch
        {
            // تجاهل: لا شيء يعتمد على نجاح المسح.
        }
    }

    /// <summary>
    /// يسترجع مسودة الكاشير الحالي إن وُجدت وكانت حديثة، ويعيد بناء الأسعار
    /// والمخزون من قاعدة البيانات. المسودة التالفة أو القديمة تُمسح بهدوء.
    /// </summary>
    private async Task RestoreDraftAsync()
    {
        if (cashierId is null)
        {
            return;
        }

        // لا استرجاع عندما يكون حفظ السلة متوقفاً من الإعدادات السريعة.
        if (!await IsDraftEnabledAsync())
        {
            return;
        }

        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", DraftKey);
            if (string.IsNullOrWhiteSpace(json))
            {
                return;
            }

            var draft = System.Text.Json.JsonSerializer.Deserialize<SaleDraft>(json);
            if (draft?.Lines is null || draft.Lines.Count == 0)
            {
                await RemoveDraftAsync();
                return;
            }

            if (!string.Equals(draft.CashierId, cashierId.Value.ToString(), StringComparison.OrdinalIgnoreCase))
            {
                return;
            }

            if (draft.SavedAtUtc == default || DateTime.UtcNow - draft.SavedAtUtc > DraftMaxAge)
            {
                await RemoveDraftAsync();
                return;
            }

            var restored = new List<CartItem>();
            var skipped = 0;
            foreach (var line in draft.Lines)
            {
                var product = await ProductRepo.GetByIdAsync(line.ProductId);
                if (product is null || !product.IsActive)
                {
                    skipped++;
                    continue;
                }

                var item = CreateCartItem(Wizz.Application.DTOs.ProductDto.FromDomain(product), line.Quantity, line.IsWholesale);
                if (item is null)
                {
                    skipped++;
                    continue;
                }

                restored.Add(item);
            }

            if (restored.Count == 0)
            {
                await RemoveDraftAsync();
                return;
            }

            cartItems = restored;
            discount = draft.Discount;
            paidAmount = draft.PaidAmount;
            paymentMethod = draft.PaymentMethod is >= 0 and <= 4 ? draft.PaymentMethod : 0;
            dueDate = draft.DueDate == default ? DateTime.Today.AddDays(30) : draft.DueDate;
            customerName = draft.CustomerName;
            draftSkippedCount = skipped;
            draftRestored = true;
            ApplyFilter();
            StateHasChanged();
        }
        catch
        {
            // مسودة غير صالحة (تنسيق قديم أو تالف): نمسحها ونبدأ بسلة فارغة.
            await RemoveDraftAsync();
        }
    }

    /// <summary>يستعيد إعداد الطباعة التلقائي وآخر بيع من تفضيلات هذا الجهاز.</summary>
    private async Task RestorePrintPreferencesAsync()
    {
        try
        {
            var mode = await JS.InvokeAsync<string?>("localStorage.getItem", AutoPrintKey);
            autoPrintReceipt = mode == "on";

            var last = await JS.InvokeAsync<string?>("localStorage.getItem", LastSaleKey);
            if (Guid.TryParse(last, out var id))
            {
                lastSaleId = id;
            }
        }
        catch
        {
            // التخزين المحلي معطّل: نبقى على الوضع الافتراضي (طباعة يدوية فقط).
            autoPrintReceipt = false;
        }
    }

    private async Task ToggleAutoPrint(ChangeEventArgs args)
    {
        autoPrintReceipt = args.Value is bool value
            ? value
            : string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", AutoPrintKey, autoPrintReceipt ? "on" : "off");
        }
        catch
        {
            // الإعداد يبقى ساريًا لهذه الجلسة فقط.
        }
    }

    private async Task SaveLastSaleAsync(Guid saleId)
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", LastSaleKey, saleId.ToString());
        }
        catch
        {
            // لا يؤثر فشل الحفظ على البيع نفسه.
        }
    }

    /// <summary>يفتح نافذة طباعة الإيصال دون أن يمنع البيع أو يكرره عند الفشل.</summary>
    private async Task<bool> TryPrintReceiptAsync(Guid saleId)
    {
        try
        {
            var result = await GenerateReceiptUseCase.ExecuteAsync(saleId);
            if (!result.IsSuccess)
            {
                return false;
            }

            var html = ReceiptPrinter.BuildHtml(result.Value);
            await JS.InvokeVoidAsync("wizzPrint", html);
            return true;
        }
        catch
        {
            // الطباعة لا تُعيد محاولة البيع؛ تظهر رسالة واضحة للمستخدم بعد اكتمال الحفظ.
            return false;
        }
    }

    private async Task CompleteSale()
    {
        if (!CanCompleteSale || savingSale)
        {
            return;
        }

        if (cashierId is null)
        {
            await JS.InvokeVoidAsync("alert", "لا يوجد مستخدم نشط. أضف مستخدمًا من صفحة الإعدادات أولًا.");
            return;
        }

        // تحذير واضح إذا تجاوزت الكمية المتوفرة — لا نمنع البيع، لكن نطلب تأكيداً صريحاً.
        if (inventoryEnabled)
        {
            var shortages = new List<string>();
            foreach (var item in cartItems)
            {
                var product = await ProductRepo.GetByIdAsync(item.ProductId);
                if (product == null || product.IsService) continue;

                var requested = item.Quantity * item.UnitBaseQuantity;
                if (requested > product.StockQuantity)
                {
                    shortages.Add($"{item.ProductName}: المطلوب {requested:N2}، المتوفر {product.StockQuantity:N2}");
                }
            }

            if (shortages.Count > 0)
            {
                var proceed = await JS.InvokeAsync<bool>(
                    "confirm",
                    "الكمية المطلوبة أكبر من المخزون المتوفر:\n" + string.Join("\n", shortages)
                    + "\n\nهل تريد متابعة البيع؟ سيصبح رصيد هذه المنتجات سالباً.");
                if (!proceed)
                {
                    return;
                }
            }
        }

        savingSale = true;
        try
        {
            var input = new Wizz.Application.DTOs.SaleInputDto(
                cartItems.Select(c => new Wizz.Application.DTOs.SaleLineInputDto(
                    c.ProductId, c.UnitId, c.Quantity, c.IsWholesale)).ToList(),
                discount, paidAmount, (Wizz.Application.DTOs.PaymentMethodDto)paymentMethod,
                paymentMethod == 2, paymentMethod == 2 ? dueDate : null,
                paymentMethod == 2 ? customerName : null);

            var result = await CreateSaleUseCase.ExecuteAsync(input, cashierId.Value);
            if (!result.IsSuccess)
            {
                await JS.InvokeVoidAsync("alert", $"خطأ: {string.Join(" | ", result.Errors)}");
                return;
            }

            lastSaleId = result.Value.Id;
            await SaveLastSaleAsync(lastSaleId.Value);
            await Audit.LogAsync(new AuditEntry(
                AuditAction.SaleCreated,
                AuditOutcome.Success,
                cashierId,
                await CurrentUser.UsernameAsync(),
                "Sale",
                result.Value.Id.ToString(),
                $"إجمالي البيع {result.Value.Total:N2} د.ج"));
            await ClearCart();
            await LoadInitialProducts();

            var message = $"تم البيع بنجاح — الإجمالي {result.Value.Total:N2} د.ج";
            if (autoPrintReceipt)
            {
                var opened = await TryPrintReceiptAsync(lastSaleId.Value);
                message += opened
                    ? "\nتم فتح نافذة طباعة الإيصال."
                    : "\nتعذّر فتح نافذة الطباعة؛ يمكنك استخدام زر «طباعة إيصال آخر بيع».";
            }
            await JS.InvokeVoidAsync("alert", message);
            // بعد إتمام البيع نعود إلى قائمة المبيعات.
            Nav.NavigateTo("/sales/history");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"خطأ غير متوقع: {ex.Message}");
        }
        finally
        {
            savingSale = false;
        }
    }

    /// <summary>زر الطباعة اليدوية: يعيد طباعة إيصال آخر بيع بنفس تنسيق الطباعة التلقائية.</summary>
    private async Task PrintReceipt()
    {
        if (lastSaleId is null)
        {
            return;
        }

        var result = await GenerateReceiptUseCase.ExecuteAsync(lastSaleId.Value);
        if (!result.IsSuccess)
        {
            await JS.InvokeVoidAsync("alert", $"تعذّر توليد الإيصال: {string.Join(" | ", result.Errors)}");
            return;
        }

        var html = ReceiptPrinter.BuildHtml(result.Value);
        try
        {
            await JS.InvokeVoidAsync("wizzPrint", html);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"تعذّر فتح نافذة الطباعة: {ex.Message}");
        }
    }

    private class CartItem
    {
        public Guid ProductId { get; set; }
        public string ProductName { get; set; } = "";
        public Guid UnitId { get; set; }
        public string UnitSymbol { get; set; } = "";
        public decimal UnitBaseQuantity { get; set; } = 1m;
        public string BaseUnitSymbol { get; set; } = "";
        public decimal AvailableStock { get; set; }
        public bool ExceedsStock => Quantity * UnitBaseQuantity > AvailableStock;
        public decimal Quantity { get; set; }
        public decimal UnitPrice { get; set; }
        public decimal RetailPrice { get; set; }
        public decimal WholesalePrice { get; set; }
        public bool IsWholesale { get; set; }
        public decimal LineTotal { get; set; }
    }
}
