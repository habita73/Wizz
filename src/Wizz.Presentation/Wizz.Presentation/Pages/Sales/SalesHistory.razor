@page "/sales/history"
@layout MainLayout
@inject Wizz.Application.Abstractions.ISaleRepository SaleRepo
@inject Wizz.Application.Abstractions.IUserRepository UserRepo
@inject Wizz.Application.Abstractions.IPrinter Printer
@inject Wizz.Application.UseCases.Sales.ModifySaleUseCase ModifySaleUseCase
@inject Wizz.Application.UseCases.Sales.CancelSaleUseCase CancelSaleUseCase
@inject Wizz.Application.UseCases.Receipt.GenerateReceiptUseCase GenerateReceiptUseCase
@inject IJSRuntime JS

<h2 class="d-flex align-items-center gap-2">
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .49.598l-1 5a.5.5 0 0 1-.465.401l-9.397.472L4.415 11H13a.5.5 0 0 1 0 1H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5M3.102 4l.84 4.479 9.144-.459L13.89 4zM5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4m7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4m-7 1a1 1 0 1 1 0 2 1 1 0 0 1 0-2m7 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2" />
    </svg>
    المبيعات
</h2>

<div class="row mb-3 g-2">
    <div class="col-md-3">
        <label class="form-label small mb-1">من تاريخ</label>
        <input type="date" class="form-control" @bind="fromDate" @bind:after="Reload" />
    </div>
    <div class="col-md-3">
        <label class="form-label small mb-1">إلى تاريخ</label>
        <input type="date" class="form-control" @bind="toDate" @bind:after="Reload" />
    </div>
    <div class="col-md-3">
        <label class="form-label small mb-1">الحالة</label>
        <select class="form-select" @bind="statusFilter" @bind:after="Reload">
            <option value="">كل الحالات</option>
            <option value="0">قيد الإنشاء</option>
            <option value="1">مكتملة</option>
            <option value="2">مصححة</option>
            <option value="3">ملغية</option>
        </select>
    </div>
    <div class="col-md-3 d-flex align-items-end gap-2">
        <a href="/sales/new" class="btn btn-success w-100 d-inline-flex align-items-center justify-content-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                <path fill-rule="evenodd" d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2" />
            </svg>
            بيع جديد
        </a>
        <button class="btn btn-outline-secondary w-100 d-inline-flex align-items-center justify-content-center gap-1" @onclick="Reload">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2z" />
                <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466" />
            </svg>
            تحديث
        </button>
    </div>
</div>

@if (sales.Count == 0)
{
    <div class="alert alert-info">لا توجد مبيعات في الفترة المحددة.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>الرقم</th>
                    <th>التاريخ</th>
                    <th>الحالة</th>
                    <th class="text-center">الأصناف</th>
                    <th class="text-end">الإجمالي</th>
                    <th class="text-end">المدفوع</th>
                    <th class="text-end">المتبقي</th>
                    <th>طريقة الدفع</th>
                    <th>الكاشير</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sale in sales)
                {
                    <tr class="@(sale.Status == SaleStatus.Cancelled ? "table-danger" : sale.Status == SaleStatus.Corrected ? "table-warning" : "")">
                        <td class="font-monospace">@sale.Id.ToString("N")[..8].ToUpperInvariant()</td>
                        <td>@sale.SaleDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <span class="badge @GetStatusBadge(sale.Status)">@GetStatusText(sale.Status)</span>
                        </td>
                        <td class="text-center">@sale.Items.Count</td>
                        <td class="text-end fw-bold">@sale.Total.ToString("N2") د.ج</td>
                        <td class="text-end">@sale.Paid.ToString("N2") د.ج</td>
                        <td class="text-end @(sale.Remaining > 0 ? "text-danger" : "text-success") fw-bold">@sale.Remaining.ToString("N2") د.ج</td>
                        <td>@GetPaymentMethodText(sale.PaymentMethod)</td>
                        <td>@GetCashierName(sale.CashierId)</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-primary" @onclick="() => ViewReceipt(sale.Id)" title="عرض الإيصال">
                                    <WizzIcon Icon="eye" Size="16" Title="عرض الإيصال" />
                                </button>
                                <button class="btn btn-outline-secondary" @onclick="() => PrintReceipt(sale.Id)" title="طباعة">
                                    <WizzIcon Icon="printer" Size="16" Title="طباعة" />
                                </button>
                                @if (sale.Status == SaleStatus.Completed && !sale.IsModified)
                                {
                                    <button class="btn btn-outline-warning" @onclick="() => ModifySale(sale.Id)" title="تعديل">
                                        <WizzIcon Icon="edit" Size="16" Title="تعديل" />
                                    </button>
                                    <button class="btn btn-outline-danger" @onclick="() => OpenCancelSale(sale.Id)" title="إلغاء">
                                        <WizzIcon Icon="ban" Size="16" Title="إلغاء" />
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav aria-label="صفحات">
        <ul class="pagination justify-content-center">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <button type="button" class="page-link" disabled="@(currentPage == 1)" @onclick="() => ChangePage(currentPage - 1)">السابق</button>
            </li>
            <li class="page-item disabled"><span class="page-link">صفحة @currentPage من @totalPages</span></li>
            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                <button type="button" class="page-link" disabled="@(currentPage >= totalPages)" @onclick="() => ChangePage(currentPage + 1)">التالي</button>
            </li>
        </ul>
    </nav>
}

@if (modifyingSaleId.HasValue && saleBeingModified != null && editLines.Count > 0)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">تعديل البيع — @saleBeingModified.Id.ToString("N")[..8].ToUpperInvariant()</h5>
                    <button type="button" class="btn-close" @onclick="CloseModifySale"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info small mb-3">
                        <strong>ماذا سيحدث:</strong> سيتم تعديل هذه البيعة في مكانها. سيُحسب فرق الكميات بين ما كان وما أصبح وسيُعدّل رصيد المخزون تلقائياً (زيادة الكمية تُخصم من المخزون، نقص الكمية يُعاد للمخزون). ستُضاف ملاحظة التعديل مع التاريخ ومن قام بالتعديل.
                    </div>
                    <div class="mb-3">
                        <label class="form-label">ملاحظة التعديل <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" @bind="modificationNote" placeholder="مثال: تعديل الكمية، خطأ في السعر، إلخ" />
                    </div>
                    <div class="table-responsive mb-3">
                        <table class="table table-sm table-bordered">
                            <thead class="table-light">
                                <tr>
                                    <th>المنتج</th>
                                    <th class="text-center">الوحدة</th>
                                    <th class="text-center">الكمية</th>
                                    <th class="text-end">السعر</th>
                                    <th class="text-end">الإجمالي</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in editLines)
                                {
                                    <tr>
                                        <td>@line.ProductName</td>
                                        <td class="text-center">@line.UnitSymbol</td>
                                        <td class="text-center">
                                            <input type="number" step="0.01" min="0" class="form-control form-control-sm text-center"
                                                   @bind="line.Quantity" />
                                        </td>
                                        <td class="text-end">@line.UnitPrice.ToString("N2") د.ج</td>
                                        <td class="text-end fw-bold">@line.LineTotal.ToString("N2") د.ج</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModifySale">إلغاء</button>
                    <button type="button" class="btn btn-warning" @onclick="SubmitModifySale" disabled="@savingModification">
                        @if (savingModification) { <span class="spinner-border spinner-border-sm me-2"></span> }
                        تأكيد التعديل
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (cancellingSaleId.HasValue)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">إلغاء البيع</h5>
                    <button type="button" class="btn-close" @onclick="CloseCancelSale"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning small">سيُلغى البيع ويُعاد المخزون تلقائياً مع تسجيل حركة الإلغاء.</div>
                    <div class="mb-3">
                        <label class="form-label">سبب الإلغاء <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" @bind="cancellationReason" placeholder="أدخل سبب الإلغاء" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseCancelSale">إلغاء</button>
                    <button type="button" class="btn btn-danger" @onclick="SubmitCancelSale" disabled="@savingCancellation">
                        @if (savingCancellation) { <span class="spinner-border spinner-border-sm me-2"></span> }
                        تأكيد الإلغاء
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (receipt != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">إيصال @receipt.SaleNumber</h5>
                    <button type="button" class="btn-close" @onclick="() => receipt = null"></button>
                </div>
                <div class="modal-body">
                    <div class="text-center mb-2">
                        <strong>@receipt.Store.Name</strong><br />
                        <small class="text-muted">@receipt.Store.Address</small><br />
                        <small class="text-muted">@receipt.Store.Phone</small>
                    </div>
                    <div class="d-flex justify-content-between small text-muted">
                        <span>@receipt.SaleDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                        <span>@GetPaymentMethodText((Wizz.Domain.PaymentMethod)receipt.PaymentMethod)</span>
                    </div>
                    <hr />
                    <table class="table table-sm">
                        <tbody>
                            @foreach (var line in receipt.Lines)
                            {
                                <tr>
                                    <td>@line.ProductName</td>
                                    <td class="text-center">@line.Quantity.ToString("0.###") @line.UnitSymbol</td>
                                    <td class="text-end">@line.LineTotal.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <hr />
                    <div class="d-flex justify-content-between"><span>المجموع</span><span>@receipt.Subtotal.ToString("N2") د.ج</span></div>
                    <div class="d-flex justify-content-between text-success"><span>الخصم</span><span>@receipt.Discount.ToString("N2") د.ج</span></div>
                    <div class="d-flex justify-content-between fw-bold"><span>الإجمالي</span><span>@receipt.Total.ToString("N2") د.ج</span></div>
                    <div class="d-flex justify-content-between"><span>المدفوع</span><span>@receipt.Paid.ToString("N2") د.ج</span></div>
                    @if (receipt.Remaining > 0)
                    {
                        <div class="d-flex justify-content-between text-danger fw-bold"><span>المتبقي</span><span>@receipt.Remaining.ToString("N2") د.ج</span></div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => receipt = null">إغلاق</button>
                    <button class="btn btn-primary" @onclick="() => PrintReceipt(receipt.SaleId)">
                        <WizzIcon Icon="printer" Size="16" />
                        <span>طباعة</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private DateTime fromDate = DateTime.Today.AddDays(-30);
    private DateTime toDate = DateTime.Today;
    private string statusFilter = "";
    private List<Sale> sales = new();
    private Dictionary<Guid, string> cashierNames = new();
    private Wizz.Application.DTOs.ReceiptDto? receipt;
    private int currentPage = 1;
    private int pageSize = 20;
    private int totalPages = 1;
    private Guid? currentUserId;

    private Guid? modifyingSaleId;
    private Sale? saleBeingModified;
    private string modificationNote = "";
    private bool savingModification;

    private List<EditLineInput> editLines = new();

    private sealed class EditLineInput
    {
        public Guid ProductId { get; set; }
        public Guid UnitId { get; set; }
        public decimal Quantity { get; set; }
        public bool UseWholesalePrice { get; set; }
        public string ProductName { get; set; } = "";
        public string UnitSymbol { get; set; } = "";
        public decimal UnitPrice { get; set; }
        public decimal LineTotal { get; set; }
    }

    private Guid? cancellingSaleId;
    private string cancellationReason = "";
    private bool savingCancellation;

    protected override async Task OnInitializedAsync()
    {
        var users = await UserRepo.GetAllAsync();
        cashierNames = users.ToDictionary(u => u.Id, u => u.FullName);
        currentUserId = users.FirstOrDefault(u => u.IsActive && u.Role == UserRole.Admin)?.Id
                        ?? users.FirstOrDefault(u => u.IsActive)?.Id;

        await LoadSales();
    }

    private async Task Reload()
    {
        currentPage = 1;
        await LoadSales();
    }

    private async Task LoadSales()
    {
        // نطاق محلي كامل اليوم يُحوَّل إلى UTC لأن الطوابع الزمنية تُحفظ بـ UTC.
        var from = fromDate.Date.ToUniversalTime();
        var to = toDate.Date.AddDays(1).ToUniversalTime();

        var allSales = await SaleRepo.GetByDateRangeAsync(from, to);

        if (!string.IsNullOrEmpty(statusFilter) && Enum.TryParse<SaleStatus>(statusFilter, out var status))
        {
            allSales = allSales.Where(s => s.Status == status).ToList();
        }

        allSales = allSales.OrderByDescending(s => s.SaleDate).ToList();

        totalPages = Math.Max(1, (int)Math.Ceiling((double)allSales.Count / pageSize));
        currentPage = Math.Clamp(currentPage, 1, totalPages);

        sales = allSales.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
    }

    private async Task ChangePage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            await LoadSales();
        }
    }

    private async Task ViewReceipt(Guid saleId)
    {
        var result = await GenerateReceiptUseCase.ExecuteAsync(saleId);
        if (!result.IsSuccess)
        {
            await JS.InvokeVoidAsync("alert", $"تعذر عرض الإيصال: {string.Join(" | ", result.Errors)}");
            return;
        }

        receipt = result.Value;
    }

    private async Task PrintReceipt(Guid saleId)
    {
        var result = await GenerateReceiptUseCase.ExecuteAsync(saleId);
        if (!result.IsSuccess)
        {
            await JS.InvokeVoidAsync("alert", $"تعذر توليد الإيصال: {string.Join(" | ", result.Errors)}");
            return;
        }

        var r = result.Value;
        var builder = new System.Text.StringBuilder();
        builder.AppendLine(r.Store.Name);
        builder.AppendLine(r.Store.Address ?? string.Empty);
        builder.AppendLine(new string('-', 32));
        builder.AppendLine($"إيصال: {r.SaleNumber} — {r.SaleDate.ToLocalTime():yyyy-MM-dd HH:mm}");
        builder.AppendLine(new string('-', 32));
        foreach (var line in r.Lines)
        {
            builder.AppendLine(line.ProductName);
            builder.AppendLine($"  {line.Quantity:0.###} {line.UnitSymbol} × {line.UnitPrice:N2} = {line.LineTotal:N2}");
        }

        builder.AppendLine(new string('-', 32));
        builder.AppendLine($"الإجمالي: {r.Total:N2} — المدفوع: {r.Paid:N2} — المتبقي: {r.Remaining:N2}");

        var printed = await Printer.PrintAsync(builder.ToString());
        await JS.InvokeVoidAsync("alert", printed
            ? $"تم إرسال الإيصال إلى: {Printer.DeviceName}"
            : "تعذرت الطباعة. تحقق من الطابعة.");
    }

    private void OpenModifySale(Guid saleId)
    {
        if (currentUserId is null)
        {
            JS.InvokeVoidAsync("alert", "لا يوجد مستخدم نشط لتنفيذ التعديل.");
            return;
        }

        var sale = sales.FirstOrDefault(s => s.Id == saleId);
        if (sale == null)
        {
            JS.InvokeVoidAsync("alert", "لم يتم العثور على البيع.");
            return;
        }

        modifyingSaleId = saleId;
        saleBeingModified = sale;
        modificationNote = "";

        editLines = sale.Items.Select(i => new EditLineInput
        {
            ProductId = i.ProductId,
            UnitId = i.UnitId,
            Quantity = i.Quantity,
            UseWholesalePrice = i.IsWholesalePrice,
            ProductName = i.Product?.Name ?? "منتج غير معروف",
            UnitSymbol = i.Unit?.Symbol ?? "وحدة",
            UnitPrice = i.UnitPrice,
            LineTotal = i.LineTotal
        }).ToList();
    }

    private void CloseModifySale()
    {
        modifyingSaleId = null;
        saleBeingModified = null;
        modificationNote = "";
        editLines = new();
        savingModification = false;
    }

    private async Task SubmitModifySale()
    {
        if (modifyingSaleId is null || currentUserId is null) return;
        if (string.IsNullOrWhiteSpace(modificationNote))
        {
            await JS.InvokeVoidAsync("alert", "ملاحظة التعديل مطلوبة");
            return;
        }

        var newLines = editLines.Select(l => new SaleLineInputDto(
            l.ProductId,
            l.UnitId,
            l.Quantity,
            l.UseWholesalePrice
        )).ToList();

        savingModification = true;
        try
        {
            var result = await ModifySaleUseCase.ExecuteAsync(
                modifyingSaleId.Value, newLines, modificationNote.Trim(), currentUserId.Value);

            await JS.InvokeVoidAsync("alert", result.IsSuccess
                ? "تم تعديل البيع في مكانه وتعديل رصيد المخزون حسب فرق الكميات. تمت إضافة ملاحظة التعديل مع التاريخ ومن قام بالتعديل."
                : $"تعذر التعديل: {string.Join(" | ", result.Errors)}");

            if (result.IsSuccess)
            {
                CloseModifySale();
            }
            await LoadSales();
        }
        finally
        {
            savingModification = false;
        }
    }

    private async Task ModifySale(Guid saleId)
    {
        OpenModifySale(saleId);
        await Task.CompletedTask;
    }

    private void OpenCancelSale(Guid saleId)
    {
        if (currentUserId is null)
        {
            JS.InvokeVoidAsync("alert", "لا يوجد مستخدم نشط لتنفيذ الإلغاء.");
            return;
        }

        cancellingSaleId = saleId;
        cancellationReason = "";
    }

    private void CloseCancelSale()
    {
        cancellingSaleId = null;
        cancellationReason = "";
        savingCancellation = false;
    }

    private async Task SubmitCancelSale()
    {
        if (cancellingSaleId is null || currentUserId is null) return;
        if (string.IsNullOrWhiteSpace(cancellationReason))
        {
            await JS.InvokeVoidAsync("alert", "سبب الإلغاء مطلوب");
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm", "هل أنت متأكد من إلغاء هذا البيع؟ لا يمكن التراجع.");
        if (!confirmed)
        {
            return;
        }

        savingCancellation = true;
        try
        {
            var result = await CancelSaleUseCase.ExecuteAsync(cancellingSaleId.Value, cancellationReason.Trim(), currentUserId.Value);
            await JS.InvokeVoidAsync("alert", result.IsSuccess
                ? "تم إلغاء البيع."
                : $"تعذر الإلغاء: {string.Join(" | ", result.Errors)}");

            if (result.IsSuccess)
            {
                CloseCancelSale();
            }
            await LoadSales();
        }
        finally
        {
            savingCancellation = false;
        }
    }

    private async Task CancelSale(Guid saleId)
    {
        OpenCancelSale(saleId);
        await Task.CompletedTask;
    }

    private string GetCashierName(Guid? cashierId) =>
        cashierId.HasValue && cashierNames.TryGetValue(cashierId.Value, out var name) ? name : "—";

    private static string GetStatusBadge(SaleStatus status) => status switch
    {
        SaleStatus.Pending => "bg-secondary",
        SaleStatus.Completed => "bg-success",
        SaleStatus.Corrected => "bg-warning text-dark",
        SaleStatus.Cancelled => "bg-danger",
        _ => "bg-secondary",
    };

    private static string GetStatusText(SaleStatus status) => status switch
    {
        SaleStatus.Pending => "قيد الإنشاء",
        SaleStatus.Completed => "مكتملة",
        SaleStatus.Corrected => "مصححة",
        SaleStatus.Cancelled => "ملغية",
        _ => "غير معروف",
    };

    private static string GetPaymentMethodText(Wizz.Domain.PaymentMethod method) => method switch
    {
        Wizz.Domain.PaymentMethod.Cash => "نقدي",
        Wizz.Domain.PaymentMethod.Card => "بطاقة",
        Wizz.Domain.PaymentMethod.Credit => "آجل",
        Wizz.Domain.PaymentMethod.Mobile => "محمول",
        Wizz.Domain.PaymentMethod.Mixed => "مختلط",
        _ => "—",
    };
}
