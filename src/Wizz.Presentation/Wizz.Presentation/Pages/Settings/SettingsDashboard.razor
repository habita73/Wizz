    private async Task SaveStoreSettings()
    {
        if (!await EnsurePermissionAsync(
                Permission.ManageStoreSettings,
                "محاولة حفظ إعدادات المتجر دون صلاحية",
                "Store",
                store?.Id.ToString()))
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(storeForm.Name))
        {
            await JS.InvokeVoidAsync("alert", "اسم المتجر مطلوب");
            return;
        }

        if (storeForm.CashDifferenceTolerance < 0 ||
            decimal.Round(storeForm.CashDifferenceTolerance, 2, MidpointRounding.ToZero) != storeForm.CashDifferenceTolerance)
        {
            await JS.InvokeVoidAsync("alert", "حدّ فرق الصندوق يجب ألا يكون سالبًا ويقبل منزلتين عشريتين على الأكثر");
            return;
        }

        savingStore = true;
        try
        {
            if (store == null)
            {
                var created = new Store(
                    storeForm.Name,
                    storeForm.Address,
                    storeForm.Phone,
                    storeForm.TaxNumber,
                    storeForm.CommercialRegister,
                    storeForm.AllowCreditSales,
                    string.IsNullOrWhiteSpace(storeForm.Currency) ? "DZD" : storeForm.Currency,
                    inventoryEnabled: storeForm.InventoryEnabled,
                    cashDrawerEnabled: storeForm.CashDrawerEnabled,
                    cashDifferenceTolerance: storeForm.CashDifferenceTolerance);
                await StoreRepo.AddAsync(created);
            }
            else
            {
                store.UpdateSettings(
                    storeForm.Name,
                    storeForm.Address,
                    storeForm.Phone,
                    storeForm.TaxNumber,
                    storeForm.CommercialRegister,
                    storeForm.AllowCreditSales,
                    storeForm.Currency,
                    inventoryEnabled: storeForm.InventoryEnabled,
                    cashDrawerEnabled: storeForm.CashDrawerEnabled,
                    cashDifferenceTolerance: storeForm.CashDifferenceTolerance);
                StoreRepo.Update(store);
            }

            await UnitOfWork.SaveChangesAsync();
            await Audit.LogAsync(new AuditEntry(
                AuditAction.StoreSettingsUpdated,
                AuditOutcome.Success,
                await CurrentUser.IdAsync(),
                await CurrentUser.UsernameAsync(),
                "Store",
                store?.Id.ToString(),
                $"اسم المتجر: {storeForm.Name} — عملة: {storeForm.Currency} — بيع آجل: {storeForm.AllowCreditSales} — تتبع مخزون: {storeForm.InventoryEnabled} — صندوق: {storeForm.CashDrawerEnabled} — حد الفرق: {storeForm.CashDifferenceTolerance.ToString("N2")}"));
            showStoreModal = false;
            await LoadStore();
            await JS.InvokeVoidAsync("alert", "تم حفظ إعدادات المتجر بنجاح");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"خطأ: {ex.Message}");
        }
        finally
        {
            savingStore = false;
        }
    }

