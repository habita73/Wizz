@page "/settings"
@layout MainLayout
@inject Wizz.Application.Abstractions.IStoreRepository StoreRepo
@inject Wizz.Application.Abstractions.IUserRepository UserRepo
@inject Wizz.Application.Abstractions.IBackupService BackupService
@inject Wizz.Application.Abstractions.IUnitOfWork UnitOfWork
@inject Wizz.Application.Abstractions.IAiSettingsProvider AiSettings
@inject Wizz.Application.Abstractions.IDeviceCapabilityEvaluator DeviceEvaluator
@inject Wizz.Application.Abstractions.IModelRouter ModelRouter
@inject Wizz.Presentation.Pages.AI.AiMemoryStore MemoryStore
@inject IJSRuntime JS

<h2>
    <svg class="svg-icon svg-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="3"/>
        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2v-1a2 2 0 0 1-2-2v-5a1.65 1.65 0 0 0-1-1.51l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H19a1.65 1.65 0 0 0 1.5-1 1.65 1.65 0 0 0-.33-1Z"/>
        <line x1="12" y1="15" x2="12.01" y2="15"/>
    </svg>
    الإعدادات
</h2>

<div class="row">
    <!-- إعدادات المتجر -->
    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header"><h5 class="mb-0"><svg class="svg-icon svg-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="12" y1="3" x2="12" y2="21"/></svg> إعدادات المتجر</h5></div>
            <div class="card-body">
                @if (store == null)
                {
                    <div class="alert alert-warning">لم يتم إعداد المتجر بعد.</div>
                    <button class="btn btn-primary" @onclick="() => showStoreModal = true">إعداد المتجر</button>
                }
                else
                {
                    <div class="mb-3">
                        <label class="form-label">اسم المتجر <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" @bind="storeForm.Name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">العنوان</label>
                        <textarea class="form-control" rows="2" @bind="storeForm.Address"></textarea>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">الهاتف</label>
                            <input type="text" class="form-control" @bind="storeForm.Phone" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">العملة</label>
                            <input type="text" class="form-control" maxlength="3" @bind="storeForm.Currency" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">الرقم الضريبي (NIF)</label>
                            <input type="text" class="form-control" @bind="storeForm.TaxNumber" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">السجل التجاري</label>
                            <input type="text" class="form-control" @bind="storeForm.CommercialRegister" />
                        </div>
                    </div>
                    <div class="form-check mb-3">
                        <input type="checkbox" class="form-check-input" id="allowCredit" @bind="storeForm.AllowCreditSales" />
                        <label class="form-check-label" for="allowCredit">السماح بالبيع الآجل (الدين)</label>
                    </div>
                    <button type="button" class="btn btn-primary" @onclick="SaveStoreSettings" disabled="@savingStore">
                        @if (savingStore)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        حفظ الإعدادات
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- المستخدمون -->
    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0 d-flex align-items-center gap-2">
                    <WizzIcon Icon="users" Size="18" />
                    <span>المستخدمون</span>
                </h5>
                <button class="btn btn-sm btn-success" @onclick="NewUser">
                    <WizzIcon Icon="plus" Size="14" />
                    <span>مستخدم</span>
                </button>
            </div>
            <div class="card-body">
                @if (users.Count == 0)
                {
                    <div class="alert alert-info mb-0">لا يوجد مستخدمون.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>اسم المستخدم</th>
                                    <th>الاسم الكامل</th>
                                    <th>الدور</th>
                                    <th>الحالة</th>
                                    <th>آخر دخول</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in users)
                                {
                                    <tr>
                                        <td>@user.Username</td>
                                        <td>@user.FullName</td>
                                        <td><span class="badge @GetRoleBadge(user.Role)">@GetRoleText(user.Role)</span></td>
                                        <td>
                                            <span class="badge @(user.IsActive ? "bg-success" : "bg-secondary")">
                                                @(user.IsActive ? "نشط" : "معطل")
                                            </span>
                                        </td>
                                        <td>@(user.LastLoginAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-primary" title="تعديل" @onclick="() => EditUser(user)">
                                                    <WizzIcon Icon="edit" Size="16" Title="تعديل" />
                                                </button>
                                                <button class="btn btn-outline-warning" title="إعادة تعيين كلمة المرور" @onclick="() => ResetPassword(user)">
                                                    <WizzIcon Icon="key" Size="16" Title="إعادة تعيين كلمة المرور" />
                                                </button>
                                                <button class="btn btn-outline-@(user.IsActive ? "danger" : "success")"
                                                        title="@(user.IsActive ? "تعطيل" : "تفعيل")"
                                                        @onclick="() => ToggleUserActive(user)">
                                                    <WizzIcon Icon="@(user.IsActive ? "ban" : "check-circle")" Size="16" Title="@(user.IsActive ? "تعطيل" : "تفعيل")" />
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- النسخ الاحتياطي -->
    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0 d-flex align-items-center gap-2">
                    <WizzIcon Icon="save" Size="18" />
                    <span>النسخ الاحتياطي</span>
                </h5>
                <button class="btn btn-sm btn-primary" @onclick="CreateBackup" disabled="@backupInProgress">
                    @if (backupInProgress)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    نسخة جديدة
                </button>
            </div>
            <div class="card-body">
                @if (backups.Count == 0)
                {
                    <div class="alert alert-info mb-0">لا توجد نسخ احتياطية.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>الوصف</th>
                                    <th>التاريخ</th>
                                    <th class="text-end">الحجم</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var backup in backups)
                                {
                                    <tr>
                                        <td>@backup.Description</td>
                                        <td>@backup.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                        <td class="text-end">@FormatBytes(backup.SizeBytes)</td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-success" title="استعادة" @onclick="() => RestoreBackup(backup.Path)">
                                                    <WizzIcon Icon="undo" Size="16" Title="استعادة" />
                                                </button>
                                                <button class="btn btn-outline-danger" title="حذف" @onclick="() => DeleteBackup(backup.Path)">
                                                    <WizzIcon Icon="trash" Size="16" Title="حذف" />
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- معلومات النظام -->
    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="mb-0 d-flex align-items-center gap-2">
                    <WizzIcon Icon="info" Size="18" />
                    <span>معلومات النظام</span>
                </h5>
            </div>
            <div class="card-body">
                <table class="table table-sm table-borderless mb-0">
                    <tbody>
                        <tr><td>إصدار التطبيق</td><td class="text-end fw-bold">0.1.0</td></tr>
                        <tr><td>إطار العمل</td><td class="text-end">.NET 10 / Blazor Server</td></tr>
                        <tr><td>قاعدة البيانات</td><td class="text-end">SQLite (wizz.db)</td></tr>
                        <tr><td>الذكاء الاصطناعي</td><td class="text-end">مدمج محلياً</td></tr>
                        <tr><td>اللغة</td><td class="text-end">العربية (RTL)</td></tr>
                        <tr><td>الترخيص</td><td class="text-end">MIT</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- إعدادات الذكاء الاصطناعي (بسيط) -->
    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0 d-flex align-items-center gap-2"><WizzIcon Icon="sparkles" Size="18" /><span>المساعد الذكي</span></h5>
                <span class="badge @(aiCloudEnabled ? "bg-success" : "bg-secondary")">
                    @(aiCloudEnabled ? "سحابي مجاني مفعل" : "محلي فقط")
                </span>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="aiCloud" @bind="aiCloudEnabled" />
                        <label class="form-check-label" for="aiCloud">
                            تفعيل المساعد الذكي المجاني عبر الإنترنت (اختياري)
                        </label>
                    </div>
                    <div class="form-text">
                        إذا فعّلت هذا الخيار، سيساعدك المساعد في الإجابة عن الأسئلة المعقدة باستخدام خدمة سحابية مجانية.
                        إذا لم تُفعّله، سيعمل المساعد من بيانات متجرك محلياً دون إنترنت.
                    </div>
                </div>

                @if (aiCloudEnabled)
                {
                    <div class="mb-3">
                        <label class="form-label">مفتاح API (اختياري - للصق من OpenRouter)</label>
                        <div class="input-group">
                            <input type="password" class="form-control" @bind="cloudApiKey" placeholder="sk-or-... (اختياري)" />
                            <span class="input-group-text">
                                <a href="https://openrouter.ai" target="_blank" rel="noopener noreferrer" class="text-decoration-none">
                                    <WizzIcon Icon="link" Size="14" /> احصل على مفتاح مجاني
                                </a>
                            </span>
                        </div>
                        <div class="form-text">
                            انسخ المفتاح من OpenRouter (يبدأ بـ <code>sk-or-...</code>) والصقه هنا.
                            <a href="https://openrouter.ai" target="_blank" rel="noopener noreferrer">مجاني، لا بطاقة بنكية</a>.
                        </div>
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label">مستوى المساعد المحلي حسب جهازك</label>
                    <select class="form-select form-select-sm" @bind="localModelLevel">
                        <option value="light">خفيف (للأجهزة الضعيفة - 4 جيجابايت ذاكرة)</option>
                        <option value="medium">متوسط (للأجهزة العادية - 8 جيجابايت ذاكرة أو أكثر)</option>
                    </select>
                    <div class="form-text">
                        اختر المستوى الذي يناسب جهازك. المستوى الخفيف أسرع ولا يبطئ جهاز البيع.
                    </div>
                    @if (loadingDevice)
                    {
                        <div class="alert alert-info py-2 small mb-3">
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            جارٍ قياس قدرة الجهاز…
                        </div>
                    }
                    else if (deviceAssessment is not null)
                    {
                        <div class="alert alert-info py-2 small mb-3">
                            <strong>قدرة الجهاز:</strong> @DeviceTierText(deviceAssessment.Tier)
                            <span class="text-muted ms-1"
                                  title="مستوى الجهاز يُقاس من الذاكرة المتاحة، ويحدّد النموذج المحلي المقترح تلقائياً."><WizzIcon Icon="help" Size="14" /></span>
                            <div class="text-muted mt-1">@deviceAssessment.Reason</div>
                        </div>
                    }
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        النموذج المحلي المفضّل
                        <span class="text-muted" title="النموذج الذي يستخدمه Ollama داخل المتجر. اختر النموذج ثم اضغط «تطبيق». نسخ «coder» غير مخصصة للمحادثة العربية."><WizzIcon Icon="help" Size="14" /></span>
                    </label>
                    <div class="input-group input-group-sm">
                        <select class="form-select" @bind="preferredLocalModel" disabled="@(localModels.Count == 0)">
                            @if (localModels.Count == 0)
                            {
                                <option value="">لا توجد نماذج مثبتة</option>
                            }
                            else
                            {
                                @foreach (var m in localModels)
                                {
                                    <option value="@m">@m</option>
                                }
                            }
                        </select>
                        <button class="btn btn-outline-secondary" title="تحديث قائمة النماذج المثبتة"
                                @onclick="RefreshLocalModels" disabled="@loadingLocalModels">
                            @if (loadingLocalModels)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                            }
                            else
                            {
                                <WizzIcon Icon="refresh" Size="14" />
                            }
                        </button>
                        <button class="btn btn-outline-primary" title="تفعيل النموذج المختار"
                                @onclick="ApplyLocalModel"
                                disabled="@(applyingLocalModel || string.IsNullOrWhiteSpace(preferredLocalModel))">
                            @(applyingLocalModel ? "…" : "تطبيق")
                        </button>
                    </div>
                    <div class="form-text">
                        نماذج عربية مناسبة: <code>qwen2.5:1.5b</code> (متوازن) أو <code>qwen2.5:0.5b-instruct</code> (خفيف للأجهزة الضعيفة).
                    </div>
                </div>

                @if (localModels.Count == 0)
                {
                    <div class="alert alert-warning">
                        <strong>Ollama غير متاح</strong> — لكن المساعد المدمج يعمل بشكل طبيعي بدونه.
                        <ol class="mb-0 mt-2 ps-3">
                            <li>ثبّت Ollama من <code>ollama.com</code></li>
                            <li><code>ollama pull qwen2.5:0.5b-instruct</code></li>
                            <li>أعد تشغيل التطبيق أو اضغط زر التحديث</li>
                        </ol>
                    </div>
                }
                else
                {
                    <div class="alert alert-success">
                        متصل بـ Ollama — @localModels.Count نموذج مثبّت.
                    </div>
                }

                <div class="alert alert-info">
                    <strong>مهم:</strong> البيع والمخزون والمال تعمل دائماً حتى لو كان المساعد الذكي غير متاح.
                    لا تُرسل أي بيانات من متجرك إلى الإنترنت إلا إذا فعّلت الخيار أعلاه.
                </div>

                <div class="card card-body bg-light mt-3 border">
                    <h6 class="mb-2"><WizzIcon Icon="key" Size="16" /> للحصول على مفتاح مجاني (اختياري):</h6>
                    <div class="mb-2">
                        <a href="https://openrouter.ai" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary btn-sm">
                            <WizzIcon Icon="globe" Size="14" /> فتح OpenRouter (مجاني)
                        </a>
                    </div>
                    <div class="small text-muted">
                        <ol class="mb-0 ps-3">
                            <li>اضغط الزر أعلاه ← يسجّل دخول بحساب Google أو GitHub (مجاني، لا بطاقة بنكية)</li>
                            <li>من القائمة الشخصية (أعلى اليمين) اختر <strong>Keys</strong></li>
                            <li>اضغط <strong>Create Key</strong> ← انسخ المفتاح (يبدأ بـ <code>sk-or-...</code>)</li>
                            <li>الصقه هنا ← احفظ ← المساعد يصبح أقوى للأسئلة المعقدة</li>
                        </ol>
                        <div class="text-success small mt-1">
                            <WizzIcon Icon="check-circle" Size="14" /> مجاني تماماً — لا بطاقة بنكية — نماذج عربية مجانية متاحة (Qwen، Gemma، Llama...)
                        </div>
                    </div>
                </div>

                <div class="alert alert-secondary py-2 small">
                    <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
                        <span>
                            <strong>حالة المساعد:</strong> @routerStatusSummary
                            @if (loadingAiStatus)
                            {
                                <span class="spinner-border spinner-border-sm ms-2" role="status"></span>
                            }
                        </span>
                        <span class="d-flex align-items-center gap-1">
                            <span class="badge bg-success" title="المساعد المدمج — يعمل دائماً بلا إنترنت">المدمج</span>
                            <span class="badge @(routerStatus?.LocalAvailable == true ? "bg-success" : "bg-secondary")"
                                  title="النموذج المحلي (Ollama)">محلي</span>
                            <span class="badge @(routerStatus?.CloudAvailable == true ? "bg-success" : "bg-secondary")"
                                  title="النموذج السحابي (اختياري)">سحابي</span>
                            <span class="badge bg-primary" title="عدد المسارات المتاحة">@((routerStatus?.RouteCount ?? 1))</span>
                        </span>
                    </div>
                </div>

                <hr />

                <h6 class="mb-2 d-flex align-items-center gap-2"><WizzIcon Icon="brain" Size="16" /><span>تفضيلات المساعد</span></h6>

                <div class="mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="aiRememberContext" @bind="rememberContext" />
                        <label class="form-check-label" for="aiRememberContext">
                            حفظ سياق المحادثة
                            <span class="text-muted" title="عند التفعيل يتذكّر المساعد آخر منتج سألت عنه فيجيب عن «كم سعره؟». كل شيء محفوظ على جهازك فقط ويمكن مسحه من صفحة المساعد."><WizzIcon Icon="help" Size="14" /></span>
                        </label>
                    </div>
                    <div class="form-text">
                        يتذكّر المساعد آخر منتج سألت عنه فيجيب عن أسئلة المتابعة مثل «كم سعره؟». البيانات محفوظة على جهازك فقط،
                        ويمكن مسحها بزر «مسح الذاكرة» في صفحة المساعد.
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">السعر الذي يظهر أولاً في الإجابات</label>
                    <select class="form-select form-select-sm" @bind="priceMode">
                        <option value="Retail">سعر التجزئة</option>
                        <option value="Wholesale">سعر الجملة</option>
                    </select>
                    <div class="form-text">يحدّد أيّ سعر يُعرض أولاً حين يسألك المستخدم عن سعر منتج.</div>
                </div>

                <div class="mb-3">
                    <label class="form-label">وحدة القياس المفضّلة (اختياري)</label>
                    <input type="text" class="form-control form-control-sm" @bind="preferredUnit" placeholder="مثال: كجم أو لتر" />
                    <div class="form-text">تظهر منتجات هذه الوحدة أولاً في قوائم المنتجات التي يعرضها المساعد.</div>
                </div>

                <div class="mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="aiInternetAccess" @bind="allowInternetAccess" />
                        <label class="form-check-label" for="aiInternetAccess">
                            السماح للمساعد المدمج بالبحث في الإنترنت عند الطلب
                            <span class="text-muted" title="مغلق افتراضياً. عند التفعيل فقط، وإذا كتبت «ابحث عن…» أو «من هو…»، تُرسل كلمات سؤالك إلى خدمة بحث عامة. أسئلة متجرك لا تُرسل أبداً."><WizzIcon Icon="help" Size="14" /></span>
                        </label>
                    </div>
                    <div class="form-text">
                        <strong>مغلق افتراضياً</strong> — المساعد يعمل كاملاً دون إنترنت. عند التفعيل، اسأل صراحةً مثل «ابحث عن تاريخ الجزائر»
                        أو «من هو ابن باديس؟» فتُرسل كلمات سؤالك إلى خدمة بحث عامة (ويكيبيديا / DuckDuckGo) ويظهر المصدر مع الإجابة.
                        أسئلة المبيعات والديون والأسعار والمنتجات <strong>لا تُرسل إلى الإنترنت أبداً</strong>.
                    </div>
