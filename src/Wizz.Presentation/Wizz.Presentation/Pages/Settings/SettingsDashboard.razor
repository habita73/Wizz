                <div class="d-flex gap-2 mb-3">
                    <button class="btn btn-outline-primary btn-sm flex-fill" @onclick="SaveAiPreferences"><WizzIcon Icon="save" Size="14" /> حفظ التفضيلات</button>
                    <button class="btn btn-outline-secondary btn-sm flex-fill" @onclick="ResetAiPreferences"><WizzIcon Icon="refresh" Size="14" /> الافتراضي</button>
