@page "/settings"
@layout MainLayout
@attribute [Authorize(Policy = PermissionPolicy.ManageStoreSettings)]
@rendermode InteractiveServer
@inject Wizz.Application.Abstractions.IStoreRepository StoreRepo
@inject Wizz.Application.Abstractions.IUserRepository UserRepo
@inject Wizz.Application.Abstractions.IBackupService BackupService
@inject Wizz.Application.Abstractions.IUnitOfWork UnitOfWork
@inject Wizz.Application.Abstractions.IAiSettingsProvider AiSettings
@using Wizz.Application.AI.Privacy
@inject Wizz.Application.Abstractions.IDeviceCapabilityEvaluator DeviceEvaluator
@inject Wizz.Application.Abstractions.IModelRouter ModelRouter
@inject Wizz.Application.AI.IFreeModelCatalogService ModelCatalog
@inject Wizz.Presentation.Pages.AI.AiMemoryStore MemoryStore
@inject CurrentUser CurrentUser
@inject SafeAudit Audit
@inject IJSRuntime JS
@using Wizz.Application.Modules
@inject Wizz.Application.UseCases.Modules.GetModulesUseCase GetModules
@inject Wizz.Application.UseCases.Modules.SetModuleEnabledUseCase SetModuleEnabled

<h2>
    <svg class="svg-icon svg-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="3"/>
        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2v-1a2 2 0 0 1-2-2v-5a1.65 1.65 0 0 0-1-1.51l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H19a1.65 1.65 0 0 0 1.5-1 1.65 1.65 0 0 0-.33-1Z"/>
        <line x1="12" y1="15" x2="12.01" y2="15"/>
    </svg>
    الإعدادات
</h2>

<div class="wizz-settings-hint">
    <span class="wizz-settings-hint-icon"><WizzIcon Icon="settings" Size="18" /></span>
    <p>
        المظهر وحجم الخط وسهولة القراءة واختصارات لوحة المفاتيح صارت في الإعدادات السريعة،
        تُعدَّل دون مغادرة هذه الصفحة أو فقدان أي تغيير غير محفوظ.
    </p>
    <button type="button" class="btn btn-sm btn-outline-primary" data-wizz-qs-open>
        <WizzIcon Icon="settings" Size="16" />
        <span>فتح الإعدادات السريعة</span>
    </button>
</div>

<div class="wizz-settings-toolbar">
    <span class="wizz-settings-toolbar-title">المجموعات المفتوحة: @ExpandedCardCount من @VisibleCardCount</span>
    <div class="btn-group btn-group-sm" role="group" aria-label="طي أو توسيع كل المجموعات">
        <button type="button" class="btn btn-outline-secondary" @onclick="ExpandAllCards">توسيع الكل</button>
        <button type="button" class="btn btn-outline-secondary" @onclick="CollapseAllCards">طي الكل</button>
    </div>
</div>

<div class="row g-4 wizz-settings-grid">
    <!-- إعدادات المتجر -->
    <div class="col-12 col-md-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0 d-flex align-items-center gap-2">
                    <svg class="svg-icon svg-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="12" y1="3" x2="12" y2="21"/></svg>
                    <span>إعدادات المتجر</span>
                </h5>
                <button type="button" class="wizz-settings-toggle"
                        @onclick="ToggleStoreCard"
                        aria-expanded="@(!IsCollapsed("store") ? "true" : "false")"
                        aria-controls="settings-card-store"
                        title="@(IsCollapsed("store") ? "توسيع إعدادات المتجر" : "طي إعدادات المتجر")">
                    <WizzIcon Icon="@(IsCollapsed("store") ? "chevron-down" : "chevron-up")" Size="16" />
                </button>
            </div>
            <div id="settings-card-store" class="@CardBodyClass("store")">
                @if (store == null)
                {
                    <div class="alert alert-warning">لم يتم إعداد المتجر بعد.</div>
                    <button class="btn btn-primary" @onclick="() => showStoreModal = true">إعداد المتجر</button>
                }
                else
                {
                    <div class="mb-3">
                        <label class="form-label">اسم المتجر <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" @bind="storeForm.Name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">العنوان</label>
                        <textarea class="form-control" rows="2" @bind="storeForm.Address"></textarea>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">الهاتف</label>
                            <input type="text" class="form-control" @bind="storeForm.Phone" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">العملة</label>
                            <input type="text" class="form-control" maxlength="3" @bind="storeForm.Currency" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">الرقم الضريبي (NIF)</label>
                            <input type="text" class="form-control" @bind="storeForm.TaxNumber" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">السجل التجاري</label>
                            <input type="text" class="form-control" @bind="storeForm.CommercialRegister" />
                        </div>
                    </div>
                    <div class="form-check mb-3">
                        <input type="checkbox" class="form-check-input" id="allowCredit" @bind="storeForm.AllowCreditSales" />
                        <label class="form-check-label" for="allowCredit">السماح بالبيع الآجل (الدين)</label>
                    </div>
                    <div class="form-check mb-3">
                        <input type="checkbox" class="form-check-input" id="inventoryEnabled" @bind="storeForm.InventoryEnabled" />
                        <label class="form-check-label" for="inventoryEnabled">تتبع المخزون (خصم تلقائي عند البيع)</label>
                        <div class="form-text">
                            عند التعطيل تعمل المبيعات دون خصم المخزون ولا تظهر تنبيهات النقص.
                        </div>
                    </div>
                    <div class="form-check mb-3">
                        <input type="checkbox" class="form-check-input" id="cashDrawerEnabled" @bind="storeForm.CashDrawerEnabled" />
                        <label class="form-check-label" for="cashDrawerEnabled">تفعيل وحدة الصندوق وعدّ النقدية</label>
                        <div class="form-text">
                            عند التعطيل يعود إغلاق الوردية إلى سلوكه السابق بلا عدّ نقدي.
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">حدّ فرق الصندوق المسموح به (د.ج)</label>
                        <input type="number" class="form-control" min="0" step="0.01" @bind="storeForm.CashDifferenceTolerance" />
                        <div class="form-text">
                            فرق الإغلاق الذي يتجاوز هذا الحد يتطلب ملاحظة؛ القيمة الافتراضية صفر.
                        </div>
                    </div>
                    <button type="button" class="btn btn-primary" @onclick="SaveStoreSettings" disabled="@savingStore">
                        @if (savingStore)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        حفظ الإعدادات
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- المستخدمون -->
    <AuthorizeView Policy="@PermissionPolicy.ManageUsers">
        <Authorized>
    <div class="col-12 col-md-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0 d-flex align-items-center gap-2">
                    <WizzIcon Icon="users" Size="18" />
                    <span>المستخدمون</span>
                </h5>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-success" @onclick="NewUser">
                        <WizzIcon Icon="plus" Size="14" />
                        <span>مستخدم</span>
                    </button>
                    <button type="button" class="wizz-settings-toggle"
                            @onclick="ToggleUsersCard"
                            aria-expanded="@(!IsCollapsed("users") ? "true" : "false")"
                            aria-controls="settings-card-users"
                            title="@(IsCollapsed("users") ? "توسيع المستخدمين" : "طي المستخدمين")">
                        <WizzIcon Icon="@(IsCollapsed("users") ? "chevron-down" : "chevron-up")" Size="16" />
                    </button>
                </div>
            </div>
            <div id="settings-card-users" class="@CardBodyClass("users")">
                @if (users.Count == 0)
                {
                    <div class="alert alert-info mb-0">لا يوجد مستخدمون.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>اسم المستخدم</th>
                                    <th>الاسم الكامل</th>
                                    <th>الدور</th>
                                    <th>الحالة</th>
                                    <th>آخر دخول</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in users)
                                {
                                    <tr>
                                        <td>@user.Username</td>
                                        <td>@user.FullName</td>
                                        <td><span class="badge @GetRoleBadge(user.Role)">@GetRoleText(user.Role)</span></td>
                                        <td>
                                            <span class="badge @(user.IsActive ? "bg-success" : "bg-secondary")">
                                                @(user.IsActive ? "نشط" : "معطل")
                                            </span>
                                        </td>
                                        <td>@(user.LastLoginAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-primary" title="تعديل" @onclick="() => EditUser(user)">
                                                    <WizzIcon Icon="edit" Size="16" Title="تعديل" />
                                                </button>
                                                <button class="btn btn-outline-warning" title="إعادة تعيين كلمة المرور" @onclick="() => ResetPassword(user)">
                                                    <WizzIcon Icon="key" Size="16" Title="إعادة تعيين كلمة المرور" />
                                                </button>
                                                <button class="btn btn-outline-@(user.IsActive ? "danger" : "success")"
                                                        title="@(user.IsActive ? "تعطيل" : "تفعيل")"
                                                        @onclick="() => ToggleUserActive(user)">
                                                    <WizzIcon Icon="@(user.IsActive ? "ban" : "check-circle")" Size="16" Title="@(user.IsActive ? "تعطيل" : "تفعيل")" />
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
        </Authorized>
    </AuthorizeView>

    <!-- النسخ الاحتياطي -->
    <AuthorizeView Policy="@PermissionPolicy.BackupRestore">
        <Authorized>
    <div class="col-12 col-md-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0 d-flex align-items-center gap-2">
                    <WizzIcon Icon="save" Size="18" />
                    <span>النسخ الاحتياطي</span>
                </h5>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-primary" @onclick="CreateBackup" disabled="@backupInProgress">
                        @if (backupInProgress)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        نسخة جديدة
                    </button>
                    <button type="button" class="wizz-settings-toggle"
                            @onclick="ToggleBackupCard"
                            aria-expanded="@(!IsCollapsed("backup") ? "true" : "false")"
                            aria-controls="settings-card-backup"
                            title="@(IsCollapsed("backup") ? "توسيع النسخ الاحتياطي" : "طي النسخ الاحتياطي")">
                        <WizzIcon Icon="@(IsCollapsed("backup") ? "chevron-down" : "chevron-up")" Size="16" />
                    </button>
                </div>
            </div>
            <div id="settings-card-backup" class="@CardBodyClass("backup")">
                @if (backups.Count == 0)
                {
                    <div class="alert alert-info mb-0">لا توجد نسخ احتياطية.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>الوصف</th>
                                    <th>التاريخ</th>
                                    <th class="text-end">الحجم</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var backup in backups)
                                {
                                    <tr>
                                        <td>@backup.Description</td>
                                        <td>@backup.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                        <td class="text-end">@FormatBytes(backup.SizeBytes)</td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-success" title="استعادة" @onclick="() => RestoreBackup(backup.Path)">
                                                    <WizzIcon Icon="undo" Size="16" Title="استعادة" />
                                                </button>
                                                <button class="btn btn-outline-danger" title="حذف" @onclick="() => DeleteBackup(backup.Path)">
                                                    <WizzIcon Icon="trash" Size="16" Title="حذف" />
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
        </Authorized>
    </AuthorizeView>

    <!-- معلومات النظام -->
    <div class="col-12 col-md-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0 d-flex align-items-center gap-2">
                    <WizzIcon Icon="info" Size="18" />
                    <span>معلومات النظام</span>
                </h5>
                <button type="button" class="wizz-settings-toggle"
                        @onclick="ToggleSystemCard"
                        aria-expanded="@(!IsCollapsed("system") ? "true" : "false")"
                        aria-controls="settings-card-system"
                        title="@(IsCollapsed("system") ? "توسيع معلومات النظام" : "طي معلومات النظام")">
                    <WizzIcon Icon="@(IsCollapsed("system") ? "chevron-down" : "chevron-up")" Size="16" />
                </button>
            </div>
            <div id="settings-card-system" class="@CardBodyClass("system")">
                <table class="table table-sm table-borderless mb-0">
                    <tbody>
                        <tr><td>إصدار التطبيق</td><td class="text-end fw-bold">0.1.0</td></tr>
                        <tr><td>إطار العمل</td><td class="text-end">.NET 10 / Blazor Server</td></tr>
                        <tr><td>قاعدة البيانات</td><td class="text-end">SQLite (wizz.db)</td></tr>
                        <tr><td>الذكاء الاصطناعي</td><td class="text-end">مدمج محلياً</td></tr>
                        <tr><td>اللغة</td><td class="text-end">العربية (RTL)</td></tr>
                        <tr><td>الترخيص</td><td class="text-end">MIT</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- الوحدات الاختيارية -->
    <div class="col-12" id="modules-settings">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0 d-flex align-items-center gap-2">
                    <WizzIcon Icon="settings" Size="18" />
                    <span>الوحدات الاختيارية</span>
                </h5>
                <button type="button" class="wizz-settings-toggle"
                        @onclick="ToggleModulesCard"
                        aria-expanded="@(!IsCollapsed("modules") ? "true" : "false")"
                        aria-controls="settings-card-modules"
                        title="@(IsCollapsed("modules") ? "توسيع الوحدات الاختيارية" : "طي الوحدات الاختيارية")">
                    <WizzIcon Icon="@(IsCollapsed("modules") ? "chevron-down" : "chevron-up")" Size="16" />
                </button>
            </div>
            <div id="settings-card-modules" class="@CardBodyClass("modules")">
                @if (moduleStatuses.Count == 0)
                {
                    <div class="alert alert-info mb-0">
                        لا توجد وحدات اختيارية متاحة حالياً. ستظهر الوحدات هنا عند إضافتها.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>الوحدة</th>
                                    <th>المجموعة</th>
                                    <th>الحالة</th>
                                    <th>الاحتياجات</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var module in moduleStatuses)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@module.Descriptor.NameAr</div>
                                            <div class="small text-muted">@module.Descriptor.DescriptionAr</div>
                                            <div class="small text-muted">الإصدار @module.Descriptor.Version</div>
                                        </td>
                                        <td>@GroupText(module.Descriptor.Group)</td>
                                        <td>
                                            <span class="badge @(module.Enabled ? "bg-success" : "bg-secondary")">
                                                @(module.Enabled ? "مفعّلة" : "معطّلة")
                                            </span>
                                            @if (module.Availability == ModuleAvailability.Unavailable)
                                            {
                                                <div class="small text-danger mt-1">@module.ReasonAr</div>
                                            }
                                        </td>
                                        <td>
                                            @if (module.Descriptor.RequirementsAr.Count == 0)
                                            {
                                                <span class="text-muted">لا شيء</span>
                                            }
                                            else
                                            {
                                                @string.Join(" · ", module.Descriptor.RequirementsAr)
                                            }
                                        </td>
                                        <td>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-@(module.Enabled ? "danger" : "primary")"
                                                    disabled="@(module.Availability == ModuleAvailability.Unavailable)"
                                                    @onclick="() => ToggleModuleAsync(module)">
                                                @(module.Enabled ? "تعطيل" : "تفعيل")
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                <div class="alert alert-secondary py-2 small mt-3 mb-0">
                    كل وحدة مطفأة افتراضياً. البيع يعمل دون أي وحدة، وتعطيل أي وحدة لا يحذف بياناتها.
                    لا تظهر أسماء باقات أو أسعار هنا قبل اعتمادها.
                </div>
            </div>
        </div>
    </div>

    <!-- إعدادات الذكاء الاصطناعي (بسيط) -->
    <div class="col-12" id="ai-settings">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0 d-flex align-items-center gap-2"><WizzIcon Icon="sparkles" Size="18" /><span>المساعد الذكي</span></h5>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge @(aiCloudEnabled && aiCloudSharingEnabled ? "bg-success" : "bg-secondary")">
                        @(aiCloudEnabled && aiCloudSharingEnabled ? "سحابي مجاني مفعل" : "محلي فقط")
                    </span>
                    <button type="button" class="wizz-settings-toggle"
                            @onclick="ToggleAiCard"
                            aria-expanded="@(!IsCollapsed("ai") ? "true" : "false")"
                            aria-controls="settings-card-ai"
                            title="@(IsCollapsed("ai") ? "توسيع إعدادات المساعد" : "طي إعدادات المساعد")">
                        <WizzIcon Icon="@(IsCollapsed("ai") ? "chevron-down" : "chevron-up")" Size="16" />
                    </button>
                </div>
            </div>
            <div id="settings-card-ai" class="@CardBodyClass("ai")">
                <div class="mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="aiCloud" @bind="aiCloudEnabled" />
                        <label class="form-check-label" for="aiCloud">
                            تفعيل النموذج السحابي لتوليد النص (اختياري)
                        </label>
                    </div>
                    <div class="form-text">
                        يخصّ هذا المفتاح «من يُنشئ النص». لا يعمل وحده: يلزم أيضاً تفعيل «التشارك السحابي» أدناه،
                        وإدخال مفتاح API، وتوفر اتصال بالإنترنت. إذا لم تُفعّله، سيعمل المساعد من بيانات متجرك محلياً دون إنترنت.
                    </div>
                </div>

                <div class="mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="aiCloudSharing" @bind="aiCloudSharingEnabled" />
                        <label class="form-check-label" for="aiCloudSharing">
                            تفعيل التشارك السحابي (ملخصات مجهولة لتحسين الصياغة والتحليل)
                        </label>
                    </div>
                    <div class="form-text">@ApprovedPrivacyWording.Text</div>
                </div>

                <details class="mt-3 border-top pt-3">
                    <summary class="small text-muted" style="cursor: pointer;">إعدادات السحابة (متقدم — اختياري)</summary>
                    <div class="mt-3">
                @if (aiCloudEnabled)
                {
                    <div class="mb-3">
                        <label class="form-label">مفتاح API (اختياري - للصق من OpenRouter)</label>
                        <div class="input-group">
                            <input type="password" class="form-control" @bind="cloudApiKey" @bind:event="oninput"
                                   autocomplete="off" spellcheck="false" placeholder="sk-or-... (اختياري)" />
                            <span class="input-group-text">
                                <a href="https://openrouter.ai" target="_blank" rel="noopener noreferrer" class="text-decoration-none">
                                    <WizzIcon Icon="link" Size="14" /> احصل على مفتاح مجاني
                                </a>
                            </span>
                        </div>
                        <div class="form-text">
                            انسخ المفتاح من OpenRouter (يبدأ بـ <code>sk-or-...</code>) والصقه هنا.
                            يُقرأ الحقل مباشرةً أثناء الكتابة أو اللصق، ولا يُحفظ إلا بضغط «حفظ الإعدادات».
                            <a href="https://openrouter.ai" target="_blank" rel="noopener noreferrer">مجاني، لا بطاقة بنكية</a>.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">اسم نموذج الرؤية المجاني (لاستخراج النص من الصورة)</label>
                        <input class="form-control" list="freeVisionModels" @bind="cloudVisionModel"
                               placeholder="اختر من القائمة أو الصق اسم نموذج ينتهي بـ :free" />
                        <datalist id="freeVisionModels">
                            <option value="nvidia/nemotron-3.5-super-vl:free"></option>
                            <option value="google/gemma-4-31b-it:free"></option>
                            <option value="google/gemma-4-26b-a4b-it:free"></option>
                            <option value="inclusionai/ling-3.2-flash:free"></option>
                            <option value="particle-ai/particle-1:free"></option>
                            <option value="nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free"></option>
                            <option value="dots-studio/dots-3-note-preview:free"></option>
                        </datalist>
                        <div class="form-text">
                            الأسماء في القائمة مأخوذة من كتالوج OpenRouter في ٢٠٢٦-١١-٢٠ وكانت تقبل صورًا وسعرها صفر.
                            يلزم أن ينتهي الاسم بـ <code>:free</code>؛ وأي اسم آخر يُرفض قبل إرسال أي صورة، التزامًا بقاعدة «مجاني فقط / صفر تكلفة».
                            <a href="https://openrouter.ai/models" target="_blank" rel="noopener noreferrer">راجع التوفر الحالي</a>
                            قبل الاستخدام؛ دقة العربية على وصل حقيقية ما زالت تحتاج تجربتك.
                        </div>
                        @if (!string.IsNullOrWhiteSpace(cloudVisionModel)
                             && !cloudVisionModel.Trim().EndsWith(":free", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="small text-danger mt-1">الاسم الحالي غير مقبول؛ أضف اللاحقة <code>:free</code> بعد اختيار نموذج مجاني فعلي.</div>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label">اسم نموذج المحادثة المجاني (عند طلب السحابة)</label>
                        <input class="form-control" list="freeChatModels" @bind="cloudChatModel"
                               placeholder="اتركه فارغًا لاستخدام إعداد الملف، أو اختر نموذجًا مجانيًا" />
                        <datalist id="freeChatModels">
                            <option value="baidu/ernie-5.5-flash-preview:free"></option>
                            <option value="liquid/lfm-3-1.7b:free"></option>
                            <option value="recursive/flint-v1.0:free"></option>
                            <option value="nvidia/nemotron-3.5-lightning:free"></option>
                            <option value="nvidia/nemotron-3-ultra-550b-a55b:free"></option>
                        </datalist>
                        <div class="form-text">
                            النموذج الافتراضي في ملف التطبيق (<code>qwen/qwen3-32b</code>) ليس مجانيًا، لذلك يُمنع الآن قبل أي إرسال.
                            اختر اسمًا من القائمة ينتهي بـ <code>:free</code>؛ واترك الحقل فارغًا إن أردت الإعداد القديم.
                        </div>
                        @if (!string.IsNullOrWhiteSpace(cloudChatModel)
                             && !cloudChatModel.Trim().EndsWith(":free", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="small text-danger mt-1">اسم المحادثة غير مقبول؛ يلزم أن ينتهي بـ <code>:free</code>.</div>
                        }
                    </div>

                    <div class="mb-3 border-top pt-3" id="auto-model-catalog">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="autoModelCatalog" @bind="autoModelCatalogEnabled" />
                            <label class="form-check-label" for="autoModelCatalog">
                                اقتراح تلقائي للنماذج من الكتالوج العام (اختياري)
                            </label>
                        </div>
                        <div class="form-text">
                            <strong>مغلق افتراضيًا</strong> — عند التفعيل تقرأ الخدمة بيانات عامة (أسماء النماذج، السعر، هل يقبل صورة)
                            من <code>/models</code> على فترات متباعدة. <strong>لا يُرسل سؤالك ولا صورك ولا مفتاح API</strong>،
                            ولا يُغيّر قارئ النص، ولا يختار المسار عنك. النتائج <strong>اقتراحات للعرض فقط</strong>؛ عليك نسخ الاسم
                            في الحقل أعلاه ثم الحفظ، وتبقى الموافقة على كل إرسال سحابي مطلوبة كما هي.
                        </div>
                        <div class="d-flex gap-2 align-items-center mt-2">
                            <button type="button" class="btn btn-outline-secondary btn-sm"
                                    @onclick="RefreshCatalogAsync" disabled="@refreshingCatalog">
                                @(refreshingCatalog ? "جارٍ التحديث…" : "تحديث الاقتراحات الآن")
                            </button>
                            @if (catalogSnapshot is not null)
                            {
                                <span class="small text-muted">آخر قراءة: @catalogSnapshot.FetchedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(catalogStatus))
                        {
                            <div class="small @(catalogSnapshot?.HasError == true ? "text-danger" : "text-success") mt-1">@catalogStatus</div>
                        }
                        @if (catalogSnapshot is not null && (!catalogSnapshot.HasError || catalogSnapshot.ChatCandidates.Count > 0 || catalogSnapshot.VisionCandidates.Count > 0))
                        {
                            <div class="small mt-2">
                                @if (catalogSnapshot.SuggestedChatModel is not null)
                                {
                                    <div class="mb-1">
                                        للمحادثة: <code>@catalogSnapshot.SuggestedChatModel</code>
                                        <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => UseCatalogSuggestion(asVision: false)">انسخ إلى الحقل</button>
                                    </div>
                                }
                                @if (catalogSnapshot.SuggestedVisionModel is not null)
                                {
                                    <div class="mb-1">
                                        للرؤية: <code>@catalogSnapshot.SuggestedVisionModel</code>
                                        <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => UseCatalogSuggestion(asVision: true)">انسخ إلى الحقل</button>
                                    </div>
                                }
                                <div class="text-muted">
                                    الترتيب مبني على بيانات الكتالوج فقط؛ دقة العربية على وصل حقيقي ما زالت تحتاج تجربتك.
                                    <a href="@catalogSnapshot.Source" target="_blank" rel="noopener noreferrer">المصدر</a>
                                </div>
                            </div>
                        }
                    </div>
                }
                    </div>
                </details>

                <details class="mt-3 border-top pt-3">
                    <summary class="small text-muted" style="cursor: pointer;">النموذج المحلي (متقدم — اختياري)</summary>
                    <div class="mt-3">
                <div class="mb-3">
                    <label class="form-label">مستوى المساعد المحلي حسب جهازك</label>
                    <select class="form-select form-select-sm" @bind="localModelLevel">
                        <option value="light">خفيف (للأجهزة الضعيفة - 4 جيجابايت ذاكرة)</option>
                        <option value="medium">متوسط (للأجهزة العادية - 8 جيجابايت ذاكرة أو أكثر)</option>
                    </select>
                    <div class="form-text">
                        اختر المستوى الذي يناسب جهازك. المستوى الخفيف أسرع ولا يبطئ جهاز البيع.
                    </div>
                    @if (loadingDevice)
                    {
                        <div class="alert alert-info py-2 small mb-3">
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            جارٍ قياس قدرة الجهاز…
                        </div>
                    }
                    else if (deviceAssessment is not null)
                    {
                        <div class="alert alert-info py-2 small mb-3">
                            <strong>قدرة الجهاز:</strong> @DeviceTierText(deviceAssessment.Tier)
                            <span class="text-muted ms-1"
                                  title="مستوى الجهاز يُقاس من الذاكرة المتاحة، ويحدّد النموذج المحلي المقترح تلقائياً."><WizzIcon Icon="help" Size="14" /></span>
                            <div class="text-muted mt-1">@deviceAssessment.Reason</div>
                        </div>
                    }
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        النموذج المحلي المفضّل
                        <span class="text-muted" title="النموذج الذي يستخدمه Ollama داخل المتجر. اختر النموذج ثم اضغط «تطبيق». نسخ «coder» غير مخصصة للمحادثة العربية."><WizzIcon Icon="help" Size="14" /></span>
                    </label>
                    <div class="input-group input-group-sm">
                        <select class="form-select" @bind="preferredLocalModel" disabled="@(localModels.Count == 0)">
                            @if (localModels.Count == 0)
                            {
                                <option value="">لا توجد نماذج مثبتة</option>
                            }
                            else
                            {
                                @foreach (var m in localModels)
                                {
                                    <option value="@m">@m</option>
                                }
                            }
                        </select>
                        <button class="btn btn-outline-secondary" title="تحديث قائمة النماذج المثبتة"
                                @onclick="RefreshLocalModels" disabled="@loadingLocalModels">
                            @if (loadingLocalModels)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                            }
                            else
                            {
                                <WizzIcon Icon="refresh" Size="14" />
                            }
                        </button>
                        <button class="btn btn-outline-primary" title="تفعيل النموذج المختار"
                                @onclick="ApplyLocalModel"
                                disabled="@(applyingLocalModel || string.IsNullOrWhiteSpace(preferredLocalModel))">
                            @(applyingLocalModel ? "…" : "تطبيق")
                        </button>
                    </div>
                    <div class="form-text">
                        نماذج عربية مناسبة: <code>qwen2.5:1.5b</code> (متوازن) أو <code>qwen2.5:0.5b-instruct</code> (خفيف للأجهزة الضعيفة).
                    </div>
                </div>

                @if (localModels.Count == 0)
                {
                    <div class="alert alert-warning">
                        <strong>Ollama غير متاح</strong> — لكن المساعد المدمج يعمل بشكل طبيعي بدونه.
                        <ol class="mb-0 mt-2 ps-3">
                            <li>ثبّت Ollama من <code>ollama.com</code></li>
                            <li><code>ollama pull qwen2.5:0.5b-instruct</code></li>
                            <li>أعد تشغيل التطبيق أو اضغط زر التحديث</li>
                        </ol>
                    </div>
                }
                else
                {
                    <div class="alert alert-success">
                        متصل بـ Ollama — @localModels.Count نموذج مثبّت.
                    </div>
                }
                    </div>
                </details>

                <div class="alert alert-info">
                    <strong>مهم:</strong> البيع والمخزون والمال تعمل دائماً حتى لو كان المساعد الذكي غير متاح.
                    @ApprovedPrivacyWording.Text
                </div>

                <div class="alert alert-secondary py-2 small mt-3">
                    <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
                        <span>
                            <strong>حالة المساعد:</strong> @routerStatusSummary
                            @if (loadingAiStatus)
                            {
                                <span class="spinner-border spinner-border-sm ms-2" role="status"></span>
                            }
                        </span>
                        <span class="d-flex align-items-center gap-1">
                            <span class="badge bg-success" title="المساعد المدمج — يعمل دائماً بلا إنترنت">المدمج</span>
                            <span class="badge @(routerStatus?.LocalAvailable == true ? "bg-success" : "bg-secondary")"
                                  title="النموذج المحلي (Ollama)">محلي</span>
                            <span class="badge @(routerStatus?.CloudAvailable == true ? "bg-success" : "bg-secondary")"
                                  title="النموذج السحابي (اختياري)">سحابي</span>
                            <span class="badge bg-primary" title="عدد المسارات المتاحة">@((routerStatus?.RouteCount ?? 1))</span>
                        </span>
                    </div>
                </div>

                <details class="mt-3 border-top pt-3">
                    <summary class="small text-muted" style="cursor: pointer;">تفضيلات المساعد (متقدم — اختياري)</summary>
                    <div class="mt-3">
                <hr />

                <h6 class="mb-2 d-flex align-items-center gap-2"><WizzIcon Icon="brain" Size="16" /><span>تفضيلات المساعد</span></h6>

                <div class="mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="aiRememberContext" @bind="rememberContext" />
                        <label class="form-check-label" for="aiRememberContext">
                            حفظ سياق المحادثة
                            <span class="text-muted" title="عند التفعيل يتذكّر المساعد آخر منتج سألت عنه فيجيب عن «كم سعره؟». كل شيء محفوظ على جهازك فقط ويمكن مسحه من صفحة المساعد."><WizzIcon Icon="help" Size="14" /></span>
                        </label>
                    </div>
                    <div class="form-text">
                        يتذكّر المساعد آخر منتج سألت عنه فيجيب عن أسئلة المتابعة مثل «كم سعره؟». البيانات محفوظة على جهازك فقط،
                        ويمكن مسحها بزر «مسح الذاكرة» في صفحة المساعد.
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">السعر الذي يظهر أولاً في الإجابات</label>
                    <select class="form-select form-select-sm" @bind="priceMode">
                        <option value="Retail">سعر التجزئة</option>
                        <option value="Wholesale">سعر الجملة</option>
                    </select>
                    <div class="form-text">يحدّد أيّ سعر يُعرض أولاً حين يسألك المستخدم عن سعر منتج.</div>
                </div>

                <div class="mb-3">
                    <label class="form-label">وحدة القياس المفضّلة (اختياري)</label>
                    <input type="text" class="form-control form-control-sm" @bind="preferredUnit" placeholder="مثال: كجم أو لتر" />
                    <div class="form-text">تظهر منتجات هذه الوحدة أولاً في قوائم المنتجات التي يعرضها المساعد.</div>
                </div>

                <div class="mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="aiInternetAccess" @bind="allowInternetAccess" />
                        <label class="form-check-label" for="aiInternetAccess">
                            السماح للمساعد المدمج بالبحث في الإنترنت عند الطلب
                            <span class="text-muted" title="مغلق افتراضياً. عند التفعيل فقط، وإذا كتبت «ابحث عن…» أو «من هو…»، تُرسل كلمات سؤالك إلى خدمة بحث عامة. أسئلة متجرك لا تُرسل أبداً."><WizzIcon Icon="help" Size="14" /></span>
                        </label>
                    </div>
                    <div class="form-text">
                        <strong>مغلق افتراضياً</strong> — المساعد يعمل كاملاً دون إنترنت. عند التفعيل، اسأل صراحةً مثل «ابحث عن تاريخ الجزائر»
                        أو «من هو ابن باديس؟» فتُرسل كلمات سؤالك إلى خدمة بحث عامة (ويكيبيديا / DuckDuckGo) ويظهر المصدر مع الإجابة.
                        أسئلة المبيعات والديون والأسعار والمنتجات <strong>لا تُرسل إلى الإنترنت أبداً</strong>.
                    </div>
                </div>

                <RoutePriorityEditor />
                    </div>
                </details>

                <details class="mt-3 border-top pt-3">
                    <summary class="small text-muted" style="cursor: pointer;">اختبارات الاتصال (متقدم — اختياري)</summary>
                    <div class="mt-3">
                <div class="d-flex gap-2 mb-3">
                    <button class="btn btn-outline-secondary btn-sm flex-fill" @onclick="TestOllamaAsync" disabled="@testingOllama">
                        @(testingOllama ? "جارٍ الاختبار…" : "اختبار Ollama")
                    </button>
                    <button class="btn btn-outline-secondary btn-sm flex-fill" @onclick="TestCloudAsync" disabled="@(testingCloud || !aiCloudEnabled)">
                        @(testingCloud ? "جارٍ الاختبار…" : "اختبار السحابة")
                    </button>
                </div>                @if (!string.IsNullOrWhiteSpace(ollamaTestResult))
                {
                    <div class="alert alert-info py-2 small">@ollamaTestResult</div>
                }
                @if (!string.IsNullOrWhiteSpace(cloudTestResult))
                {
                    <div class="alert @(cloudTestOk == true ? "alert-success" : cloudTestOk == false ? "alert-warning" : "alert-info") py-2 small">@cloudTestResult</div>
                }
                    </div>
                </details>

                <div class="d-flex gap-2">
                    <button class="btn btn-primary" @onclick="SaveAiSettings">حفظ الإعدادات</button>
                    <button class="btn btn-outline-secondary" @onclick="ResetAiPreferences"
                            title="إعادة تفضيلات المساعد إلى القيم الافتراضية">الافتراضي</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- نافذة المتجر -->
@if (showStoreModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">إعداد المتجر</h5>
                    <button type="button" class="btn-close" @onclick="() => showStoreModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">اسم المتجر <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" @bind="storeForm.Name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">العنوان</label>
                        <textarea class="form-control" rows="2" @bind="storeForm.Address"></textarea>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">الهاتف</label>
                            <input type="text" class="form-control" @bind="storeForm.Phone" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">العملة</label>
                            <input type="text" class="form-control" maxlength="3" @bind="storeForm.Currency" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">الرقم الضريبي</label>
                            <input type="text" class="form-control" @bind="storeForm.TaxNumber" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">السجل التجاري</label>
                            <input type="text" class="form-control" @bind="storeForm.CommercialRegister" />
                        </div>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="allowCreditModal" @bind="storeForm.AllowCreditSales" />
                        <label class="form-check-label" for="allowCreditModal">السماح بالبيع الآجل</label>
                    </div>
                    <div class="form-check mt-2">
                        <input type="checkbox" class="form-check-input" id="inventoryEnabledModal" @bind="storeForm.InventoryEnabled" />
                        <label class="form-check-label" for="inventoryEnabledModal">تتبع المخزون (خصم تلقائي عند البيع)</label>
                    </div>
                    <div class="form-check mt-2">
                        <input type="checkbox" class="form-check-input" id="cashDrawerEnabledModal" @bind="storeForm.CashDrawerEnabled" />
                        <label class="form-check-label" for="cashDrawerEnabledModal">تفعيل وحدة الصندوق وعدّ النقدية</label>
                    </div>
                    <div class="mt-2">
                        <label class="form-label">حدّ فرق الصندوق المسموح به (د.ج)</label>
                        <input type="number" class="form-control" min="0" step="0.01" @bind="storeForm.CashDifferenceTolerance" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showStoreModal = false">إلغاء</button>
                    <button class="btn btn-primary" @onclick="SaveStoreSettings">حفظ</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- نافذة المستخدم -->
@if (showUserModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(editingUser != null ? "تعديل المستخدم" : "مستخدم جديد")</h5>
                    <button type="button" class="btn-close" @onclick="() => showUserModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">اسم المستخدم <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" @bind="userForm.Username" disabled="@(editingUser != null)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">
                            كلمة المرور
                            @(editingUser != null ? "(اتركها فارغة للإبقاء على الحالية)" : "*")
                        </label>
                        <input type="password" class="form-control" @bind="userForm.Password" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">الاسم الكامل <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" @bind="userForm.FullName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">الدور</label>
                        <select class="form-select" @bind="userForm.Role">
                            <option value="Cashier">كاشير</option>
                            <option value="Manager">مدير</option>
                            <option value="Admin">مدير نظام</option>
                        </select>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="userActive" @bind="userForm.IsActive" />
                        <label class="form-check-label" for="userActive">نشط</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showUserModal = false">إلغاء</button>
                    <button class="btn btn-primary" @onclick="SaveUser" disabled="@savingUser">حفظ</button>
                </div>
            </div>
        </div>
    </div>
}

