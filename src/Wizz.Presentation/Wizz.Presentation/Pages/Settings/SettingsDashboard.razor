                @if (!string.IsNullOrWhiteSpace(cloudTestResult))
                {
                    <div class="alert alert-info py-2 small">@cloudTestResult</div>
                }

                <button class="btn btn-primary w-100" @onclick="SaveAiSettings">حفظ الإعدادات</button>
            </div>
        </div>
    </div>
</div>

