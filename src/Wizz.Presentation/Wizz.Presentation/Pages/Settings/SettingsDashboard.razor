    private async Task SaveUser()
    {
        if (!await EnsurePermissionAsync(Permission.ManageUsers, "محاولة إنشاء أو تعديل مستخدم دون صلاحية", "User", editingUser?.Id.ToString()))
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(userForm.FullName))
        {
            await JS.InvokeVoidAsync("alert", "الاسم الكامل مطلوب");
            return;
        }

        var changingPassword = !string.IsNullOrEmpty(userForm.Password);
        if (changingPassword)
        {
            var passwordErrors = PasswordPolicy.Validate(userForm.Password);
            if (passwordErrors.Count > 0)
            {
                await JS.InvokeVoidAsync("alert", string.Join("\n", passwordErrors));
                return;
            }
        }

        var currentUserId = await CurrentUser.IdAsync();
        if (editingUser != null && !userForm.IsActive && editingUser.Id == currentUserId)
        {
            await JS.InvokeVoidAsync("alert", "لا يمكنك تعطيل حسابك الحالي.");
            return;
        }

        savingUser = true;
        try
        {
            var actorId = currentUserId;
            var actorName = await CurrentUser.UsernameAsync();

            if (editingUser != null)
            {
                var previouslyActive = editingUser.IsActive;
                var previousRole = editingUser.Role;

                editingUser.UpdateProfile(userForm.FullName, userForm.Role);
                if (changingPassword)
                {
                    editingUser.ChangePassword(PasswordHasher.Hash(userForm.Password));
                }

                if (userForm.IsActive)
                {
                    editingUser.Activate();
                }
                else
                {
                    editingUser.Deactivate();
                }

                UserRepo.Update(editingUser);

                var details = $"تعديل المستخدم '{editingUser.Username}': الدور {previousRole} ← {editingUser.Role}، الحالة {(previouslyActive ? "نشط" : "معطل")} ← {(editingUser.IsActive ? "نشط" : "معطل")}";
                await Audit.LogAsync(new AuditEntry(
                    AuditAction.UserUpdated,
                    AuditOutcome.Success,
                    actorId,
                    actorName,
                    "User",
                    editingUser.Id.ToString(),
                    details));

                if (changingPassword)
                {
                    await Audit.LogAsync(new AuditEntry(
                        AuditAction.UserPasswordReset,
                        AuditOutcome.Success,
                        actorId,
                        actorName,
                        "User",
                        editingUser.Id.ToString(),
                        $"إعادة تعيين كلمة مرور المستخدم '{editingUser.Username}' من شاشة التعديل"));
                }

                if (previouslyActive != editingUser.IsActive)
                {
                    await Audit.LogAsync(new AuditEntry(
                        editingUser.IsActive ? AuditAction.UserActivated : AuditAction.UserDeactivated,
                        AuditOutcome.Success,
                        actorId,
                        actorName,
                        "User",
                        editingUser.Id.ToString(),
                        editingUser.IsActive
                            ? $"تفعيل المستخدم '{editingUser.Username}'"
                            : $"تعطيل المستخدم '{editingUser.Username}'"));
                }
            }
            else
            {
                if (string.IsNullOrWhiteSpace(userForm.Username) || string.IsNullOrEmpty(userForm.Password))
                {
                    await JS.InvokeVoidAsync("alert", "اسم المستخدم وكلمة المرور مطلوبان");
                    return;
                }

                var created = new User(
                    userForm.Username,
                    PasswordHasher.Hash(userForm.Password),
                    userForm.FullName,
                    userForm.Role);

                if (!userForm.IsActive)
                {
                    created.Deactivate();
                }

                await UserRepo.AddAsync(created);
                await Audit.LogAsync(new AuditEntry(
                    AuditAction.UserCreated,
                    AuditOutcome.Success,
                    actorId,
                    actorName,
                    "User",
                    created.Id.ToString(),
                    $"إنشاء المستخدم '{created.Username}' بدور {created.Role}"));
            }

            await UnitOfWork.SaveChangesAsync();
            showUserModal = false;
            await LoadUsers();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"خطأ: {ex.Message}");
        }
        finally
        {
            savingUser = false;
        }
    }

    private async Task ResetPassword(User user)
    {
        if (!await EnsurePermissionAsync(Permission.ManageUsers, "محاولة إعادة تعيين كلمة مرور دون صلاحية", "User", user.Id.ToString()))
        {
            return;
        }

        var newPassword = await JS.InvokeAsync<string>("prompt", $"كلمة مرور جديدة للمستخدم {user.Username}:");
        if (string.IsNullOrWhiteSpace(newPassword))
        {
            return;
        }

        var passwordErrors = PasswordPolicy.Validate(newPassword);
        if (passwordErrors.Count > 0)
        {
            await JS.InvokeVoidAsync("alert", string.Join("\n", passwordErrors));
            return;
        }

        user.ChangePassword(PasswordHasher.Hash(newPassword));
        UserRepo.Update(user);
        await UnitOfWork.SaveChangesAsync();
        await Audit.LogAsync(new AuditEntry(
            AuditAction.UserPasswordReset,
            AuditOutcome.Success,
            await CurrentUser.IdAsync(),
            await CurrentUser.UsernameAsync(),
            "User",
            user.Id.ToString(),
            $"إعادة تعيين كلمة مرور المستخدم '{user.Username}' — أُبطلت جلساته القائمة"));
        await JS.InvokeVoidAsync("alert", "تم تحديث كلمة المرور");
    }

    private async Task ToggleUserActive(User user)
    {
        if (!await EnsurePermissionAsync(Permission.ManageUsers, "محاولة تغيير حالة مستخدم دون صلاحية", "User", user.Id.ToString()))
        {
            return;
        }

        if (user.IsActive && user.Id == await CurrentUser.IdAsync())
        {
            await JS.InvokeVoidAsync("alert", "لا يمكنك تعطيل حسابك الحالي.");
            return;
        }

        if (user.IsActive)
        {
            user.Deactivate();
        }
        else
        {
            user.Activate();
        }

        UserRepo.Update(user);
        await UnitOfWork.SaveChangesAsync();
        await Audit.LogAsync(new AuditEntry(
            user.IsActive ? AuditAction.UserActivated : AuditAction.UserDeactivated,
            AuditOutcome.Success,
            await CurrentUser.IdAsync(),
            await CurrentUser.UsernameAsync(),
            "User",
            user.Id.ToString(),
            user.IsActive
                ? $"تفعيل المستخدم '{user.Username}'"
                : $"تعطيل المستخدم '{user.Username}' — أُبطلت جلساته القائمة"));
        await LoadUsers();
    }

