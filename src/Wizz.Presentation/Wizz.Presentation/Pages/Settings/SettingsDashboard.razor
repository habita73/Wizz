@code {
    private Store? store;
    private StoreForm storeForm = new();

    /// <summary>مرجع اختصارات لوحة المفاتيح المعروضة في بطاقة الإعدادات.</summary>
    private static readonly (string Label, string[] Keys)[] Shortcuts =
    {
        ("بيع جديد", new[] { "Alt", "1" }),
        ("الديون المستحقة", new[] { "Alt", "2" }),
        ("الفواتير المتأخرة", new[] { "Alt", "3" }),
        ("سجل المبيعات", new[] { "Alt", "4" }),
        ("تنفيذ الإجراء الافتراضي في النموذج", new[] { "Enter" }),
        ("إلغاء / إغلاق النافذة", new[] { "Esc" }),
        ("سطر جديد في المساعد", new[] { "Shift", "Enter" })
    };

    private bool showStoreModal;
    private bool savingStore;

    private List<User> users = new();
    private bool showUserModal;
    private User? editingUser;
    private UserForm userForm = new();
    private bool savingUser;

    private List<Wizz.Application.Abstractions.BackupInfo> backups = new();
    private bool backupInProgress;

    // إعدادات الذكاء الاصطناعي
    private bool aiCloudEnabled = false;
    private string localModelLevel = "light";
    private string cloudApiKey = "";
    private DeviceCapabilityAssessment? deviceAssessment;
    private bool loadingDevice;
    private string routerStatusSummary = "جارٍ التقييم…";
    private Wizz.Application.Abstractions.RouterStatusDto? routerStatus;
    private bool loadingAiStatus = false;
    private bool testingOllama = false;
    private bool testingCloud = false;
    private string ollamaTestResult = "";
    private string cloudTestResult = "";

    // النموذج المحلي المفضّل
    private List<string> localModels = new();
    private string preferredLocalModel = "";
    private bool loadingLocalModels = false;
    private bool applyingLocalModel = false;

    // تفضيلات المساعد (الذاكرة ونوع السعر ووحدة القياس)
    private string priceMode = "Retail";
    private string preferredUnit = "";
    private bool rememberContext = true;
    private bool allowInternetAccess;

    // المظهر والوضع اللوني
    private string themeMode = "system";

    protected override async Task OnInitializedAsync()
    {
        await LoadStore();
        await LoadUsers();
        await LoadBackups();
        await LoadAiSettings();
        await LoadAiPreferences();
        await LoadThemeMode();
    }

    /// <summary>يحمّل تفضيل الوضع اللوني من التخزين المحلي (الافتراضي: النظام).</summary>
    private async Task LoadThemeMode()
    {
        try
        {
            var saved = await JS.InvokeAsync<string?>("localStorage.getItem", "wizz.theme");
            if (!string.IsNullOrWhiteSpace(saved))
            {
                themeMode = saved;
            }
        }
        catch
        {
            // استخدام القيمة الافتراضية (النظام)
        }
        await ApplyThemeAsync();
    }

    /// <summary>يطبق الوضع اللوني المحدد على عنصر html عبر سمة data-theme.</summary>
    private async Task ApplyThemeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "wizz.theme", themeMode);
            await JS.InvokeVoidAsync("document.documentElement.setAttribute", "data-theme", themeMode);
        }
        catch
        {
            // تجاهل فشل التطبيق
        }
    }

    /// <summary>يضع الوضع الفاتح ويطبقه.</summary>
    private void SetThemeLight() { themeMode = "light"; _ = ApplyThemeAsync(); }

    /// <summary>يضع الوضع الداكن ويطبقه.</summary>
    private void SetThemeDark() { themeMode = "dark"; _ = ApplyThemeAsync(); }

    /// <summary>يضع وضع النظام ويطبقه.</summary>
    private void SetThemeSystem() { themeMode = "system"; _ = ApplyThemeAsync(); }

    /// <summary>يحمّل تفضيلات المساعد المحفوظة محلياً.</summary>
    private async Task LoadAiPreferences()
    {
        try
        {
            await MemoryStore.LoadAsync();
            priceMode = MemoryStore.Preferences.IsWholesalePreferred ? "Wholesale" : "Retail";
            preferredUnit = MemoryStore.Preferences.PreferredUnit ?? "";
            rememberContext = MemoryStore.Preferences.RememberContext;
            allowInternetAccess = MemoryStore.Preferences.AllowInternetAccess;
        }
        catch
        {
            // غياب التخزين المحلي — نكمل بالقيم الافتراضية.
        }
    }

    /// <summary>يحفظ تفضيلات المساعد محلياً.</summary>
    private async Task SaveAiPreferences()
    {
        try
        {
            MemoryStore.Preferences.SetPriceMode(
                string.Equals(priceMode, "Wholesale", StringComparison.OrdinalIgnoreCase)
                    ? Wizz.Application.AI.Memory.PriceMode.Wholesale
                    : Wizz.Application.AI.Memory.PriceMode.Retail);
            MemoryStore.Preferences.SetPreferredUnit(preferredUnit);
            MemoryStore.Preferences.SetRememberContext(rememberContext);
            MemoryStore.Preferences.SetAllowInternetAccess(allowInternetAccess);
            await MemoryStore.SaveAsync();
            await JS.InvokeVoidAsync("alert", "تم حفظ تفضيلات المساعد");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"تعذّر حفظ التفضيلات: {ex.Message}");
        }
    }

    /// <summary>يعيد تفضيلات المساعد إلى القيم الافتراضية.</summary>
    private async Task ResetAiPreferences()
    {
        try
        {
            await MemoryStore.ResetPreferencesAsync();
            priceMode = "Retail";
            preferredUnit = "";
            rememberContext = true;
            allowInternetAccess = false;
            StateHasChanged();
        }
        catch
        {
            // تجاهل
        }
    }

    private async Task LoadAiSettings()
    {
        aiCloudEnabled = AiSettings.IsCloudEnabled;
        cloudApiKey = AiSettings.GetCloudApiKey() ?? "";
        localModelLevel = AiSettings.LocalModelLevel;
        loadingDevice = true;
        loadingAiStatus = true;
        try
        {
            deviceAssessment = await DeviceEvaluator.AssessAsync();
        }
        catch
        {
            deviceAssessment = null;
        }
        finally
        {
            loadingDevice = false;
            StateHasChanged();
        }

        await RefreshRouterStatusAsync();
        await RefreshLocalModels();
    }

    /// <summary>يحدّث قائمة النماذج المحلية المثبتة ويختار الأنسب افتراضياً.</summary>
    private async Task RefreshLocalModels()
    {
        loadingLocalModels = true;
        try
        {
            var models = await ModelRouter.GetAvailableLocalModelsAsync();
            localModels = models.ToList();

            if (localModels.Count == 0)
            {
                preferredLocalModel = "";
            }
            else if (string.IsNullOrWhiteSpace(preferredLocalModel) || !localModels.Contains(preferredLocalModel))
            {
                preferredLocalModel = localModels[0];
            }
        }
        catch
        {
            localModels = new List<string>();
        }
        finally
        {
            loadingLocalModels = false;
            StateHasChanged();
        }
    }

    /// <summary>يفعّل النموذج المحلي المختار داخل المتجر.</summary>
    private async Task ApplyLocalModel()
    {
        if (string.IsNullOrWhiteSpace(preferredLocalModel)) return;

        applyingLocalModel = true;
        try
        {
            await ModelRouter.SetLocalModelAsync(preferredLocalModel);
            await RefreshRouterStatusAsync();
            await JS.InvokeVoidAsync("alert", $"تم تفعيل النموذج المحلي: {preferredLocalModel}");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"خطأ: {ex.Message}");
        }
        finally
        {
            applyingLocalModel = false;
        }
    }

    private async Task RefreshRouterStatusAsync()
    {
        loadingAiStatus = true;
        StateHasChanged();
        try
        {
            var status = await ModelRouter.GetStatusAsync();
            routerStatus = status;
            routerStatusSummary = status.SummaryMessage;
        }
        catch (Exception ex)
        {
            routerStatusSummary = $"تعذّر تقييم حالة المساعد: {ex.Message}";
        }
        finally
        {
            loadingAiStatus = false;
            StateHasChanged();
        }
    }

    private async Task SaveAiSettings()
    {
        AiSettings.IsCloudEnabled = aiCloudEnabled;
        if (!string.IsNullOrWhiteSpace(cloudApiKey))
        {
            AiSettings.SetCloudApiKey(cloudApiKey);
        }
        AiSettings.LocalModelLevel = localModelLevel;
        DeviceEvaluator.InvalidateCache();

        await RefreshRouterStatusAsync();
        await JS.InvokeVoidAsync("alert", "تم حفظ إعدادات المساعد الذكي");
    }

    private async Task TestOllamaAsync()
    {
        testingOllama = true;
        ollamaTestResult = "";
        StateHasChanged();
        try
        {
            // نستكشف Ollama عبر IModelRouter status كمؤشر
            var status = await ModelRouter.GetStatusAsync();
            ollamaTestResult = status.LocalAvailable
                ? $"Ollama متاح: {status.LocalModel}"
                : "Ollama غير متاح. تحقق من تشغيل تطبيق Ollama على المنفذ 11434 وثبّت نموذجاً (ollama pull qwen2.5:0.5b-instruct).";
        }
        catch (Exception ex)
        {
            ollamaTestResult = $"خطأ: {ex.Message}";
        }
        finally
        {
            testingOllama = false;
            StateHasChanged();
        }
    }

    private async Task TestCloudAsync()
    {
        testingCloud = true;
        cloudTestResult = "";
        StateHasChanged();
        try
        {
            var (success, message) = await ModelRouter.TestCloudConnectionAsync();
            cloudTestResult = message;
        }
        catch (Exception ex)
        {
            cloudTestResult = $"خطأ: {ex.Message}";
        }
        finally
        {
            testingCloud = false;
            StateHasChanged();
        }
    }

    private async Task LoadStore()
    {
        store = await StoreRepo.GetAsync();
        if (store != null)
        {
            storeForm = new StoreForm
            {
                Name = store.Name,
                Address = store.Address,
                Phone = store.Phone,
                TaxNumber = store.TaxNumber,
                CommercialRegister = store.CommercialRegister,
                AllowCreditSales = store.AllowCreditSales,
                Currency = store.Currency,
            };
        }
    }

    private async Task LoadUsers() => users = (await UserRepo.GetAllAsync()).ToList();

    private async Task LoadBackups() => backups = (await BackupService.ListBackupsAsync()).ToList();

    private async Task SaveStoreSettings()
    {
        if (string.IsNullOrWhiteSpace(storeForm.Name))
        {
            await JS.InvokeVoidAsync("alert", "اسم المتجر مطلوب");
            return;
        }

        savingStore = true;
        try
        {
            if (store == null)
            {
                var created = new Store(
                    storeForm.Name,
                    storeForm.Address,
                    storeForm.Phone,
                    storeForm.TaxNumber,
                    storeForm.CommercialRegister,
                    storeForm.AllowCreditSales,
                    string.IsNullOrWhiteSpace(storeForm.Currency) ? "DZD" : storeForm.Currency);
                await StoreRepo.AddAsync(created);
            }
            else
            {
                store.UpdateSettings(
                    storeForm.Name,
                    storeForm.Address,
                    storeForm.Phone,
                    storeForm.TaxNumber,
                    storeForm.CommercialRegister,
                    storeForm.AllowCreditSales,
                    storeForm.Currency);
                StoreRepo.Update(store);
            }

            await UnitOfWork.SaveChangesAsync();
            showStoreModal = false;
            await LoadStore();
            await JS.InvokeVoidAsync("alert", "تم حفظ إعدادات المتجر بنجاح");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"خطأ: {ex.Message}");
        }
        finally
        {
            savingStore = false;
        }
    }

    private async Task CreateBackup()
    {
        backupInProgress = true;
        try
        {
            var result = await BackupService.CreateBackupAsync();
            if (result.Success)
            {
                await LoadBackups();
                await JS.InvokeVoidAsync("alert", $"تم إنشاء النسخة الاحتياطية: {result.BackupPath}");
            }
            else
            {
                await JS.InvokeVoidAsync("alert", $"فشل النسخ: {result.ErrorMessage}");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"خطأ: {ex.Message}");
        }
        finally
        {
            backupInProgress = false;
        }
    }

    private async Task RestoreBackup(string path)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "تحذير: الاستعادة ستستبدل البيانات الحالية. هل تريد المتابعة؟");
        if (!confirmed)
        {
            return;
        }

        var result = await BackupService.RestoreAsync(path);
        if (result.Success)
        {
            await JS.InvokeVoidAsync("alert", "تمت الاستعادة بنجاح. أعد تشغيل التطبيق.");
        }
        else
        {
            await JS.InvokeVoidAsync("alert", $"فشل الاستعادة: {result.ErrorMessage}");
        }
    }

    private async Task DeleteBackup(string path)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "هل تريد حذف هذه النسخة الاحتياطية؟");
        if (!confirmed)
        {
            return;
        }

        await BackupService.DeleteBackupAsync(path);
        await LoadBackups();
    }

    private static string FormatBytes(long bytes)
    {
        string[] units = { "B", "KB", "MB", "GB" };
        var index = 0;
        double size = bytes;
        while (size >= 1024 && index < units.Length - 1)
        {
            size /= 1024;
            index++;
        }

        return $"{size:N1} {units[index]}";
    }

    private void NewUser()
    {
        editingUser = null;
        userForm = new UserForm { Role = UserRole.Cashier, IsActive = true };
        showUserModal = true;
    }

    private void EditUser(User user)
    {
        editingUser = user;
        userForm = new UserForm
        {
            Username = user.Username,
            FullName = user.FullName,
            Role = user.Role,
            IsActive = user.IsActive,
        };
        showUserModal = true;
    }

    private async Task SaveUser()
    {
        if (string.IsNullOrWhiteSpace(userForm.FullName))
        {
            await JS.InvokeVoidAsync("alert", "الاسم الكامل مطلوب");
            return;
        }

        savingUser = true;
        try
        {
            if (editingUser != null)
            {
                editingUser.UpdateProfile(userForm.FullName, userForm.Role);
                if (!string.IsNullOrEmpty(userForm.Password))
                {
                    editingUser.ChangePassword(PasswordHasher.Hash(userForm.Password));
                }

                if (userForm.IsActive)
                {
                    editingUser.Activate();
                }
                else
                {
                    editingUser.Deactivate();
                }

                UserRepo.Update(editingUser);
            }
            else
            {
                if (string.IsNullOrWhiteSpace(userForm.Username) || string.IsNullOrEmpty(userForm.Password))
                {
                    await JS.InvokeVoidAsync("alert", "اسم المستخدم وكلمة المرور مطلوبان");
                    return;
                }

                var created = new User(
                    userForm.Username,
                    PasswordHasher.Hash(userForm.Password),
                    userForm.FullName,
                    userForm.Role);

                if (!userForm.IsActive)
                {
                    created.Deactivate();
                }

                await UserRepo.AddAsync(created);
            }

            await UnitOfWork.SaveChangesAsync();
            showUserModal = false;
            await LoadUsers();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"خطأ: {ex.Message}");
        }
        finally
        {
            savingUser = false;
        }
    }

    private async Task ResetPassword(User user)
    {
        var newPassword = await JS.InvokeAsync<string>("prompt", $"كلمة مرور جديدة للمستخدم {user.Username}:");
        if (string.IsNullOrWhiteSpace(newPassword))
        {
            return;
        }

        user.ChangePassword(PasswordHasher.Hash(newPassword));
        UserRepo.Update(user);
        await UnitOfWork.SaveChangesAsync();
        await JS.InvokeVoidAsync("alert", "تم تحديث كلمة المرور");
    }

    private async Task ToggleUserActive(User user)
    {
        if (user.IsActive)
        {
            user.Deactivate();
        }
        else
        {
            user.Activate();
        }

        UserRepo.Update(user);
        await UnitOfWork.SaveChangesAsync();
        await LoadUsers();
    }

